@model List<WebApplication1.Models.DBModels.Transaction>
@using System.Collections
@{
    ViewData["Title"] = "Транзакции";
    var dateFrom = ViewBag.DateFrom as string ?? "";
    var dateTo = ViewBag.DateTo as string ?? "";
    var search = ViewBag.Search as string ?? "";
    var clientId = ViewBag.ClientId as string ?? "";
    var selectedClientName = ViewBag.SelectedClientName as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "";
    var agentsList = ViewBag.AgentsList as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var selectedAgentIds = ViewBag.SelectedAgentIds as List<string> ?? new List<string>();
    var clientsForDropdown = ViewBag.Clients as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var isAllAgentsSelected = selectedAgentIds.Count == 0;
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
}

<div class="children-page">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="page-title">Транзакции</h1>
                <p class="page-subtitle mb-0">Все транзакции организации</p>
            </div>
            @{
                var exportParams = new Dictionary<string, string> {
                    ["dateFrom"] = dateFrom,
                    ["dateTo"] = dateTo,
                    ["search"] = search ?? "",
                    ["clientId"] = clientId ?? "",
                    ["statusFilter"] = statusFilter ?? ""
                };
                var exportQuery = string.Join("&", exportParams.Where(p => !string.IsNullOrEmpty(p.Value)).Select(p => p.Key + "=" + Uri.EscapeDataString(p.Value)));
                if (selectedAgentIds != null && selectedAgentIds.Count > 0)
                    exportQuery += (string.IsNullOrEmpty(exportQuery) ? "" : "&") + string.Join("&", selectedAgentIds.Select(id => "agentIds=" + Uri.EscapeDataString(id)));
            }
            <a href="@(Url.Action("ExportTransactionsExcel", "Cabinet", new { area = "Detsad" }) + (string.IsNullOrEmpty(exportQuery) ? "" : "?" + exportQuery))" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.01l1.41 1.41L11 14.84V19h2v-4.16l1.59 1.59L16 15.01 12.01 11 8 15.01z" fill="currentColor"/></svg>
                Выгрузить в Excel
            </a>
        </div>
    </div>

    <div class="filters-section">
        <form method="get" asp-action="Payments" id="transactionsFilterForm" class="row g-2 mb-2 align-items-end">
            <input type="hidden" name="clientId" id="transactionsClientFilter" value="@clientId">
            <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Поиск</label>
                <div class="search-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="search-icon">
                        <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
                    </svg>
                    <input type="text" name="search" class="form-control search-input" id="transactionsSearchInput" placeholder="Клиент, лицевой счёт, агент..." value="@search">
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Дата от</label>
                <input type="date" name="dateFrom" class="form-control filter-select" value="@dateFrom" id="transactionsDateFrom">
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Дата до</label>
                <input type="date" name="dateTo" class="form-control filter-select" value="@dateTo" id="transactionsDateTo">
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Статус</label>
                <select name="statusFilter" id="transactionsStatusFilter" class="form-select filter-select">
                    <option value="">Все</option>
                    @if (statusFilter == "success") { <option value="success" selected>Успешно</option> } else { <option value="success">Успешно</option> }
                    @if (statusFilter == "error") { <option value="error" selected>Ошибка</option> } else { <option value="error">Ошибка</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1">Клиент</label>
                <div class="invoices-client-dropdown">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 text-start invoices-client-btn" id="transactionsClientBtn" aria-expanded="false">
                        <span class="invoices-client-btn-text">@(string.IsNullOrEmpty(selectedClientName) ? "Все клиенты" : selectedClientName)</span>
                        <svg class="ms-1 float-end" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7 10l5 5 5-5H7z" fill="currentColor"/>
                        </svg>
                    </button>
                    <div class="invoices-client-menu" id="transactionsClientMenu" aria-hidden="true">
                        <div class="p-2 border-bottom">
                            <input type="text" class="form-control form-control-sm invoices-client-search" id="transactionsClientSearch" placeholder="Поиск клиента..." autocomplete="off">
                        </div>
                        <div class="invoices-client-list" id="transactionsClientList">
                            <div class="invoices-client-item" data-client-id="" data-client-name="Все клиенты">Все клиенты</div>
                            @if (clientsForDropdown != null)
                            {
                                @foreach (var c in clientsForDropdown)
                                {
                                    var id = (string)c.Id;
                                    var name = (string)(c.ClientName ?? c.Id);
                                    <div class="invoices-client-item" data-client-id="@id" data-client-name="@name">@name</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            @if (agentsList.Any())
            {
                var selectedId = (selectedAgentIds != null && selectedAgentIds.Count > 0) ? selectedAgentIds[0] : "__all__";
                <div class="col-6 col-md-2">
                    <label class="form-label small text-muted mb-1">Агент</label>
                    <select name="agentIds" id="transactionsAgentIds" class="form-select filter-select">
                        @if (selectedId == "__all__")
                        {
                            <option value="__all__" selected>Все агенты</option>
                        }
                        else
                        {
                            <option value="__all__">Все агенты</option>
                        }
                        @foreach (var a in agentsList)
                        {
                            var id = (string)a.Id;
                            var name = (string)(a.Name ?? a.Id);
                            if (selectedId == id)
                            {
                                <option value="@id" selected>@name</option>
                            }
                            else
                            {
                                <option value="@id">@name</option>
                            }
                        }
                    </select>
                </div>
            }
            <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-primary btn-sm">Применить</button>
            </div>
        </form>
    </div>

    <div class="filters-section">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>ФИО клиента</th>
                            <th>Лицевой счёт</th>
                            <th>Агент</th>
                            <th>Сумма</th>                            
                            <th>Итого</th>
                            <th>Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model)
                        {
                            var statusClass = transaction.TransactionStatus == "success" ? "badge bg-success" : transaction.TransactionStatus == "error" ? "badge bg-danger" : "badge bg-secondary";
                            var statusText = transaction.TransactionStatus == "success" ? "Успешно" : transaction.TransactionStatus == "error" ? "Ошибка" : transaction.TransactionStatus ?? "—";
                            var agentName = transaction.AgentNavigation?.Name ?? transaction.Agent ?? "—";
                            var clientName = transaction.InvoiceNavigation?.ClientNavigation?.ClientName ?? "—";
                            var payCode = transaction.InvoiceNavigation?.PayCode ?? "—";
                            <tr>
                                <td>@(transaction.TransactionDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>@clientName</td>
                                <td>@payCode</td>
                                <td>@agentName</td>
                                <td>@(transaction.Summ.HasValue ? (transaction.Summ.Value / 100m).ToString("N2") + " сом" : "—")</td>
                                <td>@(transaction.TransactionSumm.HasValue ? (transaction.TransactionSumm.Value / 100m).ToString("N2") + " сом" : "—")</td>
                                <td><span class="@statusClass">@statusText</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mt-2">Всего транзакций: @Model.Count</p>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.31-8.86c-1.77-.45-2.34-.94-2.34-1.67 0-.84.79-1.43 2.1-1.43 1.38 0 1.9.66 1.94 1.64h1.71c-.05-1.34-.87-2.57-2.49-2.97V5H10.9v1.69c-1.51.32-2.72 1.3-2.72 2.81 0 1.79 1.49 2.69 3.66 3.21 1.95.46 2.34 1.15 2.34 1.87 0 .53-.39 1.39-2.1 1.39-1.6 0-2.23-.72-2.32-1.64H8.04c.1 1.7 1.36 2.66 2.86 2.97V19h2.34v-1.67c1.52-.29 2.72-1.16 2.73-2.77-.01-2.2-1.9-2.96-3.66-3.42z" fill="currentColor"/>
                    </svg>
                </div>
                <h3 class="empty-state-title">Транзакций не найдено</h3>
                <p class="empty-state-description">Измените период или условия фильтра</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('transactionsFilterForm');
            var clientFilterInput = document.getElementById('transactionsClientFilter');
            var clientBtn = document.getElementById('transactionsClientBtn');
            var clientBtnText = document.querySelector('#transactionsClientBtn .invoices-client-btn-text');
            var clientMenu = document.getElementById('transactionsClientMenu');
            var clientSearch = document.getElementById('transactionsClientSearch');
            var clientList = document.getElementById('transactionsClientList');

            function applyFiltersSubmit() {
                if (form) form.submit();
            }

            if (clientBtn && clientMenu) {
                clientBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = clientMenu.classList.toggle('is-open');
                    clientBtn.setAttribute('aria-expanded', isOpen);
                    if (isOpen && clientSearch) {
                        clientSearch.value = '';
                        var items = clientList.querySelectorAll('.invoices-client-item');
                        items.forEach(function (el) { el.classList.remove('is-hidden'); });
                        setTimeout(function () { clientSearch.focus(); }, 50);
                    }
                });
                document.addEventListener('click', function () {
                    clientMenu.classList.remove('is-open');
                    clientBtn.setAttribute('aria-expanded', 'false');
                });
                clientMenu.addEventListener('click', function (e) { e.stopPropagation(); });
            }
            if (clientSearch && clientList) {
                clientSearch.addEventListener('input', function () {
                    var term = this.value.toLowerCase().trim();
                    clientList.querySelectorAll('.invoices-client-item').forEach(function (item) {
                        var name = (item.getAttribute('data-client-name') || '').toLowerCase();
                        item.classList.toggle('is-hidden', term && name.indexOf(term) === -1);
                    });
                });
            }
            if (clientList && clientFilterInput && clientBtnText) {
                clientList.querySelectorAll('.invoices-client-item').forEach(function (item) {
                    item.addEventListener('click', function () {
                        var id = this.getAttribute('data-client-id') || '';
                        var name = this.getAttribute('data-client-name') || 'Все клиенты';
                        clientFilterInput.value = id;
                        clientBtnText.textContent = id ? name : 'Все клиенты';
                        if (clientMenu) clientMenu.classList.remove('is-open');
                        if (clientBtn) clientBtn.setAttribute('aria-expanded', 'false');
                        applyFiltersSubmit();
                    });
                });
            }

            var dateFrom = document.getElementById('transactionsDateFrom');
            var dateTo = document.getElementById('transactionsDateTo');
            var statusFilter = document.getElementById('transactionsStatusFilter');
            var agentIds = document.getElementById('transactionsAgentIds');
            if (form) {
                if (dateFrom) dateFrom.addEventListener('change', applyFiltersSubmit);
                if (dateTo) dateTo.addEventListener('change', applyFiltersSubmit);
                if (statusFilter) statusFilter.addEventListener('change', applyFiltersSubmit);
                if (agentIds) agentIds.addEventListener('change', applyFiltersSubmit);
            }
        });
    </script>
}
