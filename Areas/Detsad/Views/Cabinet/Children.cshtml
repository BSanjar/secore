@using System.Linq
@{
    ViewData["Title"] = "Дети";
    var organizationFields = ViewBag.OrganizationFields as List<WebApplication1.Models.DBModels.OrganizationField> ?? new List<WebApplication1.Models.DBModels.OrganizationField>();
    var orgClientGroups = ViewBag.OrgClientGroups as List<WebApplication1.Models.DBModels.OrgClientGroup> ?? new List<WebApplication1.Models.DBModels.OrgClientGroup>();
    var search = ViewBag.Search as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "active";
    var debtorsOnly = ViewBag.DebtorsOnly as bool? ?? false;
    var childrenData = ViewBag.ChildrenData as List<WebApplication1.Models.DBModels.OrganizationClient> ?? new List<WebApplication1.Models.DBModels.OrganizationClient>();
    var clientTotalBalanceByClientId = ViewBag.ClientTotalBalanceByClientId as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var firstInvoiceIdByClientId = ViewBag.FirstInvoiceIdByClientId as Dictionary<string, string> ?? new Dictionary<string, string>();
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-create-invoice.css" asp-append-version="true" />
    <style>
        /* Локальная правка компоновки: чуть шире поле поиска, чтобы между группами и меню не оставалось лишнего пустого пространства */
        .dashboard-filters .children-search-box {
            max-width: 420px !important;
        }

        /* Меню находится справа внутри dashboard-filters */
        .dashboard-filters {
            justify-content: space-between;
        }

        .children-filters-left {
            flex: 1 1 auto;
            min-width: 260px;
        }

        .children-actions-right {
            flex: 0 0 auto;
        }

        /* Выпадающее меню должно быть поверх карточки таблицы */
        .dashboard-filters {
            position: relative;
            z-index: 10;
        }

        .dashboard-table-card {
            position: relative;
            z-index: 1;
            overflow: visible !important; /* dropdown должен выходить поверх таблицы */
        }

        .dashboard-filters .dropdown-menu,
        .children-actions-right .dropdown-menu {
            z-index: 3000;
        }

        .dashboard-table-card .table-wrap {
            overflow-x: auto;
            overflow-y: visible;
        }

        /* При position:fixed из JS меню не обрезается overflow таблицы */
        .child-actions-menu.is-open .child-actions-menu-dropdown {
            z-index: 5000;
        }

        @@media (max-width: 992px) {
            .dashboard-filters .children-search-box {
                max-width: 320px !important;
            }
        }
    </style>
}

<div class="dashboard-page">
    <div class="page-header">
        <h1 class="page-title">Дети</h1>
        <p class="page-subtitle mb-0">Список клиентов с основной информацией и статусами</p>
    </div>
    <!-- Фильтры и действия -->
    <div class="dashboard-filters">
        <div class="children-filters-left d-flex flex-wrap align-items-center gap-2">
            <div class="search-box children-search-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;color:var(--text-muted)">
                    <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
                </svg>
                <input type="text" id="searchInput" placeholder="Поиск по имени, телефону, email..." value="@search">
            </div>
            <select id="statusFilter" class="form-select-soft">
                @if (statusFilter == "active")
                {
                    <option value="active" selected>Активные</option>
                    <option value="inactive">Неактивные</option>
                    <option value="deleted">Удалённые</option>
                }
                else if (statusFilter == "inactive")
                {
                    <option value="active">Активные</option>
                    <option value="inactive" selected>Неактивные</option>
                    <option value="deleted">Удалённые</option>
                }
                else
                {
                    <option value="active">Активные</option>
                    <option value="inactive">Неактивные</option>
                    <option value="deleted" selected>Удалённые</option>
                }
            </select>
            <label class="form-check-soft">
                <input type="checkbox" id="debtorsFilter" @(debtorsOnly ? "checked" : "")>
                <span>Только должники</span>
            </label>
            @if (orgClientGroups != null && orgClientGroups.Any())
            {
                <div class="groups-filter-dropdown">
                    <button type="button" class="btn-soft-secondary" id="groupsFilterBtn" aria-expanded="false" aria-haspopup="true">
                        <span class="groups-filter-btn-text">По группам</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5H7z"/></svg>
                    </button>
                    <div class="groups-filter-menu" id="groupsFilterMenu" role="menu" aria-hidden="true">
                        <div class="groups-filter-search-wrap p-2 border-bottom">
                            <input type="text" class="form-control form-control-sm groups-filter-search" id="groupsFilterSearch" placeholder="Поиск групп..." autocomplete="off">
                        </div>
                        <div class="groups-filter-list" id="groupsFilterList">
                            @foreach (var g in orgClientGroups)
                            {
                                <label class="groups-filter-item">
                                    <input type="checkbox" class="form-check-input group-filter-checkbox" value="@g.Id" data-group-name="@(g.Name ?? "")">
                                    <span class="groups-filter-item-text">@(g.Name ?? g.Id)</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="children-actions-right">
            <div class="dropdown">
                <button class="btn-soft-primary dropdown-toggle" type="button" id="childrenActionsMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                    Меню
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="childrenActionsMenuBtn">
                    <li>
                        <button type="button" class="dropdown-item" onclick="openCreateInvoiceModal()">
                            Счёт на оплату
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" onclick="openAddChildModal()">
                            Добавить ребёнка
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item" onclick="openImportChildrenModal()">
                            Загрузить из Excel
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Таблица клиентов -->
    <div class="dashboard-table-card">
        <div class="table-wrap">
        @if (childrenData != null && childrenData.Any())
        {
                <table class="table-soft" id="childrenTable">
                    <thead>
                        <tr>
                            <th>ФИО</th>
                            <th>Телефон</th>
                            <th>Регистрация</th>
                            <th>Баланс</th>
                            <th>Статус</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody id="childrenCards">
            @foreach (var client in childrenData)
            {
                var statusText = "Неизвестно";
                            var statusClass = "status-deleted";
                            if (client.ClientStatus == 1) { statusText = "Активный"; statusClass = "status-active"; }
                            else if (client.ClientStatus == 0) { statusText = "Приостановлен"; statusClass = "status-suspended"; }

                            var totalBalanceTyiyn = clientTotalBalanceByClientId.GetValueOrDefault(client.Id, 0m);
                            var totalBalanceSoms = totalBalanceTyiyn / 100m;
                            var searchText = $"{client.ClientName} {client.ClientPhone} {client.ClientEmail} {client.ClientAddress} {string.Join(" ", client.OrganizationClientsAdditionalFields?.Select(af => af.Value ?? "") ?? Array.Empty<string>())}";
                            var firstInvoiceId = firstInvoiceIdByClientId.GetValueOrDefault(client.Id, "");
                            <tr class="child-row"
                                data-client-id="@client.Id"
                                data-client-name="@(client.ClientName ?? "")"
                                data-org-client-group-id="@(client.OrgClientGroupId ?? "")"
                                data-first-invoice-id="@firstInvoiceId"
                                data-search-text="@searchText">
                                <td><span class="cell-name">@(client.ClientName ?? "—")</span></td>
                                <td class="cell-muted">@(client.ClientPhone ?? "—")</td>
                                <td class="cell-muted">@(client.CreatedDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="@(totalBalanceTyiyn < 0 ? "balance-negative" : "balance-positive")">@totalBalanceSoms.ToString("N2") сом</td>
                                <td><span class="status-badge @statusClass">@statusText</span></td>
                                <td class="cell-actions text-end">
                                    <div class="child-actions-menu">
                                        <button type="button" class="child-actions-menu-btn" title="Действия" aria-haspopup="true" aria-expanded="false" aria-controls="child-actions-dropdown-@client.Id" id="child-actions-btn-@client.Id">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
                                        </button>
                                        <div class="child-actions-menu-dropdown" role="menu" id="child-actions-dropdown-@client.Id" aria-labelledby="child-actions-btn-@client.Id">
                                            <button type="button" class="child-actions-menu-item" role="menuitem" data-action="profile">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                                Редактировать профиль ребенка
                                            </button>
                                            <button type="button" class="child-actions-menu-item" role="menuitem" data-action="edit-invoice">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                                Редактировать счет
                                            </button>
                                            <a class="child-actions-menu-item child-actions-menu-item-link" role="menuitem" data-action="report" href="@(string.IsNullOrEmpty(firstInvoiceId) ? Url.Action("Index", "Invoices", new { area = "Detsad", clientId = client.Id }) : Url.Action("Details", "Invoices", new { area = "Detsad", id = firstInvoiceId, returnUrl = Url.Action("Children", "Cabinet", new { area = "Detsad" }) }))">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                                                Отчет
                                            </a>
                                </div>
                        </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="childrenFilterEmptyState" class="empty-state-inline" style="display: none;">
                    <div class="empty-state-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
                                    </svg>
                    </div>
                    <p class="empty-state-title">Ничего не найдено</p>
                    <p class="empty-state-desc">Попробуйте изменить параметры поиска или фильтры.</p>
                </div>
        }
        else
        {
                <div class="empty-state-inline" id="childrenEmptyState">
                <div class="empty-state-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="currentColor"/>
                    </svg>
                    </div>
                    <p class="empty-state-title">Детей не найдено</p>
                    <p class="empty-state-desc">В детском саду пока нет записанных детей или измените фильтры.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно с вкладками: О ребенке, Счета, Платежи -->
<div class="modal fade" id="childDetailModal" tabindex="-1" aria-labelledby="childDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="childDetailModalLabel">Ребенок</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs px-3 pt-2 border-bottom-0" id="childDetailTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-child-info" data-bs-toggle="tab" data-bs-target="#pane-child-info" type="button" role="tab" aria-controls="pane-child-info" aria-selected="true">О ребенке</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-payments" data-bs-toggle="tab" data-bs-target="#pane-payments" type="button" role="tab" aria-controls="pane-payments" aria-selected="false">Платежи</button>
                    </li>
                </ul>
                <div class="tab-content p-3" id="childDetailTabContent">
                    <div class="tab-pane fade show active" id="pane-child-info" role="tabpanel" aria-labelledby="tab-child-info">
                        <div id="childDetailInfoContent"><div class="loading-spinner"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div></div></div>
                    </div>
                    <div class="tab-pane fade" id="pane-payments" role="tabpanel" aria-labelledby="tab-payments">
                        <div id="childDetailPaymentsContent"><p class="text-muted mb-0">Выберите вкладку «Платежи» для загрузки данных.</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно "Счёт на оплату" -->
<div class="modal fade" id="createInvoiceModal" tabindex="-1" aria-labelledby="createInvoiceModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createInvoiceModalLabel">Создать счёт на оплату</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0" id="createInvoiceModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно "Добавить нового ребенка" (2 шага: данные ребёнка → опционально счёт) -->
<div class="modal fade" id="addChildModal" tabindex="-1" aria-labelledby="addChildModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addChildModalLabel">Добавить нового ребенка</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="addChildStep1">
                    <form id="childForm" novalidate>
                        <div class="row mb-3">
                            <div class="col-8">
                                <label for="clientName" class="form-label">ФИО ребенка <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="clientName" name="clientName" required>
                                <div class="invalid-feedback">Пожалуйста, укажите ФИО ребенка</div>
                            </div>
                            <div class="col-4">
                                <label for="clientInn" class="form-label">ИНН <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="clientInn" name="clientInn" maxlength="14" pattern="[0-9]{14}" required>
                                <div class="invalid-feedback">ИНН должен содержать 14 цифр</div>
                            </div>
                        </div>
                    @if (orgClientGroups != null && orgClientGroups.Any())
                    {
                        <div class="mb-3" id="groupSelectWrapper">
                            <label for="orgClientGroupId" class="form-label">Группа</label>
                            <select class="form-select" id="orgClientGroupId" name="orgClientGroupId">
                                <option value="">Без группы</option>
                                @foreach (var g in orgClientGroups)
                                {
                                    <option value="@g.Id">@(g.Name ?? g.Id)</option>
                                }
                            </select>
                        </div>
                    }
                        <div class="form-section-divider mb-3">
                            <span class="divider-text">Контактные данные (родителей)</span>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="clientPhone" class="form-label">Телефон <span class="text-danger">*</span></label>
                            <div class="d-flex align-items-start gap-2">
                                <div class="flex-grow-1">
                                <input type="tel" class="form-control form-control-compact" id="clientPhone" name="clientPhone" placeholder="+996(***) *** ***" required>
                                <div class="invalid-feedback">Пожалуйста, укажите корректный номер телефона</div>
                                </div>
                                <div class="form-check mt-2 pt-1">
                                    <input class="form-check-input" type="checkbox" id="phoneIsWa" name="phoneIsWa">
                                    <label class="form-check-label small" for="phoneIsWa">WhatsApp</label>
                                </div>
                            </div>
                            </div>
                            <div class="col-6">
                                <label for="clientEmail" class="form-label">Email</label>
                                <input type="email" class="form-control form-control-compact" id="clientEmail" name="clientEmail">
                                <div class="invalid-feedback">Пожалуйста, укажите корректный email</div>
                            </div>
                        </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="clientWa" class="form-label">WhatsApp</label>
                            <input type="text" class="form-control form-control-compact" id="clientWa" name="clientWa" placeholder="+996(***) *** ***">
                        </div>
                        <div class="col-6">
                            <label for="clientTg" class="form-label">Telegram</label>
                            <input type="text" class="form-control form-control-compact" id="clientTg" name="clientTg" placeholder="username или +996...">
                        </div>
                    </div>
                        <div class="mb-3">
                            <label for="clientAdres" class="form-label">Адрес</label>
                            <input type="text" class="form-control form-control-compact" id="clientAdres" name="clientAdres">
                        </div>
                    @if (organizationFields != null && organizationFields.Any())
                    {
                        <div class="form-section-divider mb-3">
                            <span class="divider-text">Дополнительная информация</span>
                </div>
                        <div id="additionalFieldsSection">
                            @foreach (var f in organizationFields)
                            {
                                var fieldId = "af_" + f.Id;
                                var label = f.FieldName ?? f.Id;
                                <div class="mb-3">
                                    <label for="@fieldId" class="form-label">@label</label>
                                    @if (f.FieldType == "selected" && !string.IsNullOrEmpty(f.FieldSelectValues))
                                    {
                                        var options = (f.FieldSelectValues ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                                        <select class="form-select form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id">
                                            <option value="">— не указано —</option>
                                            @foreach (var opt in options)
                                            {
                                                <option value="@opt.Trim()">@opt.Trim()</option>
                                            }
                                        </select>
                                    }
                                    else if (f.FieldType == "int")
                                    {
                                        <input type="number" class="form-control form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id" step="1">
                                    }
                                    else if (f.FieldType == "money")
                                    {
                                        <input type="number" class="form-control form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id" step="0.01" min="0">
                                    }
                                    else if (f.FieldType == "datetime")
                                    {
                                        <input type="datetime-local" class="form-control form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id">
                                    }
                            </div>
                            }
                        </div>
                    }
                    </form>
                    <div id="errorMessage" class="alert alert-danger" style="display: none;" role="alert"></div>
                </div>
                <div id="addChildStep2" style="display: none;">
                    <p class="text-muted mb-3">Создание счета</p>
                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <label for="addChildInvoiceName" class="form-label">Название счёта <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="addChildInvoiceName" placeholder="Например: Посещение детского сада">
                        </div>
                        <div class="col-12 col-md-6">
                            <label for="addChildInvoiceAmount" class="form-label">Сумма (сом) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="addChildInvoiceAmount" step="0.01" min="0" placeholder="0">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="addChildBtnCancel" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-outline-secondary me-auto" id="addChildBtnBack" style="display: none;">Назад</button>
                <button type="button" class="btn btn-secondary" id="addChildBtnSkip" style="display: none;">Только ребёнка</button>
                <button type="button" class="btn btn-success" id="submitBtn" onclick="submitChild()">Далее</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно импорта детей из Excel -->
<div class="modal fade" id="importChildrenModal" tabindex="-1" aria-labelledby="importChildrenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importChildrenModalLabel">Загрузка детей из Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">
                    Скачайте шаблон с колонками на русском языке. Обязательны только <strong>ФИО</strong> и <strong>ИНН</strong>;
                    номер телефона, адрес и эл. почта — по желанию.
                </p>
                <div class="mb-3">
                    <a asp-action="DownloadChildrenImportTemplate" class="btn btn-outline-secondary btn-sm">
                        Скачать шаблон Excel
                    </a>
                </div>

                @{
                    var importPreviewRows = ViewBag.ChildrenImportPreviewRows as List<WebApplication1.Dtos.ChildrenImportRowDto>;
                    var importPreviewId = ViewBag.ChildrenImportPreviewId as string;
                }

                @if (importPreviewRows != null && importPreviewRows.Any() && !string.IsNullOrEmpty(importPreviewId))
                {
                    <div class="mb-3">
                        <div class="alert alert-info mb-2">
                            Найден предварительный импорт. Проверьте строки ниже и нажмите «Загрузить», чтобы создать детей.
                        </div>
                        <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>ФИО</th>
                                        <th>ИНН</th>
                                        <th>Номер телефона</th>
                                        <th>Адрес</th>
                                        <th>Эл. почта</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importPreviewRows)
                                    {
                                        var isValid = row.IsValid && string.IsNullOrWhiteSpace(row.Error);
                                        <tr class="@(isValid ? "" : "table-warning")">
                                            <td>@(row.ClientName ?? "—")</td>
                                            <td>@(row.ClientInn ?? "—")</td>
                                            <td>@(row.ClientPhone ?? "—")</td>
                                            <td>@(row.ClientAddress ?? "—")</td>
                                            <td>@(row.ClientEmail ?? "—")</td>
                                            <td>
                                                @if (isValid)
                                                {
                                                    <span class="text-success small">OK</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger small">@row.Error</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <form asp-action="ConfirmChildrenImport" method="post" class="mt-3 d-flex justify-content-end gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="importId" value="@importPreviewId" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                                Отмена
                            </button>
                            <button type="submit" class="btn btn-primary btn-sm">
                                Загрузить
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <form asp-action="PreviewChildrenImport" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="childrenImportFile" class="form-label">Файл Excel</label>
                            <input type="file" class="form-control" id="childrenImportFile" name="file" accept=".xlsx,.xls" />
                            <div class="form-text">
                                Допустимые форматы: .xlsx, .xls. Если файл не выбран, появится сообщение — окно импорта останется доступным.
                            </div>
                        </div>
                        <div class="mb-3 text-end">
                            <button type="submit" class="btn btn-primary btn-sm">
                                Предпросмотр
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="childrenImportModalAutoOpen" value="@(ViewBag.OpenChildrenImportModal == true ? "1" : "0")" />

<!-- Модальное окно "Редактировать профиль ребенка" -->
<div class="modal fade" id="editChildModal" tabindex="-1" aria-labelledby="editChildModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editChildModalLabel">Редактировать профиль ребенка</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div id="editChildLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div>
                </div>
                <form id="editChildForm" novalidate style="display: none;">
                    <input type="hidden" id="editClientId" name="clientId" />
                    <div class="form-section-divider mb-3">
                        <span class="divider-text">Основные данные</span>
                    </div>
                    <div class="row mb-3">
                        <div class="col-8">
                            <label for="editClientName" class="form-label">ФИО ребенка <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editClientName" name="clientName" required>
                        </div>
                        <div class="col-4">
                            <label for="editClientInn" class="form-label">ИНН <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editClientInn" name="clientInn" maxlength="14" pattern="[0-9]{14}" required>
                        </div>
                    </div>
                    @if (orgClientGroups != null && orgClientGroups.Any())
                    {
                        <div class="mb-3">
                            <label for="editOrgClientGroupId" class="form-label">Группа</label>
                            <select class="form-select" id="editOrgClientGroupId" name="orgClientGroupId">
                                <option value="">Без группы</option>
                                @foreach (var g in orgClientGroups)
                                {
                                    <option value="@g.Id">@(g.Name ?? g.Id)</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="editClientPhone" class="form-label">Телефон <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="editClientPhone" name="clientPhone" required>
                        </div>
                        <div class="col-6">
                            <label for="editClientEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="editClientEmail" name="clientEmail">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="editClientWa" class="form-label">WhatsApp</label>
                            <input type="text" class="form-control" id="editClientWa" name="clientWa" placeholder="+996(***) *** ***">
                        </div>
                        <div class="col-6">
                            <label for="editClientTg" class="form-label">Telegram</label>
                            <input type="text" class="form-control" id="editClientTg" name="clientTg" placeholder="username или +996...">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editClientAdres" class="form-label">Адрес</label>
                        <input type="text" class="form-control" id="editClientAdres" name="clientAdres">
                    </div>
                    <div class="mb-3">
                        <label for="editClientStatus" class="form-label">Статус</label>
                        <select class="form-select" id="editClientStatus" name="clientStatus">
                            <option value="1">Активный</option>
                            <option value="0">Неактивный</option>
                        </select>
                    </div>
                    @if (organizationFields != null && organizationFields.Any())
                    {
                        <div class="form-section-divider mb-3">
                            <span class="divider-text">Дополнительные параметры</span>
                        </div>
                        <div id="editAdditionalFieldsSection">
                            @foreach (var f in organizationFields)
                            {
                                var fieldId = "edit_af_" + f.Id;
                                var label = f.FieldName ?? f.Id;
                                <div class="mb-3">
                                    <label for="@fieldId" class="form-label">@label</label>
                                    @if (f.FieldType == "selected" && !string.IsNullOrEmpty(f.FieldSelectValues))
                                    {
                                        var options = (f.FieldSelectValues ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                                        <select class="form-select" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id">
                                            <option value="">— не указано —</option>
                                            @foreach (var opt in options)
                                            {
                                                <option value="@opt.Trim()">@opt.Trim()</option>
                                            }
                                        </select>
                                    }
                                    else if (f.FieldType == "int")
                                    {
                                        <input type="number" class="form-control" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id" step="1">
                                    }
                                    else if (f.FieldType == "money")
                                    {
                                        <input type="number" class="form-control" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id" step="0.01" min="0">
                                    }
                                    else if (f.FieldType == "datetime")
                                    {
                                        <input type="datetime-local" class="form-control" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id">
                                    }
                                </div>
                            }
                        </div>
                    }
                </form>
                <div id="editChildError" class="alert alert-danger" style="display: none;" role="alert"></div>
            </div>
            <div class="modal-footer" id="editChildModalFooter" style="display: none;">
                <button type="button" class="btn btn-danger me-auto" id="editChildDeleteBtn">Удалить</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-success" id="editChildSaveBtn">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно "Редактировать счет" (та же структура, что Шаг 2 createInvoiceModal) -->
<div class="modal fade" id="editInvoiceModal" tabindex="-1" aria-labelledby="editInvoiceModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editInvoiceModalLabel">Редактировать счёт</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body p-0" id="editInvoiceModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div>
                </div>
            </div>
