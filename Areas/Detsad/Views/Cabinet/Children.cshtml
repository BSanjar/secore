@section Scripts {
    <script src="~/web/kindergarten/js/detsad-children.js" asp-append-version="true"></script>
    <script src="~/web/kindergarten/js/detsad-create-invoice.js" asp-append-version="true"></script>
    <script>
        (function() {
            function clearChildActionsMenuPosition(menu) {
                var dd = menu.querySelector('.child-actions-menu-dropdown');
                if (!dd) return;
                dd.style.position = '';
                dd.style.left = '';
                dd.style.top = '';
                dd.style.right = '';
                dd.style.bottom = '';
                dd.style.marginTop = '';
                dd.style.zIndex = '';
            }

            function positionChildActionsMenu(menu) {
                var dd = menu.querySelector('.child-actions-menu-dropdown');
                var btn = menu.querySelector('.child-actions-menu-btn');
                if (!dd || !btn) return;
                requestAnimationFrame(function() {
                    if (!menu.classList.contains('is-open')) return;
                    var ddW = dd.offsetWidth;
                    var ddH = dd.offsetHeight;
                    var br = btn.getBoundingClientRect();
                    var margin = 4;
                    var pad = 8;
                    var left = br.right - ddW;
                    if (left < pad) left = pad;
                    if (left + ddW > window.innerWidth - pad) left = Math.max(pad, window.innerWidth - ddW - pad);
                    var top = br.bottom + margin;
                    if (top + ddH > window.innerHeight - pad) {
                        top = br.top - ddH - margin;
                    }
                    if (top < pad) top = pad;
                    dd.style.position = 'fixed';
                    dd.style.left = left + 'px';
                    dd.style.top = top + 'px';
                    dd.style.right = 'auto';
                    dd.style.bottom = 'auto';
                    dd.style.marginTop = '0';
                    dd.style.zIndex = '5000';
                });
            }

            var childMenuRepositionHandler = null;
            function bindChildMenuReposition(menu) {
                if (childMenuRepositionHandler) {
                    window.removeEventListener('scroll', childMenuRepositionHandler, true);
                    window.removeEventListener('resize', childMenuRepositionHandler);
                }
                childMenuRepositionHandler = function() {
                    if (menu.classList.contains('is-open')) positionChildActionsMenu(menu);
                };
                window.addEventListener('scroll', childMenuRepositionHandler, true);
                window.addEventListener('resize', childMenuRepositionHandler);
            }
            function unbindChildMenuReposition() {
                if (childMenuRepositionHandler) {
                    window.removeEventListener('scroll', childMenuRepositionHandler, true);
                    window.removeEventListener('resize', childMenuRepositionHandler);
                    childMenuRepositionHandler = null;
                }
            }

            document.addEventListener('click', function(e) {
                var menu = e.target.closest('.child-actions-menu');
                if (menu) {
                    e.stopPropagation();
                    if (e.target.closest('.child-actions-menu-btn')) {
                        e.preventDefault();
                        var open = document.querySelectorAll('.child-actions-menu.is-open');
                        open.forEach(function(m) {
                            if (m !== menu) {
                                m.classList.remove('is-open');
                                clearChildActionsMenuPosition(m);
                                var btn = m.querySelector('.child-actions-menu-btn');
                                if (btn) btn.setAttribute('aria-expanded', 'false');
                            }
                        });
                        var isOpen = menu.classList.toggle('is-open');
                        var thisBtn = menu.querySelector('.child-actions-menu-btn');
                        if (thisBtn) thisBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                        if (isOpen) {
                            positionChildActionsMenu(menu);
                            bindChildMenuReposition(menu);
                        } else {
                            clearChildActionsMenuPosition(menu);
                            unbindChildMenuReposition();
                        }
                        return;
                    }
                    var item = e.target.closest('.child-actions-menu-item');
                    if (item && !item.classList.contains('child-actions-menu-item-link')) {
                        e.preventDefault();
                        var row = menu.closest('tr.child-row');
                        if (!row) return;
                        var clientId = row.dataset.clientId;
                        var clientName = row.dataset.clientName || 'Ребенок';
                        var firstInvoiceId = row.dataset.firstInvoiceId || '';
                        var action = item.getAttribute('data-action');
                        menu.classList.remove('is-open');
                        clearChildActionsMenuPosition(menu);
                        unbindChildMenuReposition();
                        var menuBtn = menu.querySelector('.child-actions-menu-btn');
                        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
                        if (action === 'profile') {
                            if (typeof openEditChildModal === 'function') openEditChildModal(clientId);
                        } else if (action === 'edit-invoice') {
                            if (firstInvoiceId) {
                                openEditInvoiceModal(firstInvoiceId);
                            } else {
                                if (typeof showInvoicesInfo === 'function') showInvoicesInfo(clientId);
                            }
                        }
                        return;
                    }
                    if (item && item.classList.contains('child-actions-menu-item-link')) {
                        menu.classList.remove('is-open');
                        clearChildActionsMenuPosition(menu);
                        unbindChildMenuReposition();
                        var linkBtn = menu.querySelector('.child-actions-menu-btn');
                        if (linkBtn) linkBtn.setAttribute('aria-expanded', 'false');
                        return;
                    }
                    return;
                }
                document.querySelectorAll('.child-actions-menu.is-open').forEach(function(m) {
                    m.classList.remove('is-open');
                    clearChildActionsMenuPosition(m);
                    var btn = m.querySelector('.child-actions-menu-btn');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                });
                unbindChildMenuReposition();
            }, true);
        })();

        window.openEditChildModal = function(clientId) {
            var modal = document.getElementById('editChildModal');
            var loading = document.getElementById('editChildLoading');
            var form = document.getElementById('editChildForm');
            var footer = document.getElementById('editChildModalFooter');
            var errEl = document.getElementById('editChildError');
            if (!modal || !form) return;
            errEl.style.display = 'none';
            form.style.display = 'none';
            footer.style.display = 'none';
            loading.style.display = 'block';
            var bsModal = new bootstrap.Modal(modal);
            bsModal.show();
            fetch('/Detsad/Cabinet/GetChildInfo?clientId=' + encodeURIComponent(clientId))
                .then(function(r) { if (!r.ok) throw new Error('Ошибка загрузки'); return r.json(); })
                .then(function(data) {
                    var c = data.client;
                    document.getElementById('editClientId').value = c.id || clientId;
                    document.getElementById('editClientName').value = c.name || '';
                    document.getElementById('editClientInn').value = c.inn || '';
                    document.getElementById('editOrgClientGroupId').value = c.orgClientGroupId || '';
                    document.getElementById('editClientPhone').value = c.phone || '';
                    document.getElementById('editClientEmail').value = c.email || '';
                    document.getElementById('editClientWa').value = c.clientWa || '';
                    document.getElementById('editClientTg').value = c.clientTg || '';
                    document.getElementById('editClientAdres').value = c.address || '';
                    var statusVal = c.status !== undefined && c.status !== null ? String(c.status) : '1';
                    document.getElementById('editClientStatus').value = statusVal === '2' ? '0' : statusVal;
                    (data.additionalFields || []).forEach(function(f) {
                        var el = document.querySelector('#editChildForm [data-field-id="' + (f.fieldId || f.FieldId) + '"]');
                        if (el) el.value = f.value || f.Value || '';
                    });
                    loading.style.display = 'none';
                    form.style.display = 'block';
                    footer.style.display = 'flex';
                })
                .catch(function(e) {
                    loading.style.display = 'none';
                    errEl.textContent = e.message || 'Не удалось загрузить данные.';
                    errEl.style.display = 'block';
                });
        };

        document.getElementById('editChildSaveBtn') && document.getElementById('editChildSaveBtn').addEventListener('click', function() {
            var form = document.getElementById('editChildForm');
            var errEl = document.getElementById('editChildError');
            var clientId = document.getElementById('editClientId').value;
            if (!clientId) return;
            if (!form.checkValidity()) { form.reportValidity(); return; }
            var additionalFields = {};
            form.querySelectorAll('[data-field-id]').forEach(function(el) {
                var id = el.getAttribute('data-field-id');
                if (id && el.name) additionalFields[id] = el.value || '';
            });
            var payload = {
                clientId: clientId,
                clientName: document.getElementById('editClientName').value,
                clientInn: document.getElementById('editClientInn').value,
                orgClientGroupId: document.getElementById('editOrgClientGroupId').value || null,
                clientPhone: document.getElementById('editClientPhone').value,
                clientAdres: document.getElementById('editClientAdres').value,
                clientEmail: document.getElementById('editClientEmail').value,
                clientWa: document.getElementById('editClientWa').value,
                clientTg: document.getElementById('editClientTg').value,
                clientStatus: parseInt(document.getElementById('editClientStatus').value, 10),
                additionalFields: additionalFields
            };
            fetch('/Detsad/Cabinet/UpdateChild', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]') && document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify(payload)
            }).then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('editChildModal')).hide();
                    if (typeof loadChildInfoInto === 'function' && currentDetailClientId === clientId) {
                        var infoContent = document.getElementById('childDetailInfoContent');
                        if (infoContent) loadChildInfoInto(clientId, infoContent);
                    }
                    location.reload();
                } else {
                    errEl.textContent = res.message || 'Ошибка сохранения';
                    errEl.style.display = 'block';
                }
            }).catch(function() {
                errEl.textContent = 'Ошибка сети';
                errEl.style.display = 'block';
            });
        });

        document.getElementById('editChildDeleteBtn') && document.getElementById('editChildDeleteBtn').addEventListener('click', function() {
            if (!confirm('Удалить ребёнка из списка? Статус будет установлен как «Удалён».')) return;
            var clientId = document.getElementById('editClientId').value;
            if (!clientId) return;
            var payload = {
                clientId: clientId,
                clientName: document.getElementById('editClientName').value,
                clientInn: document.getElementById('editClientInn').value,
                orgClientGroupId: document.getElementById('editOrgClientGroupId').value || null,
                clientPhone: document.getElementById('editClientPhone').value,
                clientAdres: document.getElementById('editClientAdres').value,
                clientEmail: document.getElementById('editClientEmail').value,
                clientWa: document.getElementById('editClientWa').value,
                clientTg: document.getElementById('editClientTg').value,
                clientStatus: 2,
                additionalFields: {}
            };
            document.getElementById('editChildForm').querySelectorAll('[data-field-id]').forEach(function(el) {
                var id = el.getAttribute('data-field-id');
                if (id) payload.additionalFields[id] = el.value || '';
            });
            fetch('/Detsad/Cabinet/UpdateChild', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('editChildModal')).hide();
                    location.reload();
                } else {
                    document.getElementById('editChildError').textContent = res.message || 'Ошибка';
                    document.getElementById('editChildError').style.display = 'block';
                }
            });
        });

        window.openEditInvoiceModal = function(invoiceId) {
            var modal = document.getElementById('editInvoiceModal');
            var body = document.getElementById('editInvoiceModalBody');
            if (!modal || !body) return;
            body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>';
            var bsModal = new bootstrap.Modal(modal);
            bsModal.show();
            fetch('/Detsad/Cabinet/GetEditInvoicePartial?invoiceId=' + encodeURIComponent(invoiceId))
                .then(function(r) { if (!r.ok) throw new Error('Ошибка загрузки'); return r.text(); })
                .then(function(html) {
                    body.innerHTML = html;
                    if (typeof window.initEditInvoiceModal === 'function') window.initEditInvoiceModal(body);
                })
                .catch(function() {
                    body.innerHTML = '<div class="alert alert-danger m-3">Не удалось загрузить форму редактирования.</div>';
                });
        };

        window.initEditInvoiceModal = function(container) {
            if (!container) return;
            var wrap = container.querySelector('.edit-invoice-wrap');
            if (!wrap) return;
            var invoiceId = wrap.getAttribute('data-invoice-id');
            var disableServiceSelection = wrap.getAttribute('data-disable-invoice-service-selection') === 'true';
            var allowedHassame = wrap.getAttribute('data-allowed-hassame-account') === 'true';
            var dateStartEl = container.querySelector('#editInvDateStart');
            var dateEndEl = container.querySelector('#editInvDateEnd');
            var dateEndBlock = container.querySelector('#editInvDateEndBlock');
            var periodicityEl = container.querySelector('#editInvPeriodicity');
            var autoProlongationEl = container.querySelector('#editInvAutoProlongation');
            var saveBtn = container.querySelector('#editInvSaveBtn');
            var errEl = container.querySelector('#editInvError');

            function toDateTimeLocalString(d) {
                var y = d.getFullYear(), m = ('0' + (d.getMonth() + 1)).slice(-2), day = ('0' + d.getDate()).slice(-2);
                var h = ('0' + d.getHours()).slice(-2), min = ('0' + d.getMinutes()).slice(-2);
                return y + '-' + m + '-' + day + 'T' + h + ':' + min;
            }
            function updateShortcutsVisibility() {
                if (!periodicityEl || !dateEndBlock) return;
                dateEndBlock.querySelectorAll('.invoice-shortcuts-group').forEach(function(gr) {
                    gr.classList.toggle('d-none', gr.getAttribute('data-periodicity') !== periodicityEl.value);
                });
            }
            if (autoProlongationEl && dateEndBlock) {
                autoProlongationEl.addEventListener('change', function() {
                    dateEndBlock.classList.toggle('d-none', !!this.checked);
                });
            }
            updateShortcutsVisibility();
            if (periodicityEl) periodicityEl.addEventListener('change', updateShortcutsVisibility);
            dateEndBlock && dateEndBlock.querySelectorAll('.edit-inv-date-shortcut').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (!dateStartEl || !dateEndEl) return;
                    var startVal = dateStartEl.value;
                    if (!startVal) return;
                    var type = btn.getAttribute('data-type') || 'months';
                    var val = parseInt(btn.getAttribute('data-value'), 10) || 1;
                    var d = new Date(startVal.indexOf('T') !== -1 ? startVal : startVal + 'T12:00:00');
                    if (type === 'days') d.setDate(d.getDate() + val);
                    else if (type === 'weeks') d.setDate(d.getDate() + val * 7);
                    else if (type === 'months') d.setMonth(d.getMonth() + val);
                    else if (type === 'years') d.setFullYear(d.getFullYear() + val);
                    dateEndEl.value = toDateTimeLocalString(d);
                });
            });
            var searchEl = container.querySelector('#editInvServicesSearch');
            if (searchEl) {
                searchEl.addEventListener('input', function() {
                    var term = (this.value || '').toLowerCase().trim();
                    (container.querySelectorAll('#editInvServicesBody .edit-inv-service-row') || []).forEach(function(tr) {
                        var name = (tr.getAttribute('data-name') || '').toLowerCase();
                        tr.style.display = !term || name.indexOf(term) >= 0 ? '' : 'none';
                    });
                });
            }
            var qrBtn = container.querySelector('#editInvGenerateQr');
            var qrContainer = container.querySelector('#editInvQrContainer');
            if (qrBtn && qrContainer) {
                qrBtn.addEventListener('click', function() {
                    var code = (container.querySelector('#editInvPayCode') || {}).value || '';
                    qrContainer.innerHTML = '<img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + encodeURIComponent(code) + '" alt="QR" />';
                });
            }
            if (allowedHassame) {
                var payCodeSelect = container.querySelector('#editInvPayCodeSelect');
                var payCodeInput = container.querySelector('#editInvPayCode');
                var clientEl = container.querySelector('#editInvClient');
                var currentClient = clientEl ? clientEl.value : '';
                if (payCodeSelect && payCodeInput) {
                    fetch('/Detsad/Cabinet/GetInvoicePayCodeOptions?clientIds=' + encodeURIComponent(currentClient || ''))
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            payCodeSelect.innerHTML = '';
                            var optNew = document.createElement('option');
                            optNew.value = '__new__';
                            optNew.textContent = 'Сгенерировать новый';
                            payCodeSelect.appendChild(optNew);
                            (data.payCodeOptions || []).forEach(function(o) {
                                var opt = document.createElement('option');
                                opt.value = o.payCode || '';
                                opt.textContent = (o.nameInvoice && o.nameInvoice.trim() ? o.nameInvoice.trim() + ' (' + (o.payCode || '') + ')' : (o.payCode || '—'));
                                if ((o.payCode || '') === (payCodeInput.value || '')) opt.selected = true;
                                payCodeSelect.appendChild(opt);
                            });
                            payCodeSelect.addEventListener('change', function() {
                                var v = this.value;
                                if (v === '__new__' || v === '') {
                                    fetch('/Detsad/Cabinet/GetNextInvoiceNumber').then(function(r) { return r.json(); }).then(function(d) { payCodeInput.value = d.payCode || ''; }).catch(function() { payCodeInput.value = ''; });
                                } else { payCodeInput.value = v; }
                            });
                        }).catch(function() { payCodeSelect.innerHTML = '<option value="__new__">Сгенерировать новый</option>'; });
                }
            }
            if (saveBtn) {
                saveBtn.addEventListener('click', function() {
                    var client = (container.querySelector('#editInvClient') || {}).value;
                    if (!client) { if (errEl) { errEl.textContent = 'Выберите клиента.'; errEl.style.display = 'block'; } return; }
                    var dateStartVal = (container.querySelector('#editInvDateStart') || {}).value;
                    var dateEndVal = (container.querySelector('#editInvDateEnd') || {}).value;
                    var payload = {
                        id: invoiceId,
                        client: client,
                        nameInvoice: (container.querySelector('#editInvName') || {}).value || '',
                        payCode: (container.querySelector('#editInvPayCode') || {}).value || '',
                        periodicity: (container.querySelector('#editInvPeriodicity') || {}).value || 'monthly',
                        invoiceStatus: (container.querySelector('#editInvStatus') || {}).value || 'actual',
                        dateStartInvoice: dateStartVal ? dateStartVal + ':00' : null,
                        dateEndInvoice: dateEndVal ? dateEndVal + ':00' : null,
                        autoProlongation: !!(container.querySelector('#editInvAutoProlongation') && container.querySelector('#editInvAutoProlongation').checked),
                        nextStartInvoice: null,
                        hassameaccount: allowedHassame && (container.querySelector('#editInvPayCodeSelect') || {}).value && (container.querySelector('#editInvPayCodeSelect').value !== '__new__' && container.querySelector('#editInvPayCodeSelect').value !== ''),
                        manualServicePriceSom: null,
                        serviceItems: []
                    };
                    if (disableServiceSelection) {
                        var manualInput = container.querySelector('#editInvManualPriceSom');
                        if (manualInput && manualInput.value !== '' && !isNaN(parseFloat(manualInput.value))) {
                            payload.manualServicePriceSom = parseFloat(manualInput.value);
                        }
                    } else {
                        (container.querySelectorAll('#editInvServicesBody .edit-inv-service-row') || []).forEach(function(tr) {
                            var check = tr.querySelector('.service-include');
                            if (!check || !check.checked) return;
                            var sid = tr.getAttribute('data-service-id');
                            var qtyInput = tr.querySelector('.service-qty');
                            var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
                            if (sid) payload.serviceItems.push({ serviceId: sid, qty: qty });
                        });
                    }
                    if (errEl) errEl.style.display = 'none';
                    saveBtn.disabled = true;
                    fetch('/Detsad/Invoices/UpdateInvoice', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    }).then(function(r) { return r.json(); })
                    .then(function(res) {
                        if (res.success) {
                            bootstrap.Modal.getInstance(document.getElementById('editInvoiceModal')).hide();
                            location.reload();
                        } else {
                            if (errEl) { errEl.textContent = res.message || 'Ошибка сохранения'; errEl.style.display = 'block'; }
                            saveBtn.disabled = false;
                        }
                    }).catch(function() {
                        if (errEl) { errEl.textContent = 'Ошибка сети'; errEl.style.display = 'block'; }
                        saveBtn.disabled = false;
                    });
                });
            }
        };
    </script>
}
