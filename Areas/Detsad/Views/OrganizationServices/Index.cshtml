@model List<WebApplication1.Models.DBModels.OrganizationService>
@using System.Linq
@{
    ViewData["Title"] = "Услуги";
    var search = ViewBag.Search as string ?? "";
    var isDeletedFilter = ViewBag.IsDeletedFilter as string ?? "active";
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
}

<div class="children-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <p class="page-subtitle mb-0">Услуги организации для счетов и платежей</p>
            </div>
            <a asp-action="Create" class="action-btn action-btn--add" title="Добавить услугу">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/>
                </svg>
                Добавить услугу
            </a>
        </div>
    </div>

    <div class="filters-section">
        <div class="row g-2 mb-2">
            <div class="col-md-6">
                <label class="form-label small text-muted mb-1">Поиск</label>
                <div class="search-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="search-icon">
                        <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
                    </svg>
                    <input type="text" id="orgServicesSearchInput" class="form-control search-input" placeholder="По названию услуги..." value="@search">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Статус</label>
                <form method="get" asp-action="Index" id="orgServicesFilterForm" class="d-inline">
                    <input type="hidden" name="search" id="orgServicesSearchHidden" value="@search">
                    <select name="isDeletedFilter" id="orgServicesIsDeletedFilter" class="form-select filter-select w-100">
                        <option value="active" selected="@(isDeletedFilter == "active")">Активные</option>
                        <option value="deleted" selected="@(isDeletedFilter == "deleted")">Удалённые</option>
                    </select>
                </form>
            </div>
        </div>
    </div>

    <div class="filters-section">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Тип суммы</th>
                            <th>Сумма / диапазон</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="orgServicesTableBody">
                        @foreach (var s in Model)
                        {
                            var isFixed = s.FixedSum == 1;
                            var sumInfo = isFixed && s.ServiceSumm.HasValue
                                ? (s.ServiceSumm.Value / 100m).ToString("N2") + " сом"
                                : (s.MinSumm.HasValue || s.MaxSumm.HasValue)
                                    ? (s.MinSumm.HasValue ? (s.MinSumm.Value / 100m).ToString("N2") + " — " : "— ") + (s.MaxSumm.HasValue ? (s.MaxSumm.Value / 100m).ToString("N2") + " сом" : "—")
                                    : "—";
                            <tr class="org-service-row" data-search-name="@(s.Name ?? "")">
                                <td><strong>@(s.Name ?? "—")</strong></td>
                                <td>@(isFixed ? "Фиксированная" : "Диапазон")</td>
                                <td>@sumInfo</td>
                                <td>
                                    @if (s.Isdeleted != 1)
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="action-btn action-btn--edit" title="Редактировать">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="currentColor"/>
                                            </svg>
                                            Изменить
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить услугу «@(s.Name)»?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn action-btn--delete" title="Удалить">Удалить</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mt-2">Всего услуг: @Model.Count</p>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z" fill="currentColor"/>
                    </svg>
                </div>
                <h3 class="empty-state-title">Услуг пока нет</h3>
                <p class="empty-state-description">@(string.IsNullOrEmpty(search) ? "Создайте услуги для добавления в счета (например: питание, обучение)" : "По вашему запросу ничего не найдено.")</p>
                @if (string.IsNullOrEmpty(search))
                {
                    <a asp-action="Create" class="action-btn action-btn--add mt-3" title="Добавить услугу">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/>
                        </svg>
                        Добавить услугу
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('orgServicesFilterForm');
            var searchInput = document.getElementById('orgServicesSearchInput');
            var searchHidden = document.getElementById('orgServicesSearchHidden');
            var isDeletedFilter = document.getElementById('orgServicesIsDeletedFilter');
            var tbody = document.getElementById('orgServicesTableBody');

            function applySearchLocal() {
                if (!searchInput || !tbody) return;
                var term = searchInput.value.toLowerCase().trim();
                var rows = tbody.querySelectorAll('tr.org-service-row');
                rows.forEach(function (tr) {
                    var name = (tr.getAttribute('data-search-name') || '').toLowerCase();
                    tr.style.display = !term || name.indexOf(term) !== -1 ? '' : 'none';
                });
            }

            if (searchInput) {
                var searchTimeout;
                searchInput.addEventListener('input', function () {
                    if (searchHidden) searchHidden.value = searchInput.value;
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(applySearchLocal, 300);
                });
            }
            if (isDeletedFilter && form) {
                isDeletedFilter.addEventListener('change', function () {
                    if (searchHidden) searchHidden.value = searchInput ? searchInput.value : '';
                    form.submit();
                });
            }
            applySearchLocal();
        });
    </script>
}
