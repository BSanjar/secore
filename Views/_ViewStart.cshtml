@{
    var currentTenant = Context.RequestServices.GetService(typeof(WebApplication1.Services.Cabinets.ICurrentTenantService))
        as WebApplication1.Services.Cabinets.ICurrentTenantService;
    var tenant = currentTenant?.GetCurrent();
    Layout = tenant?.IsAuthenticated == true
        ? tenant.Profile.LayoutPath
        : "_Layout";
}
