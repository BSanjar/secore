@model WebApplication1.Models.DBModels.OrgClientGroup
@{
    ViewData["Title"] = "Добавить группу";
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
}

<div class="children-page">
<div class="page-header mb-4">
    <h1 class="page-title">Добавить группу</h1>
    <p class="page-subtitle mb-0">Новая группа клиентов организации</p>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="OrganizationId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Название группы <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Например: Старшая группа" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentGroupId" class="form-label">Родительская группа</label>
                <select asp-for="ParentGroupId" class="form-select" asp-items="ViewBag.ParentGroups">
                    <option value="">— без родительской группы —</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="action-btn action-btn--add">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/>
                    </svg>
                    Создать
                </button>
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

