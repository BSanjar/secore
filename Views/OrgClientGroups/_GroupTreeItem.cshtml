@model WebApplication1.Models.DBModels.OrgClientGroup
@using System.Linq
@{
    var displayName = Model.Name ?? "Без названия";
    var clientCount = Model.OrganizationClients?.Count ?? 0;
    var hasChildren = Model.ChildGroups != null && Model.ChildGroups.Any();
    var canManageChildren = ViewBag.CanManageChildren as bool? ?? false;
}
<li class="tree-node @(hasChildren ? "has-children" : "")" data-group-id="@Model.Id" data-group-name="@displayName" data-group-parent-id="@(Model.ParentGroupId ?? "")">
    <div class="tree-node-content">
        <span class="tree-toggle" aria-label="@(hasChildren ? "Развернуть" : "")">@if (hasChildren)
        {
            <svg class="tree-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6-6-6z" fill="currentColor"/>
            </svg>
        }
        else
        {
            <span class="tree-chevron-placeholder"></span>
        }</span>
        <span class="tree-label" title="@displayName">@displayName</span>
        <span class="tree-meta">@clientCount клиентов</span>
        @if (canManageChildren)
        {
            <div class="tree-actions">
                <button type="button" class="action-btn action-btn--edit btn-edit-group" data-group-id="@Model.Id" data-group-name="@displayName" data-group-parent-id="@(Model.ParentGroupId ?? "")" title="Редактировать">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="currentColor"/>
                    </svg>
                </button>
                <button type="button" class="action-btn action-btn--delete btn-delete-group" data-group-id="@Model.Id" data-group-name="@displayName" title="Удалить">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="currentColor"/>
                    </svg>
                </button>
            </div>
        }
    </div>
    @if (hasChildren)
    {
        <ul class="tree-children">
            @foreach (var child in Model.ChildGroups!)
            {
                @await Html.PartialAsync("_GroupTreeItem", child)
            }
        </ul>
    }
</li>
