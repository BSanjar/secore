@using Microsoft.AspNetCore.Mvc.Localization
@using WebApplication1.Helpers
@using WebApplication1.Services.Cabinets
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@inject ICurrentTenantService CurrentTenantService
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var profileKey = (CurrentTenantService.GetCurrent().Profile.Key ?? string.Empty).Trim().ToLowerInvariant();
    var isStandartProfile = profileKey == "standart";
    var canViewInvoices = isStandartProfile && PermissionHelper.HasPermission(Context, "invoices.view");
    var canViewPaymentHistory = isStandartProfile && PermissionHelper.HasPermission(Context, "transactions.view");
}
<ul class="navbar-nav me-auto">
    @if (canViewInvoices)
    {
        <li class="nav-item">
            <a class="nav-link @(controller == "Cabinet" && action == "Invoices" ? "active" : "")" asp-controller="Cabinet" asp-action="Invoices">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-1">
                    <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" fill="currentColor"/>
                </svg>
                @Localizer["Invoices"]
            </a>
        </li>
    }
    @if (canViewPaymentHistory)
    {
        <li class="nav-item">
            <a class="nav-link @(controller == "Cabinet" && action == "PaymentHistory" ? "active" : "")" asp-controller="Cabinet" asp-action="PaymentHistory">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-1">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.31-8.86c-1.77-.45-2.34-.94-2.34-1.67 0-.84.79-1.43 2.1-1.43 1.38 0 1.9.66 1.94 1.64h1.71c-.05-1.34-.87-2.57-2.49-2.97V5H10.9v1.69c-1.51.32-2.72 1.3-2.72 2.81 0 1.79 1.49 2.69 3.66 3.21 1.95.46 2.34 1.15 2.34 1.87 0 .53-.39 1.39-2.1 1.39-1.6 0-2.23-.72-2.32-1.64H8.04c.1 1.7 1.36 2.66 2.86 2.97V19h2.34v-1.67c1.52-.29 2.72-1.16 2.73-2.77-.01-2.2-1.9-2.96-3.66-3.42z" fill="currentColor"/>
                </svg>
                @Localizer["PaymentHistory"]
            </a>
        </li>
    }
</ul>
