@using Microsoft.AspNetCore.Mvc.Localization
@using WebApplication1.Services.Cabinets.Navigation
@model IReadOnlyList<CabinetNavItem>
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@{
    var variant = ViewData["Variant"]?.ToString()?.ToLowerInvariant() ?? "detsad";
    var activeController = ViewData["ActiveController"]?.ToString();
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString();
}
@if (variant == "medclinic")
{
    foreach (var item in Model)
    {
        if (item.HasChildren)
        {
            var children = item.Children ?? Array.Empty<CabinetNavItem>();
            var groupOpen = CabinetNavActiveHelper.IsGroupOpen(children, activeController, activeAction);
            <details class="medclinic-nav__group @(groupOpen ? "medclinic-nav__group--active-child is-active-group" : "")" @(groupOpen ? "open" : null)>
                <summary class="medclinic-nav__group-summary @(groupOpen ? "active" : "")" title="@Localizer[item.Title]">
                    <span class="medclinic-nav__icon">@Html.Raw(item.IconHtml)</span>
                    <span class="medclinic-nav__label">@Localizer[item.Label]</span>
                    <span class="medclinic-nav__group-chevron" aria-hidden="true"></span>
                </summary>
                <div class="medclinic-nav__group-items">
                    @foreach (var child in children)
                    {
                        var childActive = CabinetNavActiveHelper.IsItemActive(child, activeController, activeAction);
                        <a class="medclinic-nav__link medclinic-nav__link--nested @(childActive ? "active" : "")"
                           asp-controller="@child.Controller"
                           asp-action="@child.Action"
                           title="@Localizer[child.Title]">
                            <span class="medclinic-nav__icon">@Html.Raw(child.IconHtml)</span>
                            <span class="medclinic-nav__label">@Localizer[child.Label]</span>
                        </a>
                    }
                </div>
            </details>
            continue;
        }

        var itemActive = CabinetNavActiveHelper.IsItemActive(item, activeController, activeAction);
        <a class="medclinic-nav__link @(itemActive ? "active" : "")"
           asp-controller="@item.Controller"
           asp-action="@item.Action"
           title="@Localizer[item.Title]">
            <span class="medclinic-nav__icon">@Html.Raw(item.IconHtml)</span>
            <span class="medclinic-nav__label">@Localizer[item.Label]</span>
        </a>
    }
}
else
{
    foreach (var item in Model)
    {
        var itemActive = CabinetNavActiveHelper.IsItemActive(item, activeController, activeAction);
        <a class="dashboard-nav-item @(itemActive ? "active" : "")"
           asp-controller="@item.Controller"
           asp-action="@item.Action">
            <span class="dashboard-nav-item-icon">@Html.Raw(item.IconHtml)</span>
            <span class="dashboard-nav-item-label">@Localizer[item.Label]</span>
        </a>
    }
}
