@using Microsoft.AspNetCore.Mvc.Localization
@model IReadOnlyList<WebApplication1.Services.Cabinets.Navigation.CabinetNavItem>
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@{
    var variant = ViewData["Variant"]?.ToString()?.ToLowerInvariant() ?? "detsad";
    var activeController = ViewData["ActiveController"]?.ToString();
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString();
}
@if (variant == "medclinic")
{
    foreach (var item in Model)
    {
        if (item.HasChildren)
        {
            var children = item.Children ?? Array.Empty<WebApplication1.Services.Cabinets.Navigation.CabinetNavItem>();
                    var groupOpen = children.Any(child =>
                        string.Equals(child.Controller, activeController, StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(child.Action, activeAction, StringComparison.OrdinalIgnoreCase));
            <details class="medclinic-nav__group @(groupOpen ? "medclinic-nav__group--active-child" : "")" @(groupOpen ? "open" : null)>
                <summary class="medclinic-nav__group-summary" title="@Localizer[item.Title]">
                    <span class="medclinic-nav__icon">@Html.Raw(item.IconHtml)</span>
                    <span class="medclinic-nav__label">@Localizer[item.Label]</span>
                    <span class="medclinic-nav__group-chevron" aria-hidden="true"></span>
                </summary>
                <div class="medclinic-nav__group-items">
                    @foreach (var child in children)
                    {
                        <a class="medclinic-nav__link medclinic-nav__link--nested @((string.Equals(child.Controller, activeController, StringComparison.OrdinalIgnoreCase) && string.Equals(child.Action, activeAction, StringComparison.OrdinalIgnoreCase)) ? "active" : "")"
                           asp-controller="@child.Controller"
                           asp-action="@child.Action"
                           title="@Localizer[child.Title]">
                            <span class="medclinic-nav__icon">@Html.Raw(child.IconHtml)</span>
                            <span class="medclinic-nav__label">@Localizer[child.Label]</span>
                        </a>
                    }
                </div>
            </details>
            continue;
        }

        <a class="medclinic-nav__link @((string.Equals(item.Controller, activeController, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Action, activeAction, StringComparison.OrdinalIgnoreCase)) ? "active" : "")"
           asp-controller="@item.Controller"
           asp-action="@item.Action"
           title="@Localizer[item.Title]">
            <span class="medclinic-nav__icon">@Html.Raw(item.IconHtml)</span>
            <span class="medclinic-nav__label">@Localizer[item.Label]</span>
        </a>
    }
}
else
{
    foreach (var item in Model)
    {
        <a class="dashboard-nav-item @((string.Equals(item.Controller, activeController, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Action, activeAction, StringComparison.OrdinalIgnoreCase)) ? "active" : "")"
           asp-controller="@item.Controller"
           asp-action="@item.Action">
            <span class="dashboard-nav-item-icon">@Html.Raw(item.IconHtml)</span>
            <span class="dashboard-nav-item-label">@Localizer[item.Label]</span>
        </a>
    }
}
