@using Microsoft.AspNetCore.Mvc.Localization
@using WebApplication1.Services.Cabinets.Navigation
@model IReadOnlyList<CabinetNavItem>
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@{
    var activeController = ViewData["ActiveController"]?.ToString();
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString();
    var itemClass = ViewData["ItemClass"]?.ToString() ?? "dashboard-sidebar-bottom-item";
    var iconClass = ViewData["IconClass"]?.ToString() ?? "dashboard-nav-item-icon";
    var labelClass = ViewData["LabelClass"]?.ToString() ?? "dashboard-nav-item-label";
    var activeClass = ViewData["ActiveClass"]?.ToString() ?? "active";
}

@foreach (var item in Model)
{
    var itemActive = CabinetNavActiveHelper.IsItemActive(item, activeController, activeAction);
    <a class="@itemClass @(itemActive ? activeClass : "")"
       asp-controller="@item.Controller"
       asp-action="@item.Action"
       title="@Localizer[item.Title]">
        <span class="@iconClass">@Html.Raw(item.IconHtml)</span>
        <span class="@labelClass">@Localizer[item.Label]</span>
    </a>
}
