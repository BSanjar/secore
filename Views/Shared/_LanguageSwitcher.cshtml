@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture?.Culture?.Name ?? "ru";
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "/" : $"{Context.Request.Path.Value}{Context.Request.QueryString}";
}

<div class="dropdown">
    <button class="btn dropdown-toggle medclinic-topbar-dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        @Localizer["Language"]
        <span class="badge bg-secondary ms-1">
            @(currentCulture.ToUpper())
        </span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
        <li>
            <form asp-controller="Language" asp-action="SetLanguage" method="post" asp-route-returnUrl="@returnUrl">
                <input type="hidden" name="culture" value="ru" />
                <button type="submit" class="dropdown-item @(currentCulture == "ru" ? "active" : "")">
                    🇷🇺 @Localizer["LanguageRussian"]
                </button>
            </form>
        </li>
        <li>
            <form asp-controller="Language" asp-action="SetLanguage" method="post" asp-route-returnUrl="@returnUrl">
                <input type="hidden" name="culture" value="en" />
                <button type="submit" class="dropdown-item @(currentCulture == "en" ? "active" : "")">
                    🇬🇧 @Localizer["LanguageEnglish"]
                </button>
            </form>
        </li>
        <li>
            <form asp-controller="Language" asp-action="SetLanguage" method="post" asp-route-returnUrl="@returnUrl">
                <input type="hidden" name="culture" value="ky" />
                <button type="submit" class="dropdown-item @(currentCulture == "ky" ? "active" : "")">
                    🇰🇬 @Localizer["LanguageKyrgyz"]
                </button>
            </form>
        </li>
    </ul>
</div>

