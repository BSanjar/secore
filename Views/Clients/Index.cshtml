@section Scripts {
    @if (isStandart)
    {
        <script src="~/web/standart/js/clients.js" asp-append-version="true"></script>
        <script src="~/web/standart/js/create-invoice.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js" crossorigin="anonymous"></script>
        <script src="~/web/kindergarten/js/detsad-invoice-compose.js" asp-append-version="true"></script>
        <script src="~/web/kindergarten/js/detsad-clients.js" asp-append-version="true"></script>
        <script src="~/web/kindergarten/js/detsad-create-invoice.js" asp-append-version="true"></script>
    }
    <script>
        (function() {
            function clearChildActionsMenuPosition(menu) {
                var dd = menu.querySelector('.child-actions-menu-dropdown');
                if (!dd) return;
                dd.style.position = '';
                dd.style.left = '';
                dd.style.top = '';
                dd.style.right = '';
                dd.style.bottom = '';
                dd.style.marginTop = '';
                dd.style.zIndex = '';
            }

            function getChildActionsToggleBtn(menu) {
                return menu.querySelector('.child-actions-trigger, .child-actions-menu-btn');
            }

            function positionChildActionsMenu(menu) {
                var dd = menu.querySelector('.child-actions-menu-dropdown');
                var btn = getChildActionsToggleBtn(menu);
                if (!dd || !btn) return;
                requestAnimationFrame(function() {
                    if (!menu.classList.contains('is-open')) return;
                    var ddW = dd.offsetWidth;
                    var ddH = dd.offsetHeight;
                    var br = btn.getBoundingClientRect();
                    var margin = 4;
                    var pad = 8;
                    var left = br.right - ddW;
                    if (left < pad) left = pad;
                    if (left + ddW > window.innerWidth - pad) left = Math.max(pad, window.innerWidth - ddW - pad);
                    var top = br.bottom + margin;
                    if (top + ddH > window.innerHeight - pad) {
                        top = br.top - ddH - margin;
                    }
                    if (top < pad) top = pad;
                    dd.style.position = 'fixed';
                    dd.style.left = left + 'px';
                    dd.style.top = top + 'px';
                    dd.style.right = 'auto';
                    dd.style.bottom = 'auto';
                    dd.style.marginTop = '0';
                    dd.style.zIndex = '5000';
                });
            }

            var childMenuRepositionHandler = null;
            function bindChildMenuReposition(menu) {
                if (childMenuRepositionHandler) {
                    window.removeEventListener('scroll', childMenuRepositionHandler, true);
                    window.removeEventListener('resize', childMenuRepositionHandler);
                }
                childMenuRepositionHandler = function() {
                    if (menu.classList.contains('is-open')) positionChildActionsMenu(menu);
                };
                window.addEventListener('scroll', childMenuRepositionHandler, true);
                window.addEventListener('resize', childMenuRepositionHandler);
            }
            function unbindChildMenuReposition() {
                if (childMenuRepositionHandler) {
                    window.removeEventListener('scroll', childMenuRepositionHandler, true);
                    window.removeEventListener('resize', childMenuRepositionHandler);
                    childMenuRepositionHandler = null;
                }
            }

            document.addEventListener('click', function(e) {
                var menu = e.target.closest('.child-actions-menu');
                if (menu) {
                    e.stopPropagation();
                    var toggleBtn = getChildActionsToggleBtn(menu);
                    if (e.target.closest('.child-actions-trigger, .child-actions-menu-btn')) {
                        e.preventDefault();
                        var open = document.querySelectorAll('.child-actions-menu.is-open');
                        open.forEach(function(m) {
                            if (m !== menu) {
                                m.classList.remove('is-open');
                                clearChildActionsMenuPosition(m);
                                var btn = getChildActionsToggleBtn(m);
                                if (btn) btn.setAttribute('aria-expanded', 'false');
                            }
                        });
                        var isOpen = menu.classList.toggle('is-open');
                        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                        if (isOpen) {
                            positionChildActionsMenu(menu);
                            bindChildMenuReposition(menu);
                        } else {
                            clearChildActionsMenuPosition(menu);
                            unbindChildMenuReposition();
                        }
                        return;
                    }
                    var item = e.target.closest('.child-actions-menu-item');
                    if (item) {
                        e.preventDefault();
                        var row = menu.closest('tr.child-row');
                        if (!row) return;
                        var clientId = row.dataset.clientId;
                        var clientName = row.dataset.clientName || 'Клиент';
                        var action = item.getAttribute('data-action');
                        menu.classList.remove('is-open');
                        clearChildActionsMenuPosition(menu);
                        unbindChildMenuReposition();
                        if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
                        if (action === 'issue-invoice') {
                            if (typeof openCreateInvoiceModal === 'function') openCreateInvoiceModal(clientId);
                        } else if (action === 'edit-invoices') {
                            if (typeof openChildInvoicesManageModal === 'function') openChildInvoicesManageModal(clientId, clientName);
                        } else if (action === 'show-qr') {
                            if (typeof openChildPayQrModal === 'function') openChildPayQrModal(clientId, clientName);
                        } else if (action === 'profile') {
                            if (typeof openEditChildModal === 'function') openEditChildModal(clientId);
                        }
                        return;
                    }
                    return;
                }
                document.querySelectorAll('.child-actions-menu.is-open').forEach(function(m) {
                    m.classList.remove('is-open');
                    clearChildActionsMenuPosition(m);
                    var btn = getChildActionsToggleBtn(m);
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                });
                unbindChildMenuReposition();
            }, true);
        })();

        function dsClientsCsrfHeaders() {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            return token && token.value
                ? { 'Content-Type': 'application/json', 'RequestVerificationToken': token.value }
                : { 'Content-Type': 'application/json' };
        }

        function clientsActionFlashSuccess(message) {
            if (typeof dsClientsFlashSuccess === 'function') {
                dsClientsFlashSuccess(message);
                return;
            }
            if (window.DetsadUI && typeof DetsadUI.flashAndReload === 'function') {
                DetsadUI.flashAndReload(message || 'Готово.', 'Обновление списка...');
            } else {
                location.reload();
            }
        }

        function clientsActionShowError(message, errEl) {
            if (typeof dsClientsShowError === 'function') {
                dsClientsShowError(message);
            } else if (window.DetsadUI && typeof DetsadUI.showToast === 'function') {
                DetsadUI.showToast(message || 'Ошибка', 'danger');
            }
            if (errEl) {
                errEl.textContent = message || 'Ошибка';
                errEl.style.display = 'block';
            }
        }

        window.openEditChildModal = function(clientId) {
            var modal = document.getElementById('editChildModal');
            var loading = document.getElementById('editChildLoading');
            var form = document.getElementById('editChildForm');
            var footer = document.getElementById('editChildModalFooter');
            var errEl = document.getElementById('editChildError');
            if (!modal || !form) return;
            errEl.style.display = 'none';
            form.style.display = 'none';
            footer.style.display = 'none';
            loading.style.display = 'block';
            var loaderHost = loading.querySelector('[data-ds-loader-host]') || loading;
            if (window.DetsadUI) loaderHost.innerHTML = DetsadUI.loaderHtml('Загрузка данных');
            else loaderHost.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div>';
            var bsModal = new bootstrap.Modal(modal);
            bsModal.show();
            fetch('/Clients/GetInfo?clientId=' + encodeURIComponent(clientId))
                .then(function(r) { if (!r.ok) throw new Error('Ошибка загрузки'); return r.json(); })
                .then(function(data) {
                    if (!data || !data.success || !data.client) throw new Error((data && data.message) || 'Ошибка загрузки');
                    var c = data.client;
                    var additionalFields = c.additionalFields || data.additionalFields || [];
                    document.getElementById('editClientId').value = c.id || clientId;
                    document.getElementById('editClientName').value = c.clientName || c.name || '';
                    document.getElementById('editClientInn').value = c.clientInn || c.inn || '';
                    var groupEl = document.getElementById('editOrgClientGroupId');
                    if (groupEl) groupEl.value = c.orgClientGroupId || '';
                    document.getElementById('editClientPhone').value = c.clientPhone || c.phone || '';
                    document.getElementById('editClientEmail').value = c.clientEmail || c.email || '';
                    document.getElementById('editClientWa').value = c.clientWa || '';
                    document.getElementById('editClientTg').value = c.clientTg || '';
                    document.getElementById('editClientAdres').value = c.clientAddress || c.address || c.clientAdres || '';
                    var statusRaw = c.clientStatus != null && c.clientStatus !== undefined ? c.clientStatus : c.status;
                    var statusVal = statusRaw !== undefined && statusRaw !== null ? String(statusRaw) : '1';
                    document.getElementById('editClientStatus').value = statusVal === '2' ? '0' : statusVal;
                    form.querySelectorAll('[data-field-id]').forEach(function(el) {
                        if (el.tagName === 'SELECT' || el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                            if (!el.closest('.ds-birth-date')) el.value = '';
                        }
                    });
                    additionalFields.forEach(function(f) {
                        var fid = f.fieldId || f.FieldId;
                        var val = (f.value || f.Value || '').trim();
                        var birthWrap = document.querySelector('#editChildForm .ds-birth-date[data-field-id="' + fid + '"]');
                        if (birthWrap) {
                            var hidden = birthWrap.querySelector('input[data-field-id]');
                            if (hidden) {
                                hidden.value = val.split('T')[0];
                                if (typeof applyBirthDateToSelects === 'function') {
                                    applyBirthDateToSelects(birthWrap, hidden.value);
                                }
                            }
                            return;
                        }
                        var el = document.querySelector('#editChildForm [data-field-id="' + fid + '"]');
                        if (el) el.value = val.split('T')[0];
                    });
                    if (typeof initBirthDateWidgets === 'function') {
                        initBirthDateWidgets(document.getElementById('editChildForm'));
                    }
                    var photoPrev = document.getElementById('editChildPhotoPreview');
                    var photoPh = document.getElementById('editChildPhotoPlaceholder');
                    var photoInp = document.getElementById('editChildPhoto');
                    var photoRem = document.getElementById('editChildPhotoRemove');
                    if (photoInp) photoInp.value = '';
                    if (photoRem) photoRem.checked = false;
                    if (photoPrev && photoPh) {
                        var logoUrl = c.clientLogo || c.logo;
                        if (logoUrl) {
                            photoPrev.src = logoUrl + (logoUrl.indexOf('?') >= 0 ? '' : ('?t=' + Date.now()));
                            photoPrev.classList.remove('d-none');
                            photoPh.classList.add('d-none');
                        } else {
                            photoPrev.classList.add('d-none');
                            photoPrev.removeAttribute('src');
                            photoPh.classList.remove('d-none');
                        }
                    }
                    loading.style.display = 'none';
                    form.style.display = 'block';
                    footer.style.display = 'flex';
                })
                .catch(function(e) {
                    loading.style.display = 'none';
                    clientsActionShowError(e.message || 'Не удалось загрузить данные.', errEl);
                });
        };

        document.getElementById('editChildSaveBtn') && document.getElementById('editChildSaveBtn').addEventListener('click', function() {
            var form = document.getElementById('editChildForm');
            var errEl = document.getElementById('editChildError');
            var saveBtn = document.getElementById('editChildSaveBtn');
            var clientId = document.getElementById('editClientId').value;
            if (!clientId) return;
            if (!form.checkValidity()) { form.reportValidity(); return; }
            var additionalFields = {};
            form.querySelectorAll('[data-field-id]').forEach(function(el) {
                var id = el.getAttribute('data-field-id');
                if (id && el.name) additionalFields[id] = el.value || '';
            });
            var editGroupEl = document.getElementById('editOrgClientGroupId');
            var payload = {
                clientId: clientId,
                clientName: document.getElementById('editClientName').value,
                clientInn: document.getElementById('editClientInn').value,
                orgClientGroupId: editGroupEl ? (editGroupEl.value || null) : null,
                clientPhone: document.getElementById('editClientPhone').value,
                clientAdres: document.getElementById('editClientAdres').value,
                clientEmail: document.getElementById('editClientEmail').value,
                clientWa: document.getElementById('editClientWa').value,
                clientTg: document.getElementById('editClientTg').value,
                clientStatus: parseInt(document.getElementById('editClientStatus').value, 10),
                additionalFields: additionalFields
            };
            if (window.DetsadUI) {
                DetsadUI.setButtonLoading(saveBtn, true, { label: 'Сохранение...' });
                DetsadUI.showOverlay('Сохранение...');
            } else if (saveBtn) {
                saveBtn.disabled = true;
            }
            fetch('/Clients/Update', {
                method: 'POST',
                headers: dsClientsCsrfHeaders(),
                body: JSON.stringify(payload)
            }).then(function(r) { return r.json(); })
            .then(async function(res) {
                if (!res.success) {
                    if (window.DetsadUI) DetsadUI.hideOverlay();
                    clientsActionShowError(res.message || 'Ошибка сохранения', errEl);
                    return;
                }
                var photoFileEl = document.getElementById('editChildPhoto');
                var removePhotoCb = document.getElementById('editChildPhotoRemove');
                var needPhoto = (removePhotoCb && removePhotoCb.checked) || (photoFileEl && photoFileEl.files && photoFileEl.files.length);
                if (needPhoto && typeof uploadChildPhoto === 'function') {
                    if (window.DetsadUI) DetsadUI.setButtonLoading(saveBtn, true, { label: 'Загрузка фото...' });
                    var pr = await uploadChildPhoto(clientId, photoFileEl && photoFileEl.files && photoFileEl.files.length ? photoFileEl.files[0] : null, removePhotoCb && removePhotoCb.checked);
                    if (!pr.success) {
                        if (window.DetsadUI) DetsadUI.hideOverlay();
                        clientsActionShowError('Данные сохранены, но фото: ' + (pr.message || 'ошибка'), errEl);
                        return;
                    }
                }
                bootstrap.Modal.getInstance(document.getElementById('editChildModal')).hide();
                clientsActionFlashSuccess(res.message || 'Данные клиента обновлены');
            }).catch(function() {
                if (window.DetsadUI) DetsadUI.hideOverlay();
                clientsActionShowError('Ошибка сети', errEl);
            }).finally(function() {
                if (window.DetsadUI) DetsadUI.setButtonLoading(saveBtn, false);
                else if (saveBtn) saveBtn.disabled = false;
            });
        });
        (function() {
            var rem = document.getElementById('editChildPhotoRemove');
            var fin = document.getElementById('editChildPhoto');
            if (rem && fin) {
                rem.addEventListener('change', function() { if (this.checked) fin.value = ''; });
                fin.addEventListener('change', function() { if (this.files && this.files.length && rem) rem.checked = false; });
            }
        })();

        document.getElementById('editChildDeleteBtn') && document.getElementById('editChildDeleteBtn').addEventListener('click', function() {
            if (!confirm('Удалить клиента из списка? Все его счета будут закрыты, статус клиента — «Удалён».')) return;
            var clientId = document.getElementById('editClientId').value;
            var deleteBtn = document.getElementById('editChildDeleteBtn');
            if (!clientId) return;
            var payload = {
                clientId: clientId,
                clientName: document.getElementById('editClientName').value,
                clientInn: document.getElementById('editClientInn').value,
                orgClientGroupId: document.getElementById('editOrgClientGroupId').value || null,
                clientPhone: document.getElementById('editClientPhone').value,
                clientAdres: document.getElementById('editClientAdres').value,
                clientEmail: document.getElementById('editClientEmail').value,
                clientWa: document.getElementById('editClientWa').value,
                clientTg: document.getElementById('editClientTg').value,
                clientStatus: 2,
                additionalFields: {}
            };
            document.getElementById('editChildForm').querySelectorAll('[data-field-id]').forEach(function(el) {
                var id = el.getAttribute('data-field-id');
                if (id) payload.additionalFields[id] = el.value || '';
            });
            if (window.DetsadUI) {
                DetsadUI.setButtonLoading(deleteBtn, true, { label: 'Удаление...' });
                DetsadUI.showOverlay('Удаление...');
            }
            fetch('/Clients/Update', {
                method: 'POST',
                headers: dsClientsCsrfHeaders(),
                body: JSON.stringify(payload)
            }).then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('editChildModal')).hide();
                    clientsActionFlashSuccess(res.message || 'Клиент удалён');
                } else {
                    if (window.DetsadUI) DetsadUI.hideOverlay();
                    clientsActionShowError(res.message || 'Ошибка', document.getElementById('editChildError'));
                    if (window.DetsadUI) DetsadUI.setButtonLoading(deleteBtn, false);
                }
            }).catch(function() {
                if (window.DetsadUI) {
                    DetsadUI.hideOverlay();
                    DetsadUI.setButtonLoading(deleteBtn, false);
                }
                clientsActionShowError('Ошибка сети', document.getElementById('editChildError'));
            });
        });

    </script>
}
