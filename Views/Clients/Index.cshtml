<!-- Модальное окно регистрации ребёнка (шаги: данные → счёт? → оформление счёта) -->
<div class="modal fade" id="addChildModal" tabindex="-1" aria-labelledby="addChildModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable add-child-modal-dialog">
        <div class="modal-content add-child-modal">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title mb-1" id="addChildModalLabel">Регистрация ребёнка</h5>
                    <p class="text-muted small mb-0" id="addChildStepSubtitle">Шаг 1 · Данные</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="add-child-steps" id="addChildStepsBar" aria-hidden="true">
                <div class="add-child-steps__item is-active" data-step="1"><span>1</span> Данные</div>
                <div class="add-child-steps__item" data-step="2"><span>2</span> Счёт</div>
                <div class="add-child-steps__item" data-step="3"><span>3</span> Оплата</div>
            </div>
            <div class="modal-body position-relative">
                <div id="addChildBusyLayer" class="add-child-busy" hidden aria-hidden="true"></div>
                <div id="addChildStep1">
                    <form id="childForm" novalidate>
                        <div class="row mb-3">
                            <div class="col-8">
                                <label for="clientName" class="form-label">ФИО клиента <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="clientName" name="clientName" required>
                                <div class="invalid-feedback">Пожалуйста, укажите ФИО клиента</div>
                            </div>
                            <div class="col-4">
                                <label for="clientInn" class="form-label">ИНН <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="clientInn" name="clientInn" maxlength="14" pattern="[0-9]{14}" required>
                                <div class="invalid-feedback">ИНН должен содержать 14 цифр</div>
                            </div>
                        </div>
                    @if (orgClientGroups != null && orgClientGroups.Any())
                    {
                        <div class="mb-3" id="groupSelectWrapper">
                            <label for="orgClientGroupId" class="form-label">Группа</label>
                            <select class="form-select" id="orgClientGroupId" name="orgClientGroupId">
                                <option value="">Без группы</option>
                                @foreach (var g in orgClientGroups)
                                {
                                    <option value="@g.Id">@(g.Name ?? g.Id)</option>
                                }
                            </select>
                        </div>
                    }
                        <div class="form-section-divider mb-3">
                            <span class="divider-text">Контактные данные</span>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="clientPhone" class="form-label">Телефон <span class="text-danger">*</span></label>
                            <div class="d-flex align-items-start gap-2">
                                <div class="flex-grow-1">
                                <input type="tel" class="form-control form-control-compact" id="clientPhone" name="clientPhone" placeholder="+996(***) *** ***" required>
                                <div class="invalid-feedback">Пожалуйста, укажите корректный номер телефона</div>
                                </div>
                                <div class="form-check mt-2 pt-1">
                                    <input class="form-check-input" type="checkbox" id="phoneIsWa" name="phoneIsWa">
                                    <label class="form-check-label small" for="phoneIsWa">WhatsApp</label>
                                </div>
                            </div>
                            </div>
                            <div class="col-6">
                                <label for="clientEmail" class="form-label">Email</label>
                                <input type="email" class="form-control form-control-compact" id="clientEmail" name="clientEmail">
                                <div class="invalid-feedback">Пожалуйста, укажите корректный email</div>
                            </div>
                        </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label for="clientWa" class="form-label">WhatsApp</label>
                            <input type="text" class="form-control form-control-compact" id="clientWa" name="clientWa" placeholder="+996(***) *** ***">
                        </div>
                        <div class="col-6">
                            <label for="clientTg" class="form-label">Telegram</label>
                            <input type="text" class="form-control form-control-compact" id="clientTg" name="clientTg" placeholder="username или +996...">
                        </div>
                    </div>
                        <div class="mb-3">
                            <label for="clientAdres" class="form-label">Адрес</label>
                            <input type="text" class="form-control form-control-compact" id="clientAdres" name="clientAdres">
                        </div>
                        <div class="mb-3">
                            <label for="addChildPhoto" class="form-label">Фото (необязательно)</label>
                            <input type="file" class="form-control" id="addChildPhoto" accept="image/jpeg,image/png,image/webp,image/gif" />
                        </div>
                    @if (organizationFields != null && organizationFields.Any())
                    {
                        <div class="form-section-divider mb-3">
                            <span class="divider-text">Дополнительная информация</span>
                </div>
                        <div id="additionalFieldsSection">
                            @foreach (var f in organizationFields)
                            {
                                var fieldId = "af_" + f.Id;
                                var label = f.FieldName ?? f.Id;
                                var isBirthDateField = f.FieldType == "datetime"
                                    && (label.Contains("рожд", StringComparison.OrdinalIgnoreCase)
                                        || label.Contains("birth", StringComparison.OrdinalIgnoreCase));
                                <div class="mb-3">
                                    <label for="@fieldId" class="form-label">@label</label>
                                    @if (f.FieldType == "selected" && !string.IsNullOrEmpty(f.FieldSelectValues))
                                    {
                                        var options = (f.FieldSelectValues ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                                        <select class="form-select form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id">
                                            <option value="">— не указано —</option>
                                            @foreach (var opt in options)
                                            {
                                                <option value="@opt.Trim()">@opt.Trim()</option>
                                            }
                                        </select>
                                    }
                                    else if (f.FieldType == "int")
                                    {
                                        <input type="number" class="form-control form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id" step="1">
                                    }
                                    else if (f.FieldType == "money")
                                    {
                                        <input type="number" class="form-control form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id" step="0.01" min="0">
                                    }
                                    else if (f.FieldType == "datetime" && isBirthDateField)
                                    {
                                        <div class="ds-birth-date" data-field-id="@f.Id">
                                            <div class="ds-birth-date__fields">
                                                <select class="form-select ds-birth-date__day" aria-label="День"><option value="">День</option></select>
                                                <select class="form-select ds-birth-date__month" aria-label="Месяц"><option value="">Месяц</option></select>
                                                <select class="form-select ds-birth-date__year" aria-label="Год"><option value="">Год</option></select>
                                            </div>
                                            <input type="hidden" id="@fieldId" data-field-id="@f.Id" value="" />
                                        </div>
                                    }
                                    else if (f.FieldType == "datetime")
                                    {
                                        <input type="date" class="form-control ds-date-input" id="@fieldId" name="@fieldId" data-field-id="@f.Id">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-compact" id="@fieldId" name="@fieldId" data-field-id="@f.Id">
                                    }
                            </div>
                            }
                        </div>
                    }
                    </form>
                    <div id="errorMessage" class="alert alert-danger" style="display: none;" role="alert"></div>
                </div>
                <div id="addChildStepChoice" style="display: none;">
                    <p class="add-child-choice-title mb-4">Выставить счёт?</p>
                    <div class="d-grid gap-3 add-child-choice-grid">
                        <button type="button" class="btn btn-success btn-lg add-child-choice-btn" id="addChildChoiceYes">
                            Да, выставить счёт
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-lg add-child-choice-btn" id="addChildChoiceNo">
                            Нет, только ребёнок
                        </button>
                    </div>
                </div>
                <div id="addChildStepInvoice" style="display: none;">
                    @await Html.PartialAsync("~/Views/Clients/_DetsadInvoiceComposer.cshtml")
                    <div class="add-child-invoice-cta-wrap">
                        <button type="button" class="btn ds-create-invoice-cta w-100" id="addChildCreateInvoiceBtn" disabled>
                            Создать счёт на оплату
                        </button>
                        <p class="add-child-invoice-cta-hint">Ребёнок будет зарегистрирован вместе со счётом</p>
                    </div>
                </div>
                <div id="addChildStepResult" style="display: none;" role="status" aria-live="polite"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary" id="addChildBtnCancel" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-outline-secondary me-auto" id="addChildBtnBack" style="display: none;">Назад</button>
                <button type="button" class="btn btn-success" id="submitBtn">Далее</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно импорта клиентов из Excel -->
<div class="modal fade" id="importChildrenModal" tabindex="-1" aria-labelledby="importChildrenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importChildrenModalLabel">Загрузка клиентов из Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2">
                    Скачайте шаблон с колонками на русском языке. Обязательны только <strong>ФИО</strong> и <strong>ИНН</strong>;
                    номер телефона, адрес и эл. почта — по желанию.
                </p>
                <div class="mb-3">
                    <a asp-action="DownloadImportTemplate" class="btn btn-outline-secondary btn-sm">
                        Скачать шаблон Excel
                    </a>
                </div>

                @{
                    var importPreviewRows = ViewBag.ClientsImportPreviewRows as List<WebApplication1.Dtos.ChildrenImportRowDto>;
                    var importPreviewId = ViewBag.ClientsImportPreviewId as string;
                }

                @if (importPreviewRows != null && importPreviewRows.Any() && !string.IsNullOrEmpty(importPreviewId))
                {
                    <div class="mb-3">
                        <div class="alert alert-info mb-2">
                            Найден предварительный импорт. Проверьте строки ниже и нажмите «Загрузить», чтобы создать клиентов.
                        </div>
                        <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>ФИО</th>
                                        <th>ИНН</th>
                                        <th>Номер телефона</th>
                                        <th>Адрес</th>
                                        <th>Эл. почта</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in importPreviewRows)
                                    {
                                        var isValid = row.IsValid && string.IsNullOrWhiteSpace(row.Error);
                                        <tr class="@(isValid ? "" : "table-warning")">
                                            <td>@(row.ClientName ?? "—")</td>
                                            <td>@(row.ClientInn ?? "—")</td>
                                            <td>@(row.ClientPhone ?? "—")</td>
                                            <td>@(row.ClientAddress ?? "—")</td>
                                            <td>@(row.ClientEmail ?? "—")</td>
                                            <td>
                                                @if (isValid)
                                                {
                                                    <span class="text-success small">OK</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger small">@row.Error</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <form asp-action="ConfirmImport" method="post" class="mt-3 d-flex justify-content-end gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="importId" value="@importPreviewId" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                                Отмена
                            </button>
                            <button type="submit" class="btn btn-primary btn-sm">
                                Загрузить
                            </button>
                        </form>
                            </div>
                }
                else
                {
                    <form asp-action="PreviewImport" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="childrenImportFile" class="form-label">Файл Excel</label>
                            <input type="file" class="form-control" id="childrenImportFile" name="file" accept=".xlsx,.xls" />
                            <div class="form-text">
                                Допустимые форматы: .xlsx, .xls. Если файл не выбран, появится сообщение — окно импорта останется доступным.
                            </div>
                        </div>
                        <div class="mb-3 text-end">
                            <button type="submit" class="btn btn-primary btn-sm">
                                Предпросмотр
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="childrenImportModalAutoOpen" value="@(ViewBag.OpenClientsImportModal == true ? "1" : "0")" />

