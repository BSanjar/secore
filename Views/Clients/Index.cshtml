                    <h5 class="modal-title mb-1" id="childPayQrModalLabel">QR для оплаты</h5>
                    <p class="text-muted small mb-0" id="childPayQrSubtitle">—</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body text-center" id="childPayQrBody">
                <div class="py-4" data-ds-loader-host></div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-soft-secondary" data-bs-dismiss="modal">Закрыть</button>
