                                    @if (f.FieldType == "selected" && !string.IsNullOrEmpty(f.FieldSelectValues))
                                    {
                                        var options = (f.FieldSelectValues ?? "").Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                                        <select class="form-select" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id">
                                            <option value="">— не указано —</option>
                                            @foreach (var opt in options)
                                            {
                                                <option value="@opt.Trim()">@opt.Trim()</option>
                                            }
                                        </select>
                                    }
                                    else if (f.FieldType == "int")
                                    {
                                        <input type="number" class="form-control" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id" step="1">
                                    }
                                    else if (f.FieldType == "money")
                                    {
                                        <input type="number" class="form-control" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id" step="0.01" min="0">
                                    }
                                    else if (f.FieldType == "datetime" && isBirthDateField)
                                    {
                                        <div class="ds-birth-date" data-field-id="@f.Id">
                                            <div class="ds-birth-date__fields">
                                                <select class="form-select ds-birth-date__day" aria-label="День"><option value="">День</option></select>
                                                <select class="form-select ds-birth-date__month" aria-label="Месяц"><option value="">Месяц</option></select>
                                                <select class="form-select ds-birth-date__year" aria-label="Год"><option value="">Год</option></select>
                                            </div>
                                            <input type="hidden" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id" value="" />
                                        </div>
                                    }
                                    else if (f.FieldType == "datetime")
                                    {
                                        <input type="date" class="form-control ds-date-input" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id">
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control" id="@fieldId" name="additionalFields[@f.Id]" data-field-id="@f.Id">
                                    }
                                </div>
                            }
                        </div>
                    }
                </form>
                <div id="editChildError" class="alert alert-danger" style="display: none;" role="alert"></div>
            </div>
            <div class="modal-footer border-0 pt-0" id="editChildModalFooter" style="display: none;">
                <button type="button" class="btn btn-outline-danger me-auto" id="editChildDeleteBtn">Удалить</button>
                <button type="button" class="btn btn-soft-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn detsad-btn-primary" id="editChildSaveBtn">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<!-- Счета клиента: просмотр и удаление -->
<div class="modal fade" id="childInvoicesManageModal" tabindex="-1" aria-labelledby="childInvoicesManageModalLabel" aria-hidden="true">
