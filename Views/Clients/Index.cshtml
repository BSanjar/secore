@using System.Linq
@using WebApplication1.Helpers
@{
    ViewData["Title"] = "Клиенты";
    var organizationType = AuthorizationHelper.GetOrganizationType(Context);
    var isStandart = string.Equals(organizationType, "standart", StringComparison.OrdinalIgnoreCase);
    var isAdmin = AuthorizationHelper.IsAdminRole(Context);
    var canRegisterChild = isAdmin || PermissionHelper.HasPermission(Context, "children.create");
    var canBulkInvoice = isAdmin || PermissionHelper.HasPermission(Context, "invoices.create");
    var showChildrenActions = canRegisterChild || canBulkInvoice;
    var organizationFields = ViewBag.OrganizationFields as List<WebApplication1.Models.DBModels.OrganizationField> ?? new List<WebApplication1.Models.DBModels.OrganizationField>();
    var orgClientGroups = ViewBag.OrgClientGroups as List<WebApplication1.Models.DBModels.OrgClientGroup> ?? new List<WebApplication1.Models.DBModels.OrgClientGroup>();
    var search = ViewBag.Search as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "active";
    var debtorsOnly = ViewBag.DebtorsOnly as bool? ?? false;
    var clientsData = ViewBag.ClientsData as List<WebApplication1.Models.DBModels.OrganizationClient> ?? new List<WebApplication1.Models.DBModels.OrganizationClient>();
    var clientTotalBalanceByClientId = ViewBag.ClientTotalBalanceByClientId as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var firstInvoiceIdByClientId = ViewBag.FirstInvoiceIdByClientId as Dictionary<string, string> ?? new Dictionary<string, string>();
}

@section Styles {
    @if (isStandart)
    {
        <link rel="stylesheet" href="~/web/standart/css/clients.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/web/standart/css/create-invoice.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/web/kindergarten/css/detsad-create-invoice.css" asp-append-version="true" />
    }
    <style>
        /* Верхняя строка — фильтры на всю ширину; ниже — кнопки действий */
        .dashboard-filters.children-filters-wrap {
            flex-direction: column;
            align-items: stretch;
            gap: 14px;
        }

        .children-filters-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            width: 100%;
        }

        .children-filters-row .children-search-box {
            flex: 1 1 220px;
            min-width: 200px;
            max-width: none !important;
        }

        .children-actions-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding-top: 2px;
            border-top: 1px solid var(--card-border, #e2eaf0);
        }

        .children-actions-row__start,
        .children-actions-row__end {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
        }

        .btn-register-child {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.55rem;
            min-height: 46px;
            padding: 0.6rem 1.35rem;
            border: none;
            border-radius: 14px;
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 50%, #15803d 100%);
            color: #fff;
            font-size: 0.9375rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            white-space: nowrap;
            box-shadow: 0 10px 24px rgba(22, 163, 74, 0.35);
            transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
        }

        .btn-register-child:hover {
            color: #fff;
            filter: brightness(1.05);
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(22, 163, 74, 0.42);
        }

        .btn-register-child:active {
            transform: translateY(0);
        }

        .btn-register-child__icon {
            display: inline-grid;
            place-items: center;
            width: 28px;
            height: 28px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.22);
            flex-shrink: 0;
        }

        .dashboard-filters {
            position: relative;
            z-index: 10;
        }

        .dashboard-table-card {
            position: relative;
            z-index: 1;
            overflow: visible !important;
        }

        .dashboard-table-card .table-wrap {
            overflow-x: auto;
            overflow-y: visible;
        }

        /* При position:fixed из JS меню не обрезается overflow таблицы */
        .child-actions-menu.is-open .child-actions-menu-dropdown {
            z-index: 5000;
        }

        .child-row-avatar {
            object-fit: cover;
            border: 1px solid var(--card-border, #e2eaf0);
        }
        .child-row-avatar-placeholder {
            width: 40px;
            height: 40px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-muted, #8c9aaa);
            background: var(--card-bg-soft, #f6fafd);
            border: 1px dashed var(--card-border, #e2eaf0);
        }

        .btn-issue-invoice {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            min-height: 34px;
            padding: 0.35rem 0.85rem;
            border: none;
            border-radius: 999px;
            background: linear-gradient(135deg, #4fc3f7 0%, #39a0db 100%);
            color: #fff;
            font-size: 0.8125rem;
            font-weight: 600;
            letter-spacing: 0.01em;
            white-space: nowrap;
            box-shadow: 0 6px 14px rgba(57, 160, 219, 0.28);
            transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
        }

        .btn-issue-invoice:hover {
            color: #fff;
            filter: brightness(1.05);
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(57, 160, 219, 0.34);
        }

        .btn-issue-invoice:active {
            transform: translateY(0);
        }

        .btn-issue-invoice-bulk {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            min-height: 42px;
            padding: 0.55rem 1.2rem;
            border: none;
            border-radius: 14px;
            background: linear-gradient(135deg, #ff8a65 0%, #ff7043 55%, #f4511e 100%);
            color: #fff;
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            white-space: nowrap;
            box-shadow: 0 10px 22px rgba(244, 81, 30, 0.28);
            transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
        }

        .btn-issue-invoice-bulk:hover {
            color: #fff;
            filter: brightness(1.04);
            transform: translateY(-1px);
            box-shadow: 0 12px 26px rgba(244, 81, 30, 0.34);
        }

        .btn-issue-invoice-bulk:active {
            transform: translateY(0);
        }

        .btn-issue-invoice-bulk__icon {
            display: inline-grid;
            place-items: center;
            width: 26px;
            height: 26px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.2);
            flex-shrink: 0;
        }

        .btn-clients-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            min-height: 42px;
            padding: 0.55rem 1.05rem;
            border-radius: 14px;
            border: 1px solid rgba(57, 160, 219, 0.22);
            background: #fff;
            color: #1f4e63;
            font-size: 0.875rem;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(120, 144, 166, 0.08);
            transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background 0.15s ease;
        }

        .btn-clients-action:hover {
            color: #163847;
            background: #f7fbfe;
            border-color: rgba(57, 160, 219, 0.4);
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(120, 144, 166, 0.12);
        }

        .cell-issue-invoice {
            white-space: nowrap;
        }

        .child-actions-trigger {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            min-height: 36px;
            padding: 0.35rem 0.85rem 0.35rem 0.65rem;
            border: 1px solid rgba(43, 184, 240, 0.35);
            border-radius: 999px;
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f7fe 100%);
            color: #0c4a6e;
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(14, 165, 233, 0.12);
            transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        }

        .child-actions-trigger:hover {
            border-color: rgba(14, 165, 233, 0.55);
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(14, 165, 233, 0.2);
        }

        .child-actions-trigger__icon {
            display: inline-grid;
            place-items: center;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4fc3f7 0%, #0ea5e9 100%);
            color: #fff;
        }

        .child-actions-trigger__chevron {
            opacity: 0.65;
            margin-left: -0.15rem;
        }

        .child-actions-menu-dropdown {
            min-width: 260px;
        }

        .col-child-actions {
            width: 1%;
            white-space: nowrap;
        }

        @@media (max-width: 992px) {
            .children-actions-row {
                flex-direction: column;
                align-items: stretch;
            }
            .children-actions-row__start,
            .children-actions-row__end {
                flex-direction: column;
                align-items: stretch;
            }
            .children-actions-row .btn-soft-primary,
            .children-actions-row .btn-soft-secondary,
            .children-actions-row .btn-issue-invoice-bulk,
            .children-actions-row .btn-clients-action,
            .children-actions-row .btn-register-child {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

<div class="dashboard-page">
    <div class="page-header">
                <h1 class="page-title">Клиенты</h1>
        <p class="page-subtitle mb-0">Список клиентов с основной информацией и статусами</p>
    </div>
    <!-- Фильтры и кнопки действий -->
    <div class="dashboard-filters children-filters-wrap">
        <div class="children-filters-row">
            <div class="search-box children-search-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;color:var(--text-muted)">
                        <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
                    </svg>
                <input type="text" id="searchInput" placeholder="Поиск по имени, телефону, email..." value="@search">
            </div>
            <select id="statusFilter" class="form-select-soft">
                    @if (statusFilter == "active")
                    {
                        <option value="active" selected>Активные</option>
                        <option value="inactive">Неактивные</option>
                    <option value="deleted">Удалённые</option>
                    }
                    else if (statusFilter == "inactive")
                    {
                        <option value="active">Активные</option>
                        <option value="inactive" selected>Неактивные</option>
                    <option value="deleted">Удалённые</option>
                    }
                    else
                    {
                        <option value="active">Активные</option>
                        <option value="inactive">Неактивные</option>
                    <option value="deleted" selected>Удалённые</option>
                    }
                </select>
            <label class="form-check-soft">
                <input type="checkbox" id="debtorsFilter" @(debtorsOnly ? "checked" : "")>
                <span>Только должники</span>
            </label>
            @if (orgClientGroups != null && orgClientGroups.Any())
            {
                <div class="groups-filter-dropdown">
                    <button type="button" class="btn-soft-secondary" id="groupsFilterBtn" aria-expanded="false" aria-haspopup="true">
                        <span class="groups-filter-btn-text">По группам</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5H7z"/></svg>
                    </button>
                    <div class="groups-filter-menu" id="groupsFilterMenu" role="menu" aria-hidden="true">
                        <div class="groups-filter-search-wrap p-2 border-bottom">
                            <input type="text" class="form-control form-control-sm groups-filter-search" id="groupsFilterSearch" placeholder="Поиск групп..." autocomplete="off">
            </div>
                        <div class="groups-filter-list" id="groupsFilterList">
                            @foreach (var g in orgClientGroups)
                            {
                                <label class="groups-filter-item">
                                    <input type="checkbox" class="form-check-input group-filter-checkbox" value="@g.Id" data-group-name="@(g.Name ?? "")" checked>
                                    <span class="groups-filter-item-text">@(g.Name ?? g.Id)</span>
                    </label>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (showChildrenActions)
        {
            <div class="children-actions-row">
                @if (canRegisterChild)
                {
                    <div class="children-actions-row__start">
                        <button type="button" class="btn-register-child" onclick="openAddChildModal()">
                            <span class="btn-register-child__icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4zm5-9h-3V3h-2v2H9V3H7v2H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2z"/>
                                </svg>
                            </span>
                            Регистрация нового ребёнка
                        </button>
                        <button type="button" class="btn-clients-action" onclick="openImportChildrenModal()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                            </svg>
                            Загрузить из Excel
                        </button>
                    </div>
                }
                @if (canBulkInvoice)
                {
                    <div class="children-actions-row__end@(canRegisterChild ? "" : " ms-auto")">
                        <button type="button" class="btn-issue-invoice-bulk" onclick="openCreateInvoiceModal()">
                            <span class="btn-issue-invoice-bulk__icon" aria-hidden="true">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M19 14V6c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-9-1c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm13-6v11c0 1.1-.9 2-2 2H4v-2h17V7h2z"/>
                                </svg>
                            </span>
                            Выставить счёт массово
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Таблица клиентов -->
    <div class="dashboard-table-card">
        <div class="table-wrap">
        @if (clientsData != null && clientsData.Any())
        {
                <table class="table-soft" id="childrenTable">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:52px">Фото</th>
                            <th>ФИО</th>
                            <th>Телефон</th>
                            <th>Регистрация</th>
                            <th>Баланс</th>
                            <th>Статус</th>
                            <th class="text-end col-child-actions">Действия</th>
                        </tr>
                    </thead>
                    <tbody id="childrenCards">
                        @foreach (var client in clientsData)
            {
                var statusText = "Неизвестно";
                            var statusClass = "status-deleted";
                            if (client.ClientStatus == 1) { statusText = "Активный"; statusClass = "status-active"; }
                            else if (client.ClientStatus == 0) { statusText = "Приостановлен"; statusClass = "status-suspended"; }

                            var totalBalanceTyiyn = clientTotalBalanceByClientId.GetValueOrDefault(client.Id, 0m);
                            var totalBalanceSoms = totalBalanceTyiyn / 100m;
                            var searchText = $"{client.ClientName} {client.ClientPhone} {client.ClientEmail} {client.ClientAddress} {string.Join(" ", client.OrganizationClientsAdditionalFields?.Select(af => af.Value ?? "") ?? Array.Empty<string>())}";
                            var firstInvoiceId = firstInvoiceIdByClientId.GetValueOrDefault(client.Id, "");
                            <tr class="child-row"
                                data-client-id="@client.Id"
                                data-client-name="@(client.ClientName ?? "")"
                                data-org-client-group-id="@(client.OrgClientGroupId ?? "")"
                                data-first-invoice-id="@firstInvoiceId"
                                data-search-text="@searchText">
                                <td class="text-center align-middle">
                                    @if (!string.IsNullOrEmpty(client.ClientLogo))
                                    {
                                        <img src="@client.ClientLogo" alt="" class="rounded-circle child-row-avatar" width="40" height="40" loading="lazy" />
                }
                else
                {
                                        <span class="child-row-avatar-placeholder rounded-circle d-inline-flex align-items-center justify-content-center" title="Нет фото">?</span>
                                    }
                                </td>
                                <td><span class="cell-name">@(client.ClientName ?? "—")</span></td>
                                <td class="cell-muted">@(client.ClientPhone ?? "—")</td>
                                <td class="cell-muted">@(client.CreatedDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td class="@(totalBalanceTyiyn < 0 ? "balance-negative" : "balance-positive")">@totalBalanceSoms.ToString("N2") сом</td>
                                <td><span class="status-badge @statusClass">@statusText</span></td>
                                <td class="cell-actions text-end">
                                    <div class="child-actions-menu">
                                        <button type="button" class="child-actions-trigger" title="Действия" aria-haspopup="true" aria-expanded="false" aria-controls="child-actions-dropdown-@client.Id" id="child-actions-btn-@client.Id">
                                            <span class="child-actions-trigger__icon" aria-hidden="true">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a2 2 0 012 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 017 7h1v2h-1v7h-4v-7H9v7H5v-7H4v-2h1a7 7 0 017-7h1V5.73A2 2 0 0112 2zm0 4a5 5 0 00-5 5v1h10V11a5 5 0 00-5-5z"/></svg>
                                            </span>
                                            <span class="child-actions-trigger__label">Действия</span>
                                            <svg class="child-actions-trigger__chevron" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
                                        </button>
                                        <div class="child-actions-menu-dropdown" role="menu" id="child-actions-dropdown-@client.Id" aria-labelledby="child-actions-btn-@client.Id">
                                            <button type="button" class="child-actions-menu-item" role="menuitem" data-action="issue-invoice">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 14V6c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-9-1c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm13-6v11c0 1.1-.9 2-2 2H4v-2h17V7h2z"/></svg>
                                                Выставить новый счёт
                                            </button>
                                            <button type="button" class="child-actions-menu-item" role="menuitem" data-action="edit-invoices">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                                                Редактировать счета
                                            </button>
                                            <button type="button" class="child-actions-menu-item" role="menuitem" data-action="show-qr">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 11h8V3H3v8zm2-6h4v4H5V5zm8-2v8h8V3h-8zm6 6h-4V5h4v4zM3 21h8v-8H3v8zm2-6h4v4H5v-4zm13-2h-2v3h-3v2h3v3h2v-3h3v-2h-3v-3z"/></svg>
                                                Показать QR для оплаты
                                            </button>
                                            <button type="button" class="child-actions-menu-item" role="menuitem" data-action="profile">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                                Редактировать профиль клиента
                                            </button>
                                </div>
                        </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="childrenFilterEmptyState" class="empty-state-inline" style="display: none;">
                    <div class="empty-state-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
                                    </svg>
                    </div>
                    <p class="empty-state-title">Ничего не найдено</p>
                    <p class="empty-state-desc">Попробуйте изменить параметры поиска или фильтры.</p>
                </div>
        }
        else
        {
                <div class="empty-state-inline" id="childrenEmptyState">
                <div class="empty-state-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
