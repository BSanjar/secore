@using System.Linq
@{
    var groups = ViewBag.OrgClientGroups as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var clients = ViewBag.OrganizationClients as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var orgServices = ViewBag.OrganizationServices as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var disableInvoiceServiceSelection = ViewBag.DisableInvoiceServiceSelection as bool? ?? false;
    var useDetsadInvoiceComposer = ViewBag.UseDetsadInvoiceComposer as bool? ?? false;
    var allowedHassameaccount = ViewBag.AllowedHassameaccount as bool? ?? false;
    var invoicePayCodeMode = ViewBag.InvoicePayCodeMode as string ?? (allowedHassameaccount ? "both" : "new_only");
}
<link rel="stylesheet" href="~/web/kindergarten/css/detsad-create-invoice.css" asp-append-version="true" />

<div class="create-invoice-wrap @(useDetsadInvoiceComposer ? "create-invoice-wrap--detsad" : "")" data-disable-invoice-service-selection="@(disableInvoiceServiceSelection ? "true" : "false")" data-use-detsad-composer="@(useDetsadInvoiceComposer ? "true" : "false")" data-allowed-hassame-account="@(allowedHassameaccount ? "true" : "false")" data-invoice-pay-code-mode="@invoicePayCodeMode">
    <!-- Шаг 1: Выбор получателей -->
    <div class="create-invoice-step" id="createInvoiceStep1">
        <div class="row g-0 create-invoice-step1-row">
            <div class="col-md-6 step1-left-col">
                <div class="card h-100">
                    <div class="card-header py-2"><strong>Шаг 1. Выберите получателей</strong></div>
                    <div class="card-body py-2">
                        <div class="d-flex gap-2 mb-2">
                            <input type="text" id="invoiceRecipientSearch" class="form-control form-control-sm" placeholder="Поиск..." />
                            <select id="invoiceRecipientSearchType" class="form-select form-select-sm" style="width: auto;">
                                <option value="all">Все</option>
                                <option value="groups">Группы</option>
                                <option value="clients">Клиенты</option>
                            </select>
                        </div>
                        <div class="invoice-tree-wrap" id="invoiceTreeWrap">
                            @foreach (var g in groups)
                            {
                                var groupClients = clients.Where(c => (c.OrgClientGroupId ?? "") == (g.Id ?? "")).ToList();
                                <div class="tree-group" data-group-id="@g.Id" data-group-name="@(g.Name ?? g.Id)">
                                    <div class="tree-group-header">
                                        <span class="tree-toggle" aria-label="Развернуть">▶</span>
                                        <input type="checkbox" class="form-check-input tree-group-check" id="gr_@g.Id" />
                                        <label class="tree-group-name mb-0" for="gr_@g.Id">@(g.Name ?? g.Id)</label>
                                    </div>
                                    <ul class="tree-group-children">
                                        @foreach (var c in groupClients)
                                        {
                                            <li class="tree-client" data-client-id="@c.Id" data-client-name="@(c.ClientName ?? c.Id)">
                                                <input type="checkbox" class="form-check-input tree-client-check" id="cl_@(g.Id)_@c.Id" />
                                                <label class="tree-client-name mb-0" for="cl_@(g.Id)_@c.Id">@(c.ClientName ?? c.Id)</label>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @{
                                var noGroupClients = clients.Where(c => string.IsNullOrEmpty(c.OrgClientGroupId?.ToString())).ToList();
                            }
                            @if (noGroupClients.Any())
                            {
                                <div class="tree-group" data-group-id="" data-group-name="Без группы">
                                    <div class="tree-group-header">
                                        <span class="tree-toggle" aria-label="Развернуть">▶</span>
                                        <input type="checkbox" class="form-check-input tree-group-check" id="gr_nogroup" />
                                        <label class="tree-group-name mb-0" for="gr_nogroup">Без группы</label>
                                    </div>
                                    <ul class="tree-group-children">
                                        @foreach (var c in noGroupClients)
                                        {
                                            <li class="tree-client" data-client-id="@c.Id" data-client-name="@(c.ClientName ?? c.Id)">
                                                <input type="checkbox" class="form-check-input tree-client-check" id="cl_nogroup_@c.Id" />
                                                <label class="tree-client-name mb-0" for="cl_nogroup_@c.Id">@(c.ClientName ?? c.Id)</label>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 step1-right-col">
                <div class="card h-100">
                    <div class="card-header py-2"><strong>Выбранные клиенты</strong></div>
                    <div class="card-body py-2">
                        <div class="selected-clients-list" id="selectedClientsList">
                            <p class="text-muted small mb-0">Выберите клиентов в дереве слева.</p>
                        </div>
                        <div class="mt-3">
                            <button type="button" class="btn btn-primary w-100" id="invoiceStep1Next">Далее</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="create-invoice-step d-none" id="createInvoiceStep2">
        <div class="row g-0">
            <div class="col-lg-6 create-invoice-form-col">
                <div class="p-3">
                    <div class="d-flex justify-content-end align-items-center mb-3 create-invoice-step2-head @(!useDetsadInvoiceComposer ? "" : "d-none")">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="invoiceStep2Back">Назад</button>
                    </div>

                    <div class="card mb-3 create-invoice-form-card">
                        @if (!useDetsadInvoiceComposer)
                        {
                            <div class="card-header py-2"><strong>Детали счёта</strong></div>
                        }
                        <div class="card-body py-2">
                            @if (useDetsadInvoiceComposer)
                            {
                                @await Html.PartialAsync("~/Views/Clients/_DetsadInvoiceComposer.cshtml")
                                <input type="hidden" id="invoiceName" value="" />
                                <input type="hidden" id="invoicePeriodicity" value="monthly" />
                                <input type="checkbox" id="invoiceAutoProlongation" checked class="d-none" aria-hidden="true" />
                                <input type="checkbox" id="invoiceUseCurrentDateTime" checked class="d-none" aria-hidden="true" />
                                <input type="hidden" id="invoiceDateStart" value="" />
                                <input type="hidden" id="invoiceDateEnd" value="" />
                                <input type="hidden" id="invoicePayCode" value="" />
                            }
                            else
                            {
                            <div class="mb-2">
                                <label class="form-label small">Название счёта</label>
                                <input type="text" id="invoiceName" class="form-control form-control-sm" placeholder="Например: Оплата за месяц" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    @if (invoicePayCodeMode == "new_only")
                                    {
                                        <label class="form-label small">Номер счёта (14 цифр)</label>
                                        <input type="text" id="invoicePayCode" class="form-control form-control-sm" readonly placeholder="Загрузка..." />
                                    }
                                    else if (invoicePayCodeMode == "duplicate_only")
                                    {
                                        <label class="form-label small">Лицевой счёт</label>
                                        <select id="invoicePayCodeSelect" class="form-select form-select-sm mb-1" data-allow-new="false">
                                            <option value="">Загрузка...</option>
                                        </select>
                                        <input type="text" id="invoicePayCode" class="form-control form-control-sm" readonly placeholder="—" />
                                    }
                                    else
                                    {
                                        <label class="form-label small">Лицевой счёт</label>
                                        <select id="invoicePayCodeSelect" class="form-select form-select-sm mb-1" data-allow-new="true">
                                            <option value="">Загрузка...</option>
                                        </select>
                                        <input type="text" id="invoicePayCode" class="form-control form-control-sm" readonly placeholder="—" />
                                    }
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Периодичность</label>
                                    <select id="invoicePeriodicity" class="form-select form-select-sm">
                                        <option value="daily">Ежедневно</option>
                                        <option value="weekly">Еженедельно</option>
                                        <option value="monthly" selected>Ежемесячно</option>
                                        <option value="yearly">Ежегодно</option>
                                        <option value="oneTime">Разовая</option>
                                        <option value="any">Любая</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-2">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="invoiceAutoProlongation" checked />
                                    <label class="form-check-label small" for="invoiceAutoProlongation">Автопролонгация</label>
                                </div>
                            </div>
                            <div class="mb-2">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="invoiceUseCurrentDateTime" checked />
                                    <label class="form-check-label small" for="invoiceUseCurrentDateTime">Учитывать текущий день и время</label>
                                </div>
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small">Дата и время начала</label>
                                    <input type="datetime-local" id="invoiceDateStart" class="form-control form-control-sm" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Дата и время конца счёта</label>
                                    <input type="datetime-local" id="invoiceDateEnd" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="invoice-date-end-block d-none" id="invoiceDateEndBlock">
                                <label class="form-label small">Быстрый выбор срока</label>
                                <div class="d-flex flex-wrap gap-2 align-items-center mb-1" id="invoiceDateEndShortcuts">
                                    <span class="invoice-shortcuts-group" data-periodicity="monthly">
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="months" data-value="1">1 месяц</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="months" data-value="3">3 месяца</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="months" data-value="6">6 месяцев</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="months" data-value="12">1 год</button>
                                    </span>
                                    <span class="invoice-shortcuts-group d-none" data-periodicity="daily">
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="days" data-value="3">3 дня</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="days" data-value="7">7 дней</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="days" data-value="30">30 дней</button>
                                    </span>
                                    <span class="invoice-shortcuts-group d-none" data-periodicity="weekly">
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="weeks" data-value="1">1 неделя</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="weeks" data-value="4">4 недели</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="weeks" data-value="8">8 недель</button>
                                    </span>
                                    <span class="invoice-shortcuts-group d-none" data-periodicity="yearly">
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="years" data-value="1">1 год</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="years" data-value="2">2 года</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary invoice-date-end-shortcut" data-type="years" data-value="3">3 года</button>
                                    </span>
                                </div>
                            </div>
                            }
                        </div>
                    </div>

                    @if (disableInvoiceServiceSelection && !useDetsadInvoiceComposer)
                    {
                        <div class="card mb-3" id="invoiceManualServiceCard">
                            <div class="card-header py-2"><strong>Услуга по счёту</strong></div>
                            <div class="card-body py-2">
                                <p class="small text-muted mb-2">В качестве наименования услуги используется название счёта. Укажите цену.</p>
                                <div class="mb-2">
                                    <label class="form-label small">Цена, сом</label>
                                    <input type="number" id="invoiceManualPriceSom" class="form-control form-control-sm" min="0" step="0.01" placeholder="0.00" />
                                </div>
                            </div>
                        </div>
                    }

                    <div class="card mb-3 @(disableInvoiceServiceSelection || useDetsadInvoiceComposer ? "d-none" : "")" id="invoiceServicesCard">
                        <div class="card-header py-2"><strong>Услуги</strong></div>
                        <div class="card-body py-2">
                            <p class="small text-muted mb-2">Выберите услуги из списка организации и укажите количество.</p>
                            <div class="mb-2">
                                <input type="text" id="invoiceServicesSearch" class="form-control form-control-sm" placeholder="Поиск по названию услуги..." />
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered mb-0" id="invoiceServicesTable">
                                    <thead>
                                        <tr>
                                            <th style="width:40px"></th>
                                            <th>Название</th>
                                            <th style="width:90px">Цена, сом</th>
                                            <th style="width:70px">Min</th>
                                            <th style="width:70px">Max</th>
                                            <th style="width:100px">Qty</th>
                                        </tr>
                                    </thead>
                                    <tbody id="invoiceServicesBody">
                                        @foreach (var s in orgServices)
                                        {
                                            var priceSom = ParsersHelper.TyiynToSom(s.ServiceSumm ?? 0);
                                            var minSom = (decimal)(s.MinSumm ?? 0) / 100m;
                                            var maxSom = (decimal)(s.MaxSumm ?? 0) / 100m;
                                            var inv = System.Globalization.CultureInfo.InvariantCulture;
                                            <tr class="invoice-service-row" data-service-id="@s.Id" data-name="@(s.Name ?? "")" data-price="@priceSom.ToString("0.00", inv)" data-min="@minSom.ToString("0.00", inv)" data-max="@maxSom.ToString("0.00", inv)">
                                                <td><input type="checkbox" class="form-check-input service-include" /></td>
                                                <td class="service-name">@(s.Name ?? s.Id)</td>
                                                <td class="service-price">@priceSom.ToString("N2")</td>
                                                <td class="service-min">@minSom.ToString("N2")</td>
                                                <td class="service-max">@maxSom.ToString("N2")</td>
                                                <td class="service-qty-cell"><input type="number" min="1" class="form-control form-control-sm service-qty" value="1" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (!orgServices.Any())
                            {
                                <p class="text-muted small mb-0">Нет услуг. Добавьте услуги в настройках организации.</p>
                            }
                        </div>
                    </div>

                    @if (!useDetsadInvoiceComposer)
                    {
                    <div class="card mb-3">
                        <div class="card-header py-2 d-flex align-items-center justify-content-between">
                            <strong>QR-код</strong>
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon-only" id="invoiceGenerateQr" title="Сгенерировать QR">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="4" height="4"/><rect x="17" y="14" width="4" height="4"/><path d="M10 14h4"/><path d="M14 17v-6"/><path d="M10 17h4"/></svg>
                            </button>
                        </div>
                        <div class="card-body py-2">
                            <div id="invoiceQrContainer" class="invoice-qr-container"></div>
                        </div>
                    </div>
                    }

                    @if (!useDetsadInvoiceComposer)
                    {
                    <button type="button" class="btn btn-success w-100 create-invoice-submit-btn" id="invoiceCreateBtn">Создать счёт на оплату</button>
                    }
                </div>
            </div>

            <div class="col-lg-6 create-invoice-preview-col">
                <div class="p-3">
                    <div class="card create-invoice-preview-card @(useDetsadInvoiceComposer ? "create-invoice-preview-card--detsad" : "")" id="invoicePreviewCard">
                        <div class="card-body">
                            <div class="preview-header text-center border-bottom pb-2 mb-2">
                                <div class="preview-service-name">SECORE</div>
                                <div class="preview-invoice-number text-muted small" id="previewInvoiceNumber">—</div>
                            </div>
                            <div class="preview-details small mb-2">
                                <div><strong>Название:</strong> <span id="previewName">—</span></div>
                                <div class="@(useDetsadInvoiceComposer ? "d-none" : "")"><strong>Дата начала:</strong> <span id="previewDateStart">—</span></div>
                                <div><strong>Периодичность:</strong> <span id="previewPeriodicity">—</span></div>
                                <div id="previewDateEndRow" class="d-none"><strong>Дата конца:</strong> <span id="previewDateEnd">—</span></div>
                            </div>
                            <div class="table-responsive @(useDetsadInvoiceComposer ? "d-none" : "")" id="previewLinesWrap">
                                <table class="table table-sm preview-table">
                                    <thead>
                                        <tr><th>Наименование</th><th>Цена</th><th>Кол-во</th><th>Сумма</th></tr>
                                    </thead>
                                    <tbody id="previewLinesBody">
                                        <tr><td colspan="4" class="text-muted text-center">Нет позиций</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="preview-total border-top pt-2 mt-2">
                                <strong>Итого: <span id="previewTotal">0</span> сом</strong>
                            </div>
                            @if (useDetsadInvoiceComposer)
                            {
                                <div class="ds-inv-preview-dates" id="invoicePreviewDatesDetsad">
                                    <p class="ds-inv-preview-next-pay mb-0" id="previewNextPaymentLine">—</p>
                                </div>
                            }
                            <div class="preview-executor text-muted small mt-2 pt-2 border-top @(useDetsadInvoiceComposer ? "d-none" : "")">
                                Исполнитель: <span id="previewExecutor">—</span>
                            </div>
                        </div>
                    </div>
                    <div class="card mt-3 create-invoice-preview-payments-card @(useDetsadInvoiceComposer ? "d-none" : "")" id="invoicePreviewPaymentsCard">
                        <div class="card-header py-2"><strong>Предварительные оплаты</strong></div>
                        <div class="card-body py-2">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered mb-0">
                                    <thead>
                                        <tr><th>№</th><th>Дата начала</th><th>Дата конца</th><th>Сумма</th></tr>
                                    </thead>
                                    <tbody id="previewPaymentsBody">
                                        <tr><td colspan="4" class="text-muted text-center small">Укажите даты и услуги</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (useDetsadInvoiceComposer)
        {
            <div class="create-invoice-submit-bar" role="region" aria-label="Действия">
                <button type="button" class="btn btn-outline-secondary create-invoice-submit-bar__back" id="invoiceStep2BackDetsad">Назад</button>
                <button type="button" class="btn ds-create-invoice-cta" id="invoiceCreateBtn">Создать счёт на оплату</button>
            </div>
        }
    </div>
</div>
