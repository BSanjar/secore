@model List<WebApplication1.Models.DBModels.Invoice>
@using System.Linq
@{
    ViewData["Title"] = "Отчетность";
    var search = ViewBag.Search as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "";
    var clientId = ViewBag.ClientId as string ?? "";
    var selectedClientName = ViewBag.SelectedClientName as string ?? "";
    var periodicity = ViewBag.Periodicity as string ?? "";
    var dateCreatedFrom = ViewBag.DateCreatedFrom as string ?? "";
    var dateCreatedTo = ViewBag.DateCreatedTo as string ?? "";
    var hidePeriodicityFilter = ViewBag.HidePeriodicityFilter as bool? ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
}

<div class="children-page">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="page-title">Отчетность</h1>
                <p class="page-subtitle mb-0">Отчетность по счетам на оплату организации. Создание счёта — на странице «Дети».</p>
            </div>
            <div class="d-flex align-items-center gap-2">
              
                <a href="@Url.Action("ExportExcel", "Invoices", new { search, statusFilter, clientId, periodicity, dateCreatedFrom, dateCreatedTo })" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM8 15.01l1.41 1.41L11 14.84V19h2v-4.16l1.59 1.59L16 15.01 12.01 11 8 15.01z" fill="currentColor"/></svg>
                    Выгрузить в Excel
                </a>
            </div>
        </div>
    </div>

    <div class="filters-section">
        <div class="row g-2 mb-2">
            <div class="col-12 col-md-7">
                <label class="form-label small text-muted mb-1">Поиск</label>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="search-box flex-grow-1" style="min-width: 160px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="search-icon">
                            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"/>
                        </svg>
                        <input type="text" class="form-control search-input" id="invoicesSearchInput" placeholder="Введите текст..." value="@search">
                    </div>
                    <select id="invoicesSearchType" class="form-select filter-select" style="width: auto; min-width: 160px;">
                        <option value="name" selected>По названию</option>
                        <option value="paycode">По лицевому счёту</option>
                    </select>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Статус</label>
                <select id="invoicesStatusFilter" class="form-select filter-select">
                    <option value="">Все статусы</option>
                    @if (statusFilter == "actual")
                    {
                        <option value="actual" selected>Активный</option>
                    }
                    else
                    {
                        <option value="actual">Активный</option>
                    }
                    @if (statusFilter == "suspended")
                    {
                        <option value="suspended" selected>Приостановлен</option>
                    }
                    else
                    {
                        <option value="suspended">Приостановлен</option>
                    }
                    @if (statusFilter == "closed")
                    {
                        <option value="closed" selected>Закрыт</option>
                    }
                    else
                    {
                        <option value="closed">Закрыт</option>
                    }
                </select>
            </div>
        </div>
        <div class="row g-2 mb-0 invoices-filters-row-2">
            @if (!hidePeriodicityFilter)
            {
            <div class="col invoices-filter-col">
                <label class="form-label small text-muted mb-1">Периодичность</label>
                <select id="invoicesPeriodicityFilter" class="form-select filter-select w-100">
                    <option value="">Все</option>
                    @if (periodicity == "daily") { <option value="daily" selected>Ежедневно</option> } else { <option value="daily">Ежедневно</option> }
                    @if (periodicity == "weekly") { <option value="weekly" selected>Еженедельно</option> } else { <option value="weekly">Еженедельно</option> }
                    @if (periodicity == "monthly") { <option value="monthly" selected>Ежемесячно</option> } else { <option value="monthly">Ежемесячно</option> }
                    @if (periodicity == "yearly") { <option value="yearly" selected>Ежегодно</option> } else { <option value="yearly">Ежегодно</option> }
                    @if (periodicity == "oneTime") { <option value="oneTime" selected>Разовая</option> } else { <option value="oneTime">Разовая</option> }
                    @if (periodicity == "any") { <option value="any" selected>Любая</option> } else { <option value="any">Любая</option> }
                </select>
            </div>
            }
            <div class="col invoices-filter-col">
                <label class="form-label small text-muted mb-1">Дата создания (от)</label>
                <input type="date" id="invoicesDateFrom" class="form-control filter-select w-100" value="@dateCreatedFrom">
            </div>
            <div class="col invoices-filter-col">
                <label class="form-label small text-muted mb-1">Дата создания (до)</label>
                <input type="date" id="invoicesDateTo" class="form-control filter-select w-100" value="@dateCreatedTo">
            </div>
            <div class="col invoices-filter-col flex-grow-1">
                <label class="form-label small text-muted mb-1">Клиент</label>
                <div class="invoices-client-dropdown">
                    <input type="hidden" id="invoicesClientFilter" value="@clientId">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 text-start invoices-client-btn" id="invoicesClientBtn" aria-expanded="false">
                        <span class="invoices-client-btn-text">@(string.IsNullOrEmpty(selectedClientName) ? "Все клиенты" : selectedClientName)</span>
                        <svg class="ms-1 float-end" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7 10l5 5 5-5H7z" fill="currentColor"/>
                        </svg>
                    </button>
                    <div class="invoices-client-menu" id="invoicesClientMenu" aria-hidden="true">
                        <div class="p-2 border-bottom">
                            <input type="text" class="form-control form-control-sm invoices-client-search" id="invoicesClientSearch" placeholder="Поиск клиента..." autocomplete="off">
                        </div>
                        <div class="invoices-client-list" id="invoicesClientList">
                            <div class="invoices-client-item" data-client-id="" data-client-name="Все клиенты">Все клиенты</div>
                            @if (ViewBag.Clients != null)
                            {
                                @foreach (var c in ViewBag.Clients)
                                {
                                    <div class="invoices-client-item" data-client-id="@c.Id" data-client-name="@(c.ClientName ?? c.Id)">@(c.ClientName ?? c.Id)</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="filters-section">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Название счета</th>
                            <th>Клиент</th>
                            <th>Статус</th>
                            <th>Периодичность</th>
                            <th>Баланс</th>
                            <th>Дата создания</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="invoicesTableBody">
                        @foreach (var inv in Model)
                        {
                            var statusText = inv.InvoiceStatus == "actual" ? "Активный" : inv.InvoiceStatus == "suspended" ? "Приостановлен" : inv.InvoiceStatus == "closed" ? "Закрыт" : inv.InvoiceStatus ?? "—";
                            var statusClass = inv.InvoiceStatus == "actual" ? "badge bg-success" : inv.InvoiceStatus == "suspended" ? "badge bg-warning text-dark" : inv.InvoiceStatus == "closed" ? "badge bg-secondary" : "badge bg-light text-dark";
                            if (inv.Periodicity == "oneTime")
                            {
                                var hasSuccessfulTransaction = inv.Transactions != null && inv.Transactions.Any(t => t.TransactionStatus == "success");
                                statusText = hasSuccessfulTransaction ? "Активный-Оплачен" : "Не оплачено";
                                statusClass = hasSuccessfulTransaction ? "badge bg-success" : "badge bg-danger";
                            }
                            var balanceSoms = inv.Balance.HasValue ? inv.Balance.Value / 100m : 0m;
                            <tr class="invoice-row" data-search-name="@(inv.NameInvoice ?? "")" data-search-paycode="@(inv.PayCode ?? "")">
                                <td>
                                    <strong>@(inv.NameInvoice ?? "Без названия")</strong>
                                    @if (!string.IsNullOrEmpty(inv.PayCode))
                                    {
                                        <br /><span class="text-muted small">@inv.PayCode</span>
                                    }
                                </td>
                                <td>@(inv.ClientNavigation?.ClientName ?? inv.Client ?? "—")</td>
                                <td><span class="@statusClass">@statusText</span></td>
                                <td>@(inv.Periodicity == "monthly" ? "Ежемесячно" : inv.Periodicity == "yearly" ? "Ежегодно" : inv.Periodicity == "weekly" ? "Еженедельно" : inv.Periodicity == "daily" ? "Ежедневно" : inv.Periodicity == "oneTime" ? "Разовая" : inv.Periodicity ?? "—")</td>
                                <td class="@(balanceSoms < 0 ? "text-danger" : "")">@balanceSoms.ToString("N2") сом</td>
                                <td>@(inv.DateCreated?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@inv.Id" asp-route-returnUrl="@ViewBag.ReturnUrl" class="action-btn action-btn--view" title="Просмотр">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="currentColor"/></svg>
                                            Просмотр
                                        </a>
                                        <a asp-action="DownloadStatementPdf" asp-route-id="@inv.Id" class="action-btn action-btn--view" title="Скачать выписку" download>
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" fill="currentColor"/></svg>
                                            Выписка
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mt-2">Всего счетов: @Model.Count</p>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" fill="currentColor"/>
                    </svg>
                </div>
                <h3 class="empty-state-title">Счетов пока нет</h3>
                <p class="empty-state-description">Счета создаются на странице «Дети» при выборе ребёнка и действия «Счёт на оплату». Отчетность отображает созданные счета.</p>
                    <a href="@Url.Action("Index", "Clients")" class="action-btn action-btn--add mt-3" title="Перейти к списку детей">
                    Перейти к списку детей
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var hidePeriodicityFilter = @(hidePeriodicityFilter ? "true" : "false");
            var searchInput = document.getElementById('invoicesSearchInput');
            var searchType = document.getElementById('invoicesSearchType');
            var statusFilter = document.getElementById('invoicesStatusFilter');
            var clientFilterInput = document.getElementById('invoicesClientFilter');
            var clientBtn = document.getElementById('invoicesClientBtn');
            var clientBtnText = document.querySelector('.invoices-client-btn-text');
            var clientMenu = document.getElementById('invoicesClientMenu');
            var clientSearch = document.getElementById('invoicesClientSearch');
            var clientList = document.getElementById('invoicesClientList');
            var periodicityFilter = document.getElementById('invoicesPeriodicityFilter');
            var dateFrom = document.getElementById('invoicesDateFrom');
            var dateTo = document.getElementById('invoicesDateTo');
            var tbody = document.getElementById('invoicesTableBody');

            function applySearchLocal() {
                if (!searchInput || !tbody) return;
                var term = searchInput.value.toLowerCase().trim();
                var byName = !searchType || searchType.value === 'name';
                var attr = byName ? 'data-search-name' : 'data-search-paycode';
                var rows = tbody.querySelectorAll('tr.invoice-row');
                rows.forEach(function (tr) {
                    var text = (tr.getAttribute(attr) || '').toLowerCase();
                    tr.style.display = !term || text.indexOf(term) !== -1 ? '' : 'none';
                });
            }

            function applyFiltersRedirect() {
                var params = new URLSearchParams(window.location.search);
                if (searchInput) params.set('search', searchInput.value.trim());
                if (statusFilter) params.set('statusFilter', statusFilter.value);
                if (clientFilterInput) params.set('clientId', clientFilterInput.value || '');
                if (hidePeriodicityFilter) {
                    params.set('periodicity', 'monthly');
                } else if (periodicityFilter) {
                    params.set('periodicity', periodicityFilter.value);
                }
                if (dateFrom && dateFrom.value) params.set('dateCreatedFrom', dateFrom.value);
                else params.delete('dateCreatedFrom');
                if (dateTo && dateTo.value) params.set('dateCreatedTo', dateTo.value);
                else params.delete('dateCreatedTo');
                window.location.search = params.toString();
            }

            if (searchInput) {
                var searchTimeout;
                searchInput.addEventListener('input', function () {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(applySearchLocal, 300);
                });
            }
            if (searchType) searchType.addEventListener('change', applySearchLocal);
            if (statusFilter) statusFilter.addEventListener('change', applyFiltersRedirect);
            if (periodicityFilter) periodicityFilter.addEventListener('change', applyFiltersRedirect);
            if (dateFrom) dateFrom.addEventListener('change', applyFiltersRedirect);
            if (dateTo) dateTo.addEventListener('change', applyFiltersRedirect);

            if (clientBtn && clientMenu) {
                clientBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = clientMenu.classList.toggle('is-open');
                    clientBtn.setAttribute('aria-expanded', isOpen);
                    if (isOpen && clientSearch) {
                        clientSearch.value = '';
                        var items = clientList.querySelectorAll('.invoices-client-item');
                        items.forEach(function (el) { el.classList.remove('is-hidden'); });
                        setTimeout(function () { clientSearch.focus(); }, 50);
                    }
                });
                document.addEventListener('click', function () {
                    clientMenu.classList.remove('is-open');
                    clientBtn.setAttribute('aria-expanded', 'false');
                });
                clientMenu.addEventListener('click', function (e) { e.stopPropagation(); });
            }
            if (clientSearch && clientList) {
                clientSearch.addEventListener('input', function () {
                    var term = this.value.toLowerCase().trim();
                    clientList.querySelectorAll('.invoices-client-item').forEach(function (item) {
                        var name = (item.getAttribute('data-client-name') || '').toLowerCase();
                        item.classList.toggle('is-hidden', term && name.indexOf(term) === -1);
                    });
                });
            }
            if (clientList) {
                clientList.querySelectorAll('.invoices-client-item').forEach(function (item) {
                    item.addEventListener('click', function () {
                        var id = this.getAttribute('data-client-id') || '';
                        var name = this.getAttribute('data-client-name') || 'Все клиенты';
                        if (clientFilterInput) clientFilterInput.value = id;
                        if (clientBtnText) clientBtnText.textContent = id ? name : 'Все клиенты';
                        if (clientMenu) clientMenu.classList.remove('is-open');
                        if (clientBtn) clientBtn.setAttribute('aria-expanded', 'false');
                        applyFiltersRedirect();
                    });
                });
            }

            applySearchLocal();
        });
    </script>
}

