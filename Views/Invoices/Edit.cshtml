@model WebApplication1.Models.DBModels.Invoice
@using System.Globalization
@{
    ViewData["Title"] = "Редактировать счёт";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index");
    var orgServices = ViewBag.OrganizationServices as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var disableInvoiceServiceSelection = ViewBag.DisableInvoiceServiceSelection as bool? ?? false;
    var allowedHassameaccount = ViewBag.AllowedHassameaccount as bool? ?? false;
    var inv = CultureInfo.InvariantCulture;
    var dateStartStr = Model.DateStartInvoice.HasValue ? Model.DateStartInvoice.Value.ToString("yyyy-MM-ddTHH:mm", inv) : "";
    var dateEndStr = Model.DateEndInvoice.HasValue ? Model.DateEndInvoice.Value.ToString("yyyy-MM-ddTHH:mm", inv) : "";
    var manualPriceSom = 0m;
    if (disableInvoiceServiceSelection && Model.InvoiceServices != null)
    {
        var manualRow = Model.InvoiceServices.FirstOrDefault(s => string.IsNullOrEmpty(s.Service));
        if (manualRow != null && manualRow.ServiceSumm.HasValue)
            manualPriceSom = (decimal)manualRow.ServiceSumm.Value / 100m;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-create-invoice.css" asp-append-version="true" />
}

<div class="children-page">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a href="@returnUrl">Отчетность</a>
        <span class="breadcrumb-sep">›</span>
        <span>Редактирование счёта</span>
    </nav>

    <div class="page-header mb-3">
        <h1 class="page-title">Редактировать счёт</h1>
        <p class="page-subtitle mb-0">@(Model.NameInvoice ?? Model.PayCode ?? Model.Id)</p>
    </div>

    <form asp-action="Edit" method="post" id="editInvoiceForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="NextStartInvoice" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <input type="hidden" name="serviceItemsJson" id="editInvoiceServiceItemsJson" value="" />
        <input type="hidden" name="manualServicePriceSom" id="editInvoiceManualPriceSomHidden" value="" />
        <input type="hidden" name="useExistingPayCode" id="editInvoiceUseExistingPayCode" value="@(Model.Hassameaccount ? "true" : "false")" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="create-invoice-wrap" data-disable-invoice-service-selection="@(disableInvoiceServiceSelection ? "true" : "false")" data-allowed-hassame-account="@(allowedHassameaccount ? "true" : "false")">
            <div class="create-invoice-step" id="editInvoiceStep2">
                <div class="row g-0">
                    <div class="col-lg-6 create-invoice-form-col">
                        <div class="p-3">
                            <strong class="d-block mb-3">Редактирование счёта</strong>

                            <!-- Детали счёта -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><strong>Детали счёта</strong></div>
                                <div class="card-body py-2">
                                    <div class="mb-2">
                                        <label class="form-label small">Клиент <span class="text-danger">*</span></label>
                                        <select asp-for="Client" asp-items="ViewBag.Clients" class="form-select form-select-sm" required>
                                            <option value="">— Выберите клиента —</option>
                                        </select>
                                        <span asp-validation-for="Client" class="text-danger"></span>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">Название счёта</label>
                                        <input asp-for="NameInvoice" class="form-control form-control-sm" placeholder="Например: Оплата за месяц" id="editInvoiceName" />
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            @if (allowedHassameaccount)
                                            {
                                                <label class="form-label small">Лицевой счёт</label>
                                                <select id="editInvoicePayCodeSelect" class="form-select form-select-sm mb-1">
                                                    <option value="">Загрузка...</option>
                                                </select>
                                                <input asp-for="PayCode" type="text" class="form-control form-control-sm" readonly id="editInvoicePayCode" placeholder="—" />
                                            }
                                            else
                                            {
                                                <label class="form-label small">Номер счёта (14 цифр)</label>
                                                <input asp-for="PayCode" type="text" class="form-control form-control-sm" id="editInvoicePayCode" readonly />
                                            }
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Периодичность</label>
                                            <select asp-for="Periodicity" class="form-select form-select-sm" id="editInvoicePeriodicity">
                                                <option value="daily">Ежедневно</option>
                                                <option value="weekly">Еженедельно</option>
                                                <option value="monthly">Ежемесячно</option>
                                                <option value="yearly">Ежегодно</option>
                                                <option value="oneTime">Разовая</option>
                                                <option value="any">Любая</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="form-label small">Статус</label>
                                            <select asp-for="InvoiceStatus" class="form-select form-select-sm">
                                                <option value="actual">Активный</option>
                                                <option value="suspended">Приостановлен</option>
                                                <option value="closed">Закрыт</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <div class="form-check">
                                            <input asp-for="AutoProlongation" class="form-check-input" id="editInvoiceAutoProlongation" />
                                            <label class="form-check-label small" for="editInvoiceAutoProlongation">Автопролонгация</label>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="editInvoiceUseCurrentDateTime" checked />
                                            <label class="form-check-label small" for="editInvoiceUseCurrentDateTime">Учитывать текущий день и время</label>
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <label class="form-label small">Дата и время начала</label>
                                            <input asp-for="DateStartInvoice" type="datetime-local" class="form-control form-control-sm" id="editInvoiceDateStart" value="@dateStartStr" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Дата и время конца счёта</label>
                                            <input asp-for="DateEndInvoice" type="datetime-local" class="form-control form-control-sm" id="editInvoiceDateEnd" value="@dateEndStr" />
                                        </div>
                                    </div>
                                    <div class="invoice-date-end-block @(Model.AutoProlongation == true ? "d-none" : "")" id="editInvoiceDateEndBlock">
                                        <label class="form-label small">Быстрый выбор срока</label>
                                        <div class="d-flex flex-wrap gap-2 align-items-center mb-1" id="editInvoiceDateEndShortcuts">
                                            <span class="invoice-shortcuts-group" data-periodicity="monthly">
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="months" data-value="1">1 месяц</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="months" data-value="3">3 месяца</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="months" data-value="6">6 месяцев</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="months" data-value="12">1 год</button>
                                            </span>
                                            <span class="invoice-shortcuts-group d-none" data-periodicity="daily">
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="days" data-value="3">3 дня</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="days" data-value="7">7 дней</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="days" data-value="30">30 дней</button>
                                            </span>
                                            <span class="invoice-shortcuts-group d-none" data-periodicity="weekly">
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="weeks" data-value="1">1 неделя</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="weeks" data-value="4">4 недели</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="weeks" data-value="8">8 недель</button>
                                            </span>
                                            <span class="invoice-shortcuts-group d-none" data-periodicity="yearly">
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="years" data-value="1">1 год</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="years" data-value="2">2 года</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary edit-invoice-date-end-shortcut" data-type="years" data-value="3">3 года</button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (disableInvoiceServiceSelection)
                            {
                                <div class="card mb-3" id="editInvoiceManualServiceCard">
                                    <div class="card-header py-2"><strong>Услуга по счёту</strong></div>
                                    <div class="card-body py-2">
                                        <p class="small text-muted mb-2">В качестве наименования услуги используется название счёта. Укажите цену.</p>
                                        <div class="mb-2">
                                            <label class="form-label small">Цена, сом</label>
                                            <input type="number" id="editInvoiceManualPriceSom" class="form-control form-control-sm" min="0" step="0.01" placeholder="0.00" value="@manualPriceSom.ToString("0.00", inv)" />
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="card mb-3 @(disableInvoiceServiceSelection ? "d-none" : "")" id="editInvoiceServicesCard">
                                <div class="card-header py-2"><strong>Услуги</strong></div>
                                <div class="card-body py-2">
                                    <p class="small text-muted mb-2">Выберите услуги из списка организации и укажите количество.</p>
                                    <div class="mb-2">
                                        <input type="text" id="editInvoiceServicesSearch" class="form-control form-control-sm" placeholder="Поиск по названию услуги..." />
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-0" id="editInvoiceServicesTable">
                                            <thead>
                                                <tr>
                                                    <th style="width:40px"></th>
                                                    <th>Название</th>
                                                    <th style="width:90px">Цена, сом</th>
                                                    <th style="width:70px">Min</th>
                                                    <th style="width:70px">Max</th>
                                                    <th style="width:100px">Qty</th>
                                                </tr>
                                            </thead>
                                            <tbody id="editInvoiceServicesBody">
                                                @{
                                                    var invoiceServicesList = Model.InvoiceServices?.ToList() ?? new List<WebApplication1.Models.DBModels.InvoiceService>();
                                                }
                                                @foreach (var s in orgServices)
                                                {
                                                    var priceSom = (decimal)(s.ServiceSumm ?? 0) / 100m;
                                                    var minSom = (decimal)(s.MinSumm ?? 0) / 100m;
                                                    var maxSom = (decimal)(s.MaxSumm ?? 0) / 100m;
                                                    var existing = invoiceServicesList.FirstOrDefault(isv => isv.Service == (string)s.Id);
                                                    var isChecked = existing != null;
                                                    var qty = 1;
                                                    if (existing != null && existing.ServiceSumm.HasValue && (s.ServiceSumm ?? 0) > 0)
                                                    {
                                                        var num = (decimal)(existing.ServiceSumm ?? 0);
                                                        var denom = (decimal)(s.ServiceSumm ?? 0);
                                                        qty = (int)Math.Max(1, Math.Round(num / denom));
                                                    }
                                                    <tr class="invoice-service-row edit-invoice-service-row" data-service-id="@s.Id" data-name="@(s.Name ?? "")" data-price="@priceSom.ToString("0.00", inv)" data-min="@minSom.ToString("0.00", inv)" data-max="@maxSom.ToString("0.00", inv)">
                                                        <td><input type="checkbox" class="form-check-input service-include" @(isChecked ? "checked" : "") /></td>
                                                        <td class="service-name">@(s.Name ?? s.Id)</td>
                                                        <td class="service-price">@priceSom.ToString("N2")</td>
                                                        <td class="service-min">@minSom.ToString("N2")</td>
                                                        <td class="service-max">@maxSom.ToString("N2")</td>
                                                        <td class="service-qty-cell"><input type="number" min="1" class="form-control form-control-sm service-qty" value="@qty" /></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @if (!orgServices.Any())
                                    {
                                        <p class="text-muted small mb-0">Нет услуг. Добавьте услуги в настройках организации.</p>
                                    }
                                </div>
                            </div>

                            <!-- QR -->
                            <div class="card mb-3">
                                <div class="card-header py-2 d-flex align-items-center justify-content-between">
                                    <strong>QR-код</strong>
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon-only" id="editInvoiceGenerateQr" title="Сгенерировать QR">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="4" height="4"/><rect x="17" y="14" width="4" height="4"/><path d="M10 14h4"/><path d="M14 17v-6"/><path d="M10 17h4"/></svg>
                                    </button>
                                </div>
                                <div class="card-body py-2">
                                    <div id="editInvoiceQrContainer" class="invoice-qr-container"></div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100" id="editInvoiceSaveBtn">Сохранить</button>
                        </div>
                    </div>

                    <!-- Правая колонка — предпросмотр -->
                    <div class="col-lg-6 create-invoice-preview-col">
                        <div class="p-3">
                            <div class="card create-invoice-preview-card" id="editInvoicePreviewCard">
                                <div class="card-body">
                                    <div class="preview-header text-center border-bottom pb-2 mb-2">
                                        <div class="preview-service-name">SECORE</div>
                                        <div class="preview-invoice-number text-muted small" id="editPreviewInvoiceNumber">@(Model.PayCode ?? "—")</div>
                                    </div>
                                    <div class="preview-details small mb-2">
                                        <div><strong>Название:</strong> <span id="editPreviewName">@(Model.NameInvoice ?? "—")</span></div>
                                        <div><strong>Дата начала:</strong> <span id="editPreviewDateStart">@(dateStartStr != "" ? Model.DateStartInvoice?.ToString("dd.MM.yyyy HH:mm", inv) : "—")</span></div>
                                        <div><strong>Периодичность:</strong> <span id="editPreviewPeriodicity">@(Model.Periodicity ?? "—")</span></div>
                                        <div id="editPreviewDateEndRow" class="@(string.IsNullOrEmpty(dateEndStr) ? "d-none" : "")"><strong>Дата конца:</strong> <span id="editPreviewDateEnd">@(dateEndStr != "" ? Model.DateEndInvoice?.ToString("dd.MM.yyyy HH:mm", inv) : "—")</span></div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-sm preview-table">
                                            <thead>
                                                <tr><th>Наименование</th><th>Цена</th><th>Кол-во</th><th>Сумма</th></tr>
                                            </thead>
                                            <tbody id="editPreviewLinesBody">
                                                <tr><td colspan="4" class="text-muted text-center">Нет позиций</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="preview-total border-top pt-2 mt-2">
                                        <strong>Итого: <span id="editPreviewTotal">0</span> сом</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
(function() {
    var form = document.getElementById('editInvoiceForm');
    var dateStartEl = document.getElementById('editInvoiceDateStart');
    var dateEndEl = document.getElementById('editInvoiceDateEnd');
    var periodicityEl = document.getElementById('editInvoicePeriodicity');
    var autoProlongationEl = document.getElementById('editInvoiceAutoProlongation');
    var dateEndBlock = document.getElementById('editInvoiceDateEndBlock');
    var serviceItemsJsonEl = document.getElementById('editInvoiceServiceItemsJson');
    var useExistingPayCodeEl = document.getElementById('editInvoiceUseExistingPayCode');
    var disableServiceSelection = form && form.closest('.create-invoice-wrap') && form.closest('.create-invoice-wrap').getAttribute('data-disable-invoice-service-selection') === 'true';
    var allowedHassame = form && form.closest('.create-invoice-wrap') && form.closest('.create-invoice-wrap').getAttribute('data-allowed-hassame-account') === 'true';

    function toDateTimeLocalString(d) {
        var y = d.getFullYear(), m = ('0' + (d.getMonth() + 1)).slice(-2), day = ('0' + d.getDate()).slice(-2);
        var h = ('0' + d.getHours()).slice(-2), min = ('0' + d.getMinutes()).slice(-2);
        return y + '-' + m + '-' + day + 'T' + h + ':' + min;
    }

    if (autoProlongationEl && dateEndBlock) {
        autoProlongationEl.addEventListener('change', function() {
            dateEndBlock.classList.toggle('d-none', !!this.checked);
        });
    }

    function updateShortcutsVisibility() {
        if (!periodicityEl || !dateEndBlock) return;
        dateEndBlock.querySelectorAll('.invoice-shortcuts-group').forEach(function(gr) {
            gr.classList.toggle('d-none', gr.getAttribute('data-periodicity') !== periodicityEl.value);
        });
    }
    updateShortcutsVisibility();
    periodicityEl && periodicityEl.addEventListener('change', updateShortcutsVisibility);

    dateEndBlock && dateEndBlock.querySelectorAll('.edit-invoice-date-end-shortcut').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!dateStartEl || !dateEndEl) return;
            var startVal = dateStartEl.value;
            if (!startVal) return;
            var type = btn.getAttribute('data-type') || 'months';
            var val = parseInt(btn.getAttribute('data-value'), 10) || 1;
            var d = new Date(startVal.indexOf('T') !== -1 ? startVal : startVal + 'T12:00:00');
            if (type === 'days') d.setDate(d.getDate() + val);
            else if (type === 'weeks') d.setDate(d.getDate() + val * 7);
            else if (type === 'months') d.setMonth(d.getMonth() + val);
            else if (type === 'years') d.setFullYear(d.getFullYear() + val);
            dateEndEl.value = toDateTimeLocalString(d);
        });
    });

    if (form) {
        form.addEventListener('submit', function(e) {
            if (disableServiceSelection) {
                var manualPrice = document.getElementById('editInvoiceManualPriceSom');
                var hiddenManual = document.getElementById('editInvoiceManualPriceSomHidden');
                if (manualPrice && hiddenManual) {
                    var v = parseFloat(manualPrice.value);
                    hiddenManual.value = (!isNaN(v) && v >= 0) ? v.toString() : '';
                }
                serviceItemsJsonEl.value = '';
            } else {
                var items = [];
                (document.querySelectorAll('#editInvoiceServicesBody .invoice-service-row') || []).forEach(function(tr) {
                    var check = tr.querySelector('.service-include');
                    if (!check || !check.checked) return;
                    var sid = tr.getAttribute('data-service-id');
                    var qtyInput = tr.querySelector('.service-qty');
                    var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;
                    if (sid) items.push({ ServiceId: sid, Qty: qty });
                });
                serviceItemsJsonEl.value = JSON.stringify(items);
            }
            if (allowedHassame && useExistingPayCodeEl) {
                var sel = document.getElementById('editInvoicePayCodeSelect');
                useExistingPayCodeEl.value = (sel && sel.value && sel.value !== '__new__' && sel.value !== '') ? 'true' : 'false';
            }
        });
    }

    if (allowedHassame) {
        var payCodeSelect = document.getElementById('editInvoicePayCodeSelect');
        var payCodeInput = document.getElementById('editInvoicePayCode');
        var currentPayCode = payCodeInput && payCodeInput.value ? payCodeInput.value : '';
        fetch('/Clients/GetInvoicePayCodeOptions?clientIds=' + encodeURIComponent('@Model.Client'))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!payCodeSelect) return;
                payCodeSelect.innerHTML = '';
                var optNew = document.createElement('option');
                optNew.value = '__new__';
                optNew.textContent = 'Сгенерировать новый';
                payCodeSelect.appendChild(optNew);
                (data.payCodeOptions || []).forEach(function(o) {
                    var opt = document.createElement('option');
                    opt.value = o.payCode || '';
                    opt.textContent = (o.nameInvoice && o.nameInvoice.trim() ? o.nameInvoice.trim() + ' (' + (o.payCode || '') + ')' : (o.payCode || '—'));
                    payCodeSelect.appendChild(opt);
                    if ((o.payCode || '') === currentPayCode) opt.selected = true;
                });
                if (!currentPayCode || currentPayCode.length !== 14) payCodeSelect.value = '__new__';
                payCodeSelect.addEventListener('change', function() {
                    var v = this.value;
                    if (v === '__new__' || v === '') {
                        fetch('/Clients/GetNextInvoiceNumber')
                            .then(function(r) { return r.json(); })
                            .then(function(d) { if (payCodeInput) payCodeInput.value = d.payCode || ''; })
                            .catch(function() { if (payCodeInput) payCodeInput.value = ''; });
                    } else {
                        if (payCodeInput) payCodeInput.value = v;
                    }
                });
            })
            .catch(function() {
                if (payCodeSelect) payCodeSelect.innerHTML = '<option value="__new__">Сгенерировать новый</option>';
                if (payCodeInput) payCodeInput.value = currentPayCode || '';
            });
    }

    document.getElementById('editInvoiceServicesSearch') && document.getElementById('editInvoiceServicesSearch').addEventListener('input', function() {
        var term = (this.value || '').toLowerCase().trim();
        (document.querySelectorAll('#editInvoiceServicesBody .invoice-service-row') || []).forEach(function(tr) {
            var name = (tr.getAttribute('data-name') || '').toLowerCase();
            tr.style.display = !term || name.indexOf(term) >= 0 ? '' : 'none';
        });
    });

    document.getElementById('editInvoiceGenerateQr') && document.getElementById('editInvoiceGenerateQr').addEventListener('click', function() {
        var code = (document.getElementById('editInvoicePayCode') || {}).value || 'TEST';
        var container = document.getElementById('editInvoiceQrContainer');
        if (container) container.innerHTML = '<img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + encodeURIComponent(code) + '" alt="QR" />';
    });
})();
    </script>
}

