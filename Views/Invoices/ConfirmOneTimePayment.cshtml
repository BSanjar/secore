@model WebApplication1.Dtos.OneTimePaymentPreviewVm
@{
    ViewData["Title"] = Model.IsCreated ? "Платёж создан" : "Подтверждение платежа";
    var backUrl = Url.Action("Invoices", "Cabinet") ?? "/";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    @if (!Model.IsCreated)
                    {
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                            <div>
                                <h1 class="h3 mb-2">Подтверждение одноразового платежа</h1>
                                <p class="text-muted mb-0">Проверьте данные перед созданием счёта и генерацией QR-кода.</p>
                            </div>
                            <a class="btn btn-outline-secondary" href="@backUrl">Назад</a>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-7">
                                <div class="border rounded-3 p-3 h-100">
                                    <h2 class="h5 mb-3">Детали</h2>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4 text-muted">Клиент</dt>
                                        <dd class="col-sm-8">@Model.ClientName</dd>
                                        <dt class="col-sm-4 text-muted">Название</dt>
                                        <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.Request.InvoiceName) ? Model.Request.InvoiceName : "Разовый платёж")</dd>
                                        <dt class="col-sm-4 text-muted">PayCode</dt>
                                        <dd class="col-sm-8">@Model.PayCode</dd>
                                        <dt class="col-sm-4 text-muted">Дата платежа</dt>
                                        <dd class="col-sm-8">@Model.PaymentAt.ToString("dd.MM.yyyy HH:mm")</dd>
                                    </dl>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="border rounded-3 p-3 h-100 bg-light-subtle">
                                    <div class="text-muted small mb-2">Итого к оплате</div>
                                    <div class="display-6 fw-semibold">@Model.TotalSom.ToString("N2") сом</div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h2 class="h5 mb-3">Состав</h2>
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>Услуга</th>
                                            <th style="width:120px;">Кол-во</th>
                                            <th style="width:160px;">Цена</th>
                                            <th style="width:180px;">Сумма</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr>
                                                <td>@line.ServiceName</td>
                                                <td>@line.Quantity</td>
                                                <td>@line.UnitPriceSom.ToString("N2") сом</td>
                                                <td>@line.LineTotalSom.ToString("N2") сом</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <form asp-action="ConfirmOneTimePayment" asp-controller="Invoices" method="post" class="mt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ClientId" value="@Model.Request.ClientId" />
                            <input type="hidden" name="InvoiceName" value="@Model.Request.InvoiceName" />
                            <input type="hidden" name="PayCode" value="@Model.PayCode" />
                            <input type="hidden" name="PaymentAt" value="@Model.PaymentAt.ToString("yyyy-MM-ddTHH:mm:ss")" />
                            <input type="hidden" name="ManualAmountSom" value="@Model.Request.ManualAmountSom" />
                            <input type="hidden" name="Hassameaccount" value="@Model.Request.Hassameaccount.ToString().ToLowerInvariant()" />
                            @for (var i = 0; i < Model.Request.ServiceItems.Count; i++)
                            {
                                <input type="hidden" name="ServiceItems[@i].ServiceId" value="@Model.Request.ServiceItems[i].ServiceId" />
                                <input type="hidden" name="ServiceItems[@i].Qty" value="@Model.Request.ServiceItems[i].Qty" />
                            }

                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-outline-secondary" href="@backUrl">Отмена</a>
                                <button type="submit" class="btn btn-primary">Подтвердить и создать QR</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                            <div>
                                <h1 class="h3 mb-2">Платёж создан</h1>
                                <p class="text-muted mb-0">Счёт создан, QR-код сохранён и готов для печати в документе.</p>
                            </div>
                            <a class="btn btn-outline-secondary" href="@backUrl">К списку счетов</a>
                        </div>

                        <div class="row g-4">
                            <div class="col-lg-7">
                                <div class="border rounded-3 p-3 h-100">
                                    <dl class="row mb-0">
                                        <dt class="col-sm-4 text-muted">Клиент</dt>
                                        <dd class="col-sm-8">@Model.ClientName</dd>
                                        <dt class="col-sm-4 text-muted">PayCode</dt>
                                        <dd class="col-sm-8">@Model.PayCode</dd>
                                        <dt class="col-sm-4 text-muted">Сумма</dt>
                                        <dd class="col-sm-8">@Model.TotalSom.ToString("N2") сом</dd>
                                        <dt class="col-sm-4 text-muted">Дата</dt>
                                        <dd class="col-sm-8">@Model.PaymentAt.ToString("dd.MM.yyyy HH:mm")</dd>
                                    </dl>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="border rounded-3 p-3 text-center h-100">
                                    @if (!string.IsNullOrWhiteSpace(Model.Qr?.QrCodeBase64))
                                    {
                                        <img src="data:image/png;base64,@Model.Qr.QrCodeBase64" alt="QR-код" class="img-fluid rounded border p-2 bg-white" style="max-height: 220px;" />
                                    }
                                    else
                                    {
                                        <div class="text-muted">QR-код недоступен</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h2 class="h5 mb-3">Состав</h2>
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>Услуга</th>
                                            <th style="width:120px;">Кол-во</th>
                                            <th style="width:160px;">Цена</th>
                                            <th style="width:180px;">Сумма</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in Model.Lines)
                                        {
                                            <tr>
                                                <td>@line.ServiceName</td>
                                                <td>@line.Quantity</td>
                                                <td>@line.UnitPriceSom.ToString("N2") сом</td>
                                                <td>@line.LineTotalSom.ToString("N2") сом</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            @if (!string.IsNullOrWhiteSpace(Model.DownloadPdfUrl))
                            {
                                <a class="btn btn-primary" href="@Model.DownloadPdfUrl">Скачать счёт с QR</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Qr?.QrLink))
                            {
                                <a class="btn btn-outline-secondary" href="@Model.Qr.QrLink" target="_blank" rel="noopener">Открыть QR-ссылку</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
