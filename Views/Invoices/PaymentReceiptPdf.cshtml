@model WebApplication1.Models.DBModels.InvoicePayment
@using System.Globalization
@{
    Layout = null;
    var ru = new CultureInfo("ru-RU");
    var inv = Model.InvoiceNavigation;
    var clientName = inv?.ClientNavigation?.ClientName ?? "—";
    var orgName = inv?.ClientNavigation?.OrganizationNavigation?.Name ?? "—";
    var payCode = inv?.PayCode ?? "—";
    var invoiceNumber = inv?.Id ?? "—";
    var periodFrom = Model.DateFrom?.ToString("dd.MM.yyyy", ru) ?? "—";
    var periodTo = Model.DateTo?.ToString("dd.MM.yyyy", ru) ?? "—";
    var periodVal = Model.PeriodValue ?? "—";
    var sumSoms = Model.PaymentSumm.HasValue ? Model.PaymentSumm.Value / 100m : 0m;
    var receiptNumber = "RCP-" + (Model.Id?.Length > 8 ? Model.Id.Substring(0, 8) : Model.Id ?? "—");
    var payDate = Model.DateTo?.ToString("dd.MM.yyyy HH:mm", ru) ?? DateTime.Now.ToString("dd.MM.yyyy HH:mm", ru);
}
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Чек об успешной оплате</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; padding: 0; font-family: Arial, sans-serif; background: #ffffff; color: #1f2937; font-size: 12px; }
    .receipt-page { width: 100%; max-width: none; margin: 0; background: #ffffff; border-radius: 8px; overflow: hidden; }
    .receipt-header { background: linear-gradient(135deg, #064e3b, #065f46); color: #ffffff; padding: 16px 20px; display: flex; justify-content: space-between; align-items: stretch; gap: 20px; min-height: 80px; }
    .receipt-header-left { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
    .receipt-header-system { display: block; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #a7f3d0; margin-bottom: 4px; }
    .receipt-header-left h1 { display: block; margin: 0 0 6px; font-size: 22px; font-weight: 700; line-height: 1.2; }
    .receipt-header-desc { display: block; margin: 0; font-size: 11px; line-height: 1.4; color: #d1fae5; }
    .receipt-header-right { flex-shrink: 0; width: 200px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
    .receipt-header-right .info-line { display: flex; justify-content: space-between; gap: 8px; font-size: 10px; }
    .receipt-header-right .info-line span:first-child { color: #a7f3d0; }
    .receipt-header-right .info-line strong { color: #ffffff; font-weight: 600; }
    .status-badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 10px; font-weight: 500; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: #fff; }
    .receipt-content { padding: 14px 18px 18px; }
    .success-panel { display: flex; align-items: center; gap: 14px; padding: 14px 18px; margin-bottom: 16px; border: 1px solid #a7f3d0; background: #ecfdf5; border-radius: 12px; }
    .success-icon { width: 44px; height: 44px; border-radius: 50%; background: #10b981; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: bold; flex-shrink: 0; }
    .success-text h2 { margin: 0 0 4px; font-size: 16px; color: #065f46; }
    .success-text p { margin: 0; font-size: 11px; color: #047857; line-height: 1.4; }
    .top-grid { display: grid; grid-template-columns: 65% 1fr; gap: 12px; margin-bottom: 12px; width: 100%; }
    .top-grid .card { min-width: 0; }
    .card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 12px 14px; background: #ffffff; }
    .card.gray { background: #f9fafb; }
    .card h2 { margin: 0 0 10px; font-size: 14px; color: #111827; }
    .field-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .field-box { border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 10px; }
    .field-box .label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.5px; color: #9ca3af; margin-bottom: 4px; }
    .field-box .value { font-size: 11px; font-weight: 600; color: #111827; line-height: 1.3; }
    .amount-card { border: 1px solid #a7f3d0; background: linear-gradient(180deg, #f0fdf4, #ecfdf5); border-radius: 12px; padding: 14px; margin-bottom: 10px; }
    .amount-card .label { font-size: 9px; text-transform: uppercase; color: #6b7280; margin-bottom: 4px; }
    .amount-card .value { font-size: 22px; font-weight: 800; color: #065f46; line-height: 1.2; }
    .mini-box { border: 1px solid #e5e7eb; border-radius: 8px; background: #fff; padding: 10px 12px; margin-bottom: 8px; font-size: 11px; }
    .mini-box:last-child { margin-bottom: 0; }
    .mini-box .label { font-size: 9px; text-transform: uppercase; color: #9ca3af; margin-bottom: 4px; }
    .mini-box .value { font-weight: 700; color: #111827; }
    .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%; margin-bottom: 12px; }
    .bottom-grid .card { min-width: 0; }
    .details-list p { margin: 0 0 6px; font-size: 11px; line-height: 1.4; color: #374151; }
    .details-list strong { color: #111827; }
    .stamp-box { margin-top: 12px; border: 1px dashed #86efac; border-radius: 10px; padding: 14px; text-align: center; color: #15803d; background: #f0fdf4; font-weight: 700; font-size: 12px; }
    .summary-line { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 6px; font-size: 11px; }
    .summary-line .title { color: #6b7280; }
    .summary-line .amount { font-weight: 700; color: #111827; }
    .summary-line.total { margin-top: 10px; padding-top: 10px; border-top: 1px dashed #cbd5e1; font-size: 13px; }
    .summary-line.total .amount { font-size: 18px; color: #065f46; }
    .operation-box { margin-top: 12px; background: #111827; color: #f9fafb; border-radius: 10px; padding: 12px 14px; line-height: 1.5; font-size: 11px; }
    .receipt-footer { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; padding: 12px 18px; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 10px; }
    .receipt-footer-left { max-width: 55%; }
    .signature-block { min-width: 160px; }
    .signature-title { margin-bottom: 16px; font-size: 9px; text-transform: uppercase; color: #9ca3af; letter-spacing: 0.5px; }
    .signature-line { border-top: 1px solid #6b7280; padding-top: 4px; color: #374151; font-size: 10px; }
  </style>
</head>
<body>
  <div class="receipt-page">
    <div class="receipt-header">
      <div class="receipt-header-left">
        <span class="receipt-header-system">SECORE / Billing</span>
        <h1>Чек об успешной оплате</h1>
        <span class="receipt-header-desc">Подтверждение того, что платеж был успешно принят и зачислен по указанному счету.</span>
      </div>
      <div class="receipt-header-right">
        <div class="info-line"><span>Номер чека</span><strong>@receiptNumber</strong></div>
        <div class="info-line"><span>Дата оплаты</span><strong>@payDate</strong></div>
        <div class="info-line"><span>Статус</span><span class="status-badge">Успешно оплачено</span></div>
      </div>
    </div>

    <div class="receipt-content">
      <div class="success-panel">
        <div class="success-icon">✓</div>
        <div class="success-text">
          <h2>Платеж выполнен успешно</h2>
          <p>Средства зачислены. Чек можно использовать как подтверждение оплаты услуги или счета.</p>
        </div>
      </div>

      <div class="top-grid">
        <div class="card">
          <h2>Информация о платеже</h2>
          <div class="field-grid">
            <div class="field-box"><div class="label">Плательщик</div><div class="value">@clientName</div></div>
            <div class="field-box"><div class="label">Назначение</div><div class="value">Оплата по счету за период @periodVal</div></div>
            <div class="field-box"><div class="label">Код оплаты (PayCode)</div><div class="value">@payCode</div></div>
            <div class="field-box"><div class="label">Номер счета</div><div class="value">@invoiceNumber</div></div>
            <div class="field-box"><div class="label">Период оплаты</div><div class="value">@periodFrom — @periodTo</div></div>
            <div class="field-box"><div class="label">Получатель</div><div class="value">@orgName</div></div>
          </div>
        </div>
        <div class="card gray">
          <h2>Сумма операции</h2>
          <div class="amount-card">
            <div class="label">Оплачено</div>
            <div class="value">@sumSoms.ToString("N2", ru) сом</div>
          </div>
          <div class="mini-box">
            <div class="label">Комиссия</div>
            <div class="value">0.00 сом</div>
          </div>
          <div class="mini-box">
            <div class="label">Итоговая сумма списания</div>
            <div class="value">@sumSoms.ToString("N2", ru) сом</div>
          </div>
          <div class="mini-box">
            <div class="label">Код операции</div>
            <div class="value">@receiptNumber</div>
          </div>
        </div>
      </div>

      <div class="bottom-grid">
        <div class="card details-list">
          <h2>Реквизиты подтверждения</h2>
          <p><strong>Получатель:</strong> @orgName</p>
          <p><strong>Плательщик:</strong> @clientName</p>
          <p><strong>Дата и время:</strong> @payDate</p>
          <p><strong>Статус операции:</strong> Успешно завершена</p>
          <div class="stamp-box">ПЛАТЕЖ УСПЕШНО ПРИНЯТ</div>
        </div>
        <div class="card">
          <h2>Итоги оплаты</h2>
          <div class="summary-line"><span class="title">Оплачено за период</span><span class="amount">@sumSoms.ToString("N2", ru) сом</span></div>
          <div class="summary-line"><span class="title">Комиссия</span><span class="amount">0.00 сом</span></div>
          <div class="summary-line total"><span class="title">Итого оплачено</span><span class="amount">@sumSoms.ToString("N2", ru) сом</span></div>
          <div class="operation-box">
            Операция подтверждена. Идентификатор: <strong>@receiptNumber</strong>. Сохраните этот чек для отчетности и подтверждения оплаты.
          </div>
        </div>
      </div>
    </div>

    <div class="receipt-footer">
      <div class="receipt-footer-left">Чек сформирован автоматически после успешного проведения платежа.</div>
      <div class="signature-block">
        <div class="signature-title">Подтверждение системы</div>
        <div class="signature-line">Электронно сформированный документ</div>
      </div>
    </div>
  </div>
</body>
</html>
