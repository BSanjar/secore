@model WebApplication1.ViewModels.Services.ServicesIndexViewModel
@{
    ViewData["Title"] = "Услуги";
}

<div class="dashboard-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <div class="medclinic-surface p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">Услуги</h1>
                <p class="text-muted mb-0">Каталог услуг клиники для записей, счетов и оплат.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" />
                    <button type="submit" class="btn btn-outline-success btn-sm">Загрузить Excel</button>
                </form>
                <a asp-action="Create" class="btn btn-primary">Добавить услугу</a>
            </div>
        </div>
        <div class="text-muted small mt-3">Excel: название, фиксированная, цена, мин. сумма, макс. сумма, специализации через запятую.</div>
    </div>

    <div class="medclinic-surface p-4">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-8">
                <label class="form-label">Поиск</label>
                <input name="search" value="@Model.Search" class="form-control" placeholder="По названию услуги" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-outline-primary">Найти</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
            </div>
        </form>

        @if (Model.Services.Count == 0)
        {
            <div class="text-muted">Список услуг пока пуст.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Название</th>
                            <th>Тип</th>
                            <th>Фиксированная цена</th>
                            <th>Диапазон</th>
                            <th>Специализации</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Services)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Name</td>
                                <td>@(item.IsFixed ? "Фиксированная" : "Диапазон")</td>
                                <td>@(item.IsFixed ? $"{item.FixedAmount:N2} сом" : "—")</td>
                                <td>
                                    @if (!item.IsFixed && (item.MinAmount.HasValue || item.MaxAmount.HasValue))
                                    {
                                        <span>@(item.MinAmount?.ToString("N2") ?? "—") - @(item.MaxAmount?.ToString("N2") ?? "—") сом</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @(item.SpecializationNames.Count == 0 ? "—" : string.Join(", ", item.SpecializationNames))
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
