@using WebApplication1.Helpers
@model WebApplication1.ViewModels.Services.ServicesIndexViewModel
@{
    ViewData["Title"] = "Услуги";
    ViewData["HideTopbarTitle"] = true;
}

@section Styles {
    <partial name="Partials/_MedclinicCatalogStyles" />
}

<div class="mc-staff dashboard-page">
    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">Услуги</h1>
                <p class="mc-staff-hero__sub">Каталог услуг клиники для записей, счетов и оплат.</p>
            </div>
            <div class="mc-staff-hero__actions">
                <a class="mc-staff-btn mc-staff-btn--primary" asp-action="Create">Добавить услугу</a>
            </div>
        </div>
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="mc-staff-import mc-catalog-import-form mt-3">
            @Html.AntiForgeryToken()
            <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" />
            <button type="submit" class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm">Загрузить Excel</button>
            <div class="mc-staff-import__hint">Excel: название, фиксированная, цена, мин. сумма, макс. сумма, специализации через запятую.</div>
        </form>
    </div>

    <div class="mc-staff-panel">
        <form method="get" class="mc-staff-filters">
            <label class="mc-staff-field mc-staff-field--grow">
                <span class="mc-staff-field__label">Поиск</span>
                <input name="search" value="@Model.Search" class="mc-staff-input" placeholder="По названию услуги" />
            </label>
            <div class="d-flex gap-2">
                <button type="submit" class="mc-staff-btn mc-staff-btn--primary">Найти</button>
                <a asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">Сброс</a>
            </div>
        </form>

        @if (Model.Services.Count == 0)
        {
            <div class="mc-staff-empty">Список услуг пока пуст.</div>
        }
        else
        {
            <div class="mc-staff-table-wrap">
                <table class="mc-staff-table">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Тип</th>
                            <th>Фиксированная цена</th>
                            <th>Диапазон</th>
                            <th>Специализации</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Services)
                        {
                            <tr>
                                <td>
                                    <div class="mc-staff-table__name">@item.Name</div>
                                </td>
                                <td>@(item.IsFixed ? "Фиксированная" : "Диапазон")</td>
                                <td>@(item.IsFixed ? $"{item.FixedAmount:N2} сом" : "—")</td>
                                <td>
                                    @if (!item.IsFixed && (item.MinAmount.HasValue || item.MaxAmount.HasValue))
                                    {
                                        <span>@(item.MinAmount?.ToString("N2") ?? "—") - @(item.MaxAmount?.ToString("N2") ?? "—") сом</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (item.SpecializationNames.Count == 0)
                                    {
                                        <span class="mc-staff-table__muted">—</span>
                                    }
                                    else
                                    {
                                        @string.Join(", ", item.SpecializationNames)
                                    }
                                </td>
                                <td>
                                    <div class="mc-staff-table__actions">
                                        <a class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm" asp-action="Edit" asp-route-id="@item.Id">Редактировать</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="Partials/_MedclinicCatalogScripts" />
}
