@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@model IEnumerable<WebApplication1.Models.DBModels.OrganizationField>
@{
    ViewData["Title"] = Localizer["AdditionalFields"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-soft.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">@Localizer["Settings"]</a>
        <span class="breadcrumb-sep">/</span>
        <span>@Localizer["AdditionalFields"]</span>
    </nav>

    <div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="page-title">@Localizer["AdditionalFields"]</h1>
            <p class="page-subtitle mb-0">Дополнительные поля карточки клиента для вашей организации.</p>
        </div>
        <a asp-action="Create" class="detsad-btn-primary">@Localizer["Create"]</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="dashboard-table-card">
            <div class="table-wrap">
                <table class="table-soft">
                    <thead>
                        <tr>
                            <th>@Localizer["FieldName"]</th>
                            <th>@Localizer["FieldType"]</th>
                            <th>@Localizer["SelectValues"]</th>
                            <th>@Localizer["FilterByField"]</th>
                            <th class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var field in Model)
                        {
                            <tr>
                                <td class="cell-name">@field.FieldName</td>
                                <td><span class="status-badge status-active">@field.FieldType</span></td>
                                <td class="cell-muted small">
                                    @if (!string.IsNullOrEmpty(field.FieldSelectValues))
                                    {
                                        @field.FieldSelectValues
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (field.Filterbyfield == true)
                                    {
                                        <span class="status-badge status-active">@Localizer["Yes"]</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge" style="background: var(--accent-primary-soft); color: var(--text-secondary);">@Localizer["No"]</span>
                                    }
                                </td>
                                <td class="text-end cell-actions">
                                    <a asp-action="Edit" asp-route-id="@field.Id" class="btn btn-sm btn-soft-secondary me-1">@Localizer["Edit"]</a>
                                    <a asp-action="Delete" asp-route-id="@field.Id" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state-settings">
            <p class="mb-0">@Localizer["NoFieldsFound"]. <a asp-action="Create">@Localizer["CreateFirstField"]</a>.</p>
        </div>
    }
</div>
