@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@model WebApplication1.Models.DBModels.OrganizationField
@{
    ViewData["Title"] = Localizer["DeleteField"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-soft.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">@Localizer["Settings"]</a>
        <span class="breadcrumb-sep">/</span>
        <a asp-action="Index">@Localizer["AdditionalFields"]</a>
        <span class="breadcrumb-sep">/</span>
        <span>@Localizer["DeleteField"]</span>
    </nav>

    <div class="page-header">
        <h1 class="page-title">@Localizer["DeleteField"]</h1>
        <p class="page-subtitle mb-0">@Model.FieldName</p>
    </div>

    <div class="alert alert-warning border-0" style="border-radius: 12px;">
        <strong>@Localizer["AreYouSure"]</strong>
        <p class="mb-0 mt-2">@Localizer["DeleteFieldWarning"]</p>
    </div>

    <div class="filters-section">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">@Localizer["FieldName"]</dt>
            <dd class="col-sm-9">@Model.FieldName</dd>

            <dt class="col-sm-3 text-muted">@Localizer["FieldType"]</dt>
            <dd class="col-sm-9"><span class="status-badge status-active">@Model.FieldType</span></dd>

            @if (!string.IsNullOrEmpty(Model.FieldSelectValues))
            {
                <dt class="col-sm-3 text-muted">@Localizer["SelectValues"]</dt>
                <dd class="col-sm-9">@Model.FieldSelectValues</dd>
            }

            <dt class="col-sm-3 text-muted">@Localizer["FilterByField"]</dt>
            <dd class="col-sm-9">
                @if (Model.Filterbyfield == true)
                {
                    <span class="status-badge status-active">@Localizer["Yes"]</span>
                }
                else
                {
                    <span class="status-badge" style="background: var(--accent-primary-soft); color: var(--text-secondary);">@Localizer["No"]</span>
                }
            </dd>
        </dl>
    </div>

    <form asp-action="Delete" asp-controller="OrganizationFields" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
        <a asp-action="Index" class="detsad-btn-secondary">@Localizer["Cancel"]</a>
    </form>
</div>

