@model IEnumerable<WebApplication1.Models.DBModels.Commission>
@{
    ViewData["Title"] = "Справочник комиссий";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Справочник комиссий</h1>
        <p class="text-muted small mb-0">Виды комиссии для тарифа «верхняя комиссия» и «нижняя комиссия»</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Добавить комиссию</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Вид</th>
                    <th>Параметры</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@(c.Name ?? "—")</td>
                        <td>@c.CommissionKind</td>
                        <td class="small">
                            @if (c.Rate.HasValue) { <span>@((c.Rate.Value * 100).ToString("0.##"))%</span> }
                            @if (c.FixedAmount.HasValue) { <span> фикс @(c.FixedAmount.Value.ToString("0.##")) сом</span> }
                            @if (c.MinFee.HasValue || c.MaxFee.HasValue) { <span> мин/макс @((c.MinFee ?? 0).ToString("0.##"))–@((c.MaxFee ?? 0).ToString("0.##")) сом</span> }
                            @if (c.Tiers?.Any() == true) { <span> ступеней: @c.Tiers.Count</span> }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить комиссию?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-2">Всего: @Model.Count()</p>
}
else
{
    <div class="alert alert-info">В справочнике пока нет комиссий. <a asp-action="Create">Добавить комиссию</a>.</div>
}

<p class="mt-3">
    <a asp-controller="OrganizationSettings" asp-action="Index" class="btn btn-outline-secondary">← Настройки организации</a>
    <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">К настройкам</a>
</p>
