@model WebApplication1.ViewModels.Doctors.DoctorAssignmentsEditViewModel
@{
    ViewData["Title"] = "Назначения — " + Model.DoctorName;
}

@section Styles {
    <partial name="Partials/_MedclinicStaffStyles" />
    <link rel="stylesheet" href="~/css/doctor-schedule.css" asp-append-version="true" />
}

<div class="mc-staff dashboard-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mc-staff-alert">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mc-staff-alert">@TempData["Error"]</div>
    }

    <nav class="mc-staff-breadcrumb" aria-label="Навигация">
        <a asp-action="Index">Сотрудники</a>
        <span class="mc-staff-breadcrumb__sep">›</span>
        <span>@Model.DoctorName</span>
    </nav>

    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">@Model.DoctorName</h1>
                <p class="mc-staff-hero__sub">Отделения, специализации и рабочие смены.</p>
            </div>
            <div class="mc-staff-hero__actions">
                <button type="button" class="mc-staff-btn mc-staff-btn--primary" data-bs-toggle="modal" data-bs-target="#doctorScheduleModal">Смена</button>
                <a class="mc-staff-btn mc-staff-btn--soft" asp-action="Appointments" asp-route-id="@Model.DoctorId">Приёмы</a>
                <a class="mc-staff-btn mc-staff-btn--ghost" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.DoctorId">Карточка</a>
                <a class="mc-staff-btn mc-staff-btn--ghost" asp-action="Index">К списку</a>
            </div>
        </div>

        <div class="mc-staff-stats">
            <div class="mc-staff-stat">
                <div class="mc-staff-stat__label">Контакты</div>
                <div class="mc-staff-stat__value">@Model.DoctorName</div>
                <div class="mc-staff-stat__line">@(Model.Email ?? "—")</div>
                <div class="mc-staff-stat__line">@(Model.Phone ?? "—")</div>
            </div>
            <div class="mc-staff-stat">
                <div class="mc-staff-stat__label">Роли</div>
                @if (Model.Roles.Count == 0)
                {
                    <div class="mc-staff-stat__line">Без ролей</div>
                }
                else
                {
                    <div class="mc-staff-chips mt-1">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="mc-staff-chip mc-staff-chip--role">@role</span>
                        }
                    </div>
                }
            </div>
            <div class="mc-staff-stat">
                <div class="mc-staff-stat__label">Базовая смена</div>
                @if (!Model.DoctorSchedulesReady)
                {
                    <div class="mc-staff-stat__line text-danger">@Model.DoctorSchedulesMessage</div>
                }
                else if (Model.DoctorSchedules.Count == 0)
                {
                    <div class="mc-staff-stat__line">Не настроена</div>
                }
                else
                {
                    @foreach (var schedule in Model.DoctorSchedules)
                    {
                        var dayLabel = schedule.DayOfWeek switch { 1 => "Пн", 2 => "Вт", 3 => "Ср", 4 => "Чт", 5 => "Пт", 6 => "Сб", _ => "Вс" };
                        <div class="mc-staff-stat__line"><strong>@dayLabel</strong> @schedule.StartTime–@schedule.EndTime</div>
                    }
                    <div class="mc-staff-stat__line mt-1"><strong>Приём:</strong> @Model.AppointmentDurationMinutes мин</div>
                }
                @if (Model.DoctorSchedulesReady)
                {
                    <form method="post" asp-action="SaveAppointmentDuration" asp-route-id="@Model.DoctorId" class="d-flex gap-2 mt-2">
                        @Html.AntiForgeryToken()
                        <select class="mc-staff-select flex-grow-1" name="appointmentDurationMinutes" style="height:2rem;font-size:.78rem;">
                            @foreach (var duration in new[] { 10, 15, 20, 25, 30, 40, 45, 50, 60, 90, 120 })
                            {
                                <option value="@duration" selected="@(Model.AppointmentDurationMinutes == duration)">@duration мин</option>
                            }
                        </select>
                        <button type="submit" class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm">OK</button>
                    </form>
                }
            </div>
            <div class="mc-staff-stat">
                <div class="mc-staff-stat__label">Особые дни</div>
                @if (!Model.DoctorScheduleOverridesReady)
                {
                    <div class="mc-staff-stat__line text-danger">@Model.DoctorScheduleOverridesMessage</div>
                }
                else if (Model.DoctorScheduleOverrides.Count == 0)
                {
                    <div class="mc-staff-stat__line">Не заданы</div>
                }
                else
                {
                    @foreach (var item in Model.DoctorScheduleOverrides.Take(4))
                    {
                        <div class="mc-staff-stat__line">
                            <strong>@item.WorkDate</strong>:
                            @(item.IsWorking ? $"{item.StartTime}–{item.EndTime}" : "выходной")
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="mc-staff-panel">
        <div class="mc-staff-panel__head">
            <h2 class="mc-staff-panel__title">Отделения и специализации</h2>
            <p class="mc-staff-panel__sub">Направления работы сотрудника в клинике.</p>
        </div>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small col-12"></div>

            <div class="col-lg-6">
                <div class="mc-staff-panel" style="padding:.75rem;box-shadow:none;border-color:rgba(15,23,42,.06);">
                    <div class="mc-staff-panel__head">
                        <h3 class="mc-staff-panel__title">Отделения</h3>
                    </div>
                    @if (Model.Departments.Count == 0)
                    {
                        <div class="alert alert-warning mb-0 py-2 px-3 small">Сначала добавьте отделение.</div>
                    }
                    else
                    {
                        <div class="mc-staff-checkgrid">
                            @foreach (var department in Model.Departments)
                            {
                                var isChecked = Model.Form.SelectedDepartmentIds.Contains(department.Id);
                                <label class="mc-staff-checkcard">
                                    <span class="mc-staff-checkcard__main">
                                        <input type="checkbox" name="SelectedDepartmentIds" value="@department.Id" class="form-check-input mt-1" checked="@isChecked" />
                                        <span class="mc-staff-checkcard__title">@department.Name</span>
                                    </span>
                                    <input type="radio" name="PrimaryDepartmentId" value="@department.Id" class="form-check-input" checked="@(Model.Form.PrimaryDepartmentId == department.Id)" title="Основное" />
                                </label>
                            }
                        </div>
                        <div class="mc-staff-hint">Справа — основное отделение.</div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="mc-staff-panel" style="padding:.75rem;box-shadow:none;border-color:rgba(15,23,42,.06);">
                    <div class="mc-staff-panel__head">
                        <h3 class="mc-staff-panel__title">Специализации</h3>
                    </div>
                    @if (Model.Specializations.Count == 0)
                    {
                        <div class="alert alert-warning mb-0 py-2 px-3 small">Сначала добавьте специализацию.</div>
                    }
                    else
                    {
                        <div class="mc-staff-checkgrid">
                            @foreach (var specialization in Model.Specializations)
                            {
                                var isChecked = Model.Form.SelectedSpecializationIds.Contains(specialization.Id);
                                <label class="mc-staff-checkcard">
                                    <span class="mc-staff-checkcard__main">
                                        <input type="checkbox" name="SelectedSpecializationIds" value="@specialization.Id" class="form-check-input mt-1" checked="@isChecked" />
                                        <span>
                                            <span class="mc-staff-checkcard__title">@specialization.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(specialization.SecondaryText))
                                            {
                                                <span class="mc-staff-checkcard__sub d-block">@specialization.SecondaryText</span>
                                            }
                                        </span>
                                    </span>
                                    <input type="radio" name="PrimarySpecializationId" value="@specialization.Id" class="form-check-input" checked="@(Model.Form.PrimarySpecializationId == specialization.Id)" title="Основная" />
                                </label>
                            }
                        </div>
                        <div class="mc-staff-hint">Справа — основная специализация.</div>
                    }
                </div>
            </div>

            <div class="col-12 mc-staff-form-actions">
                <button type="submit" class="mc-staff-btn mc-staff-btn--primary">Сохранить</button>
                <a class="mc-staff-btn mc-staff-btn--ghost" asp-action="Index">Отмена</a>
            </div>
        </form>
    </div>
</div>

<div class="modal fade mc-staff-modal" id="doctorScheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title">Настройка смены</h2>
                    <p class="mc-staff-panel__sub mb-0">Базовый график по дням недели и особые даты.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="mc-staff-panel" style="box-shadow:none;">
                            <div class="mc-staff-panel__head">
                                <h3 class="mc-staff-panel__title">Базовая смена</h3>
                            </div>
                            @if (!Model.DoctorSchedulesReady)
                            {
                                <div class="alert alert-warning mb-0 py-2 px-3 small">@Model.DoctorSchedulesMessage</div>
                            }
                            else
                            {
                                <form method="post" asp-action="SaveSchedule" asp-route-id="@Model.DoctorId" class="row g-2 mc-staff-form">
                                    @Html.AntiForgeryToken()
                                    <div class="col-12">
                                        <label class="form-label">Рабочие дни</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            @for (var day = 1; day <= 7; day++)
                                            {
                                                var label = day switch { 1 => "Пн", 2 => "Вт", 3 => "Ср", 4 => "Чт", 5 => "Пт", 6 => "Сб", _ => "Вс" };
                                                <label class="schedule-radio">
                                                    <input type="checkbox" name="DaysOfWeek" value="@day" checked="@Model.ScheduleForm.DaysOfWeek.Contains(day)" />
                                                    <span>@label</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Начало</label>
                                        <input class="form-control" type="time" name="StartTime" value="@Model.ScheduleForm.StartTime" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Конец</label>
                                        <input class="form-control" type="time" name="EndTime" value="@Model.ScheduleForm.EndTime" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Длительность приёма</label>
                                        <select class="form-select" name="AppointmentDurationMinutes">
                                            @foreach (var duration in new[] { 10, 15, 20, 25, 30, 40, 45, 50, 60, 90, 120 })
                                            {
                                                <option value="@duration" selected="@(Model.ScheduleForm.AppointmentDurationMinutes == duration)">@duration мин</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="mc-staff-btn mc-staff-btn--primary">Сохранить смену</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mc-staff-panel" style="box-shadow:none;">
                            <div class="mc-staff-panel__head">
                                <h3 class="mc-staff-panel__title">Особый день</h3>
                            </div>
                            @if (!Model.DoctorScheduleOverridesReady)
                            {
                                <div class="alert alert-warning mb-0 py-2 px-3 small">@Model.DoctorScheduleOverridesMessage</div>
                            }
                            else
                            {
                                <form method="post" asp-action="SaveScheduleOverride" asp-route-id="@Model.DoctorId" class="row g-2 mc-staff-form" id="doctorScheduleOverrideForm">
                                    @Html.AntiForgeryToken()
                                    <div class="col-md-4">
                                        <label class="form-label">Дата</label>
                                        <input class="form-control" type="date" name="WorkDate" value="@Model.OverrideForm.WorkDate?.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label d-block">Режим</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <label class="schedule-radio"><input type="radio" name="Mode" value="default" checked /><span>Базовая</span></label>
                                            <label class="schedule-radio"><input type="radio" name="Mode" value="off" /><span>Выходной</span></label>
                                            <label class="schedule-radio"><input type="radio" name="Mode" value="custom" /><span>Своя смена</span></label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Начало</label>
                                        <input class="form-control" type="time" name="StartTime" value="08:00" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Конец</label>
                                        <input class="form-control" type="time" name="EndTime" value="18:00" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Комментарий</label>
                                        <input class="form-control" type="text" name="Comment" placeholder="Дежурство, сокращённый день…" />
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="mc-staff-btn mc-staff-btn--ghost">Сохранить день</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const overrideForm = document.getElementById("doctorScheduleOverrideForm");
            if (!overrideForm) return;
            const modeInputs = overrideForm.querySelectorAll('input[name="Mode"]');
            const startInput = overrideForm.querySelector('input[name="StartTime"]');
            const endInput = overrideForm.querySelector('input[name="EndTime"]');
            function syncOverrideMode() {
                const mode = overrideForm.querySelector('input[name="Mode"]:checked')?.value || "default";
                const disabled = mode !== "custom";
                if (startInput) startInput.disabled = disabled;
                if (endInput) endInput.disabled = disabled;
            }
            modeInputs.forEach((input) => input.addEventListener("change", syncOverrideMode));
            syncOverrideMode();
        })();
    </script>
}
