@model WebApplication1.ViewModels.Doctors.DoctorAssignmentsEditViewModel
@{
    ViewData["Title"] = "Назначения врача";
}

@section Styles {
    <link rel="stylesheet" href="~/css/doctor-schedule.css" asp-append-version="true" />
}

<div class="dashboard-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <div class="medclinic-surface p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">@Model.DoctorName</h1>
                <p class="text-muted mb-0">Управление отделениями, специализациями и сменами врача.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#doctorScheduleModal">Настроить смену</button>
                <a class="btn btn-primary" asp-action="Appointments" asp-route-id="@Model.DoctorId">Приемы</a>
                <a class="btn btn-outline-secondary" asp-action="Index">К списку докторов</a>
                <a class="btn btn-outline-primary" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.DoctorId">Карточка пользователя</a>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6 col-xl-3">
                <div class="border rounded-3 p-3 h-100">
                    <div class="text-muted small mb-1">Контакты</div>
                    <div class="fw-semibold">@Model.DoctorName</div>
                    <div>@(Model.Email ?? "—")</div>
                    <div>@(Model.Phone ?? "—")</div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded-3 p-3 h-100">
                    <div class="text-muted small mb-1">Роли</div>
                    @if (Model.Roles.Count == 0)
                    {
                        <span class="text-muted">Без ролей</span>
                    }
                    else
                    {
                        foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-info-subtle text-dark me-1 mb-1">@role</span>
                        }
                    }
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded-3 p-3 h-100">
                    <div class="text-muted small mb-1">Базовая смена</div>
                    @if (!Model.DoctorSchedulesReady)
                    {
                        <div class="small text-danger">@Model.DoctorSchedulesMessage</div>
                    }
                    else if (Model.DoctorSchedules.Count == 0)
                    {
                        <div class="small text-muted">Пока не настроена.</div>
                    }
                    else
                    {
                        <div class="small">
                            @foreach (var schedule in Model.DoctorSchedules)
                            {
                                var dayLabel = schedule.DayOfWeek switch
                                {
                                    1 => "Пн",
                                    2 => "Вт",
                                    3 => "Ср",
                                    4 => "Чт",
                                    5 => "Пт",
                                    6 => "Сб",
                                    _ => "Вс"
                                };
                                <div><strong>@dayLabel</strong>: @schedule.StartTime - @schedule.EndTime</div>
                            }
                            <div class="mt-2"><strong>Длительность приема:</strong> @Model.AppointmentDurationMinutes мин</div>
                        </div>

                    }

                    @if (Model.DoctorSchedulesReady)
                    {
                        <form method="post" asp-action="SaveAppointmentDuration" asp-route-id="@Model.DoctorId" class="mt-3">
                            @Html.AntiForgeryToken()
                            <label class="form-label small mb-1">Изменить длительность</label>
                            <div class="d-flex gap-2">
                                <select class="form-select form-select-sm" name="appointmentDurationMinutes">
                                    @{
                                        var durationOptions = new[] { 10, 15, 20, 25, 30, 40, 45, 50, 60, 90, 120 };
                                    }
                                    @foreach (var duration in durationOptions)
                                    {
                                        if (Model.AppointmentDurationMinutes == duration)
                                        {
                                            <option value="@duration" selected>@duration минут</option>
                                        }
                                        else
                                        {
                                            <option value="@duration">@duration минут</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Сохранить</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="border rounded-3 p-3 h-100">
                    <div class="text-muted small mb-1">Ближайшие особые дни</div>
                    @if (!Model.DoctorScheduleOverridesReady)
                    {
                        <div class="small text-danger">@Model.DoctorScheduleOverridesMessage</div>
                    }
                    else if (Model.DoctorScheduleOverrides.Count == 0)
                    {
                        <div class="small text-muted">Индивидуальные даты пока не настроены.</div>
                    }
                    else
                    {
                        <div class="small">
                            @foreach (var item in Model.DoctorScheduleOverrides.Take(4))
                            {
                                <div class="mb-1">
                                    <strong>@item.WorkDate</strong>:
                                    @(item.IsWorking ? $"{item.StartTime} - {item.EndTime}" : "выходной")
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="medclinic-surface p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="h5 mb-1">Отделения и специализации</h2>
                <p class="text-muted mb-0">Определяют, в каких направлениях врач работает в клинике.</p>
            </div>
        </div>

        <form method="post" class="row g-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

            <div class="col-lg-6">
                <div class="border rounded-3 p-3 h-100">
                    <div class="mb-3">
                        <h3 class="h6 mb-1">Отделения</h3>
                        <p class="text-muted small mb-0">Выберите отделения, в которых работает врач.</p>
                    </div>

                    @if (Model.Departments.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">Сначала добавьте хотя бы одно отделение.</div>
                    }
                    else
                    {
                        <div class="vstack gap-2">
                            @foreach (var department in Model.Departments)
                            {
                                var isChecked = Model.Form.SelectedDepartmentIds.Contains(department.Id);
                                <label class="border rounded-3 p-3 d-flex justify-content-between align-items-start gap-3">
                                    <span class="d-flex gap-2">
                                        <input type="checkbox" name="SelectedDepartmentIds" value="@department.Id" class="form-check-input mt-1" checked="@isChecked" />
                                        <span class="fw-semibold d-block">@department.Name</span>
                                    </span>
                                    <span class="form-check">
                                        <input type="radio" name="PrimaryDepartmentId" value="@department.Id" class="form-check-input" checked="@(Model.Form.PrimaryDepartmentId == department.Id)" />
                                    </span>
                                </label>
                            }
                        </div>
                        <div class="text-muted small mt-2">Радиокнопка справа отмечает основное отделение.</div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="border rounded-3 p-3 h-100">
                    <div class="mb-3">
                        <h3 class="h6 mb-1">Специализации</h3>
                        <p class="text-muted small mb-0">Выберите специализации и укажите основную.</p>
                    </div>

                    @if (Model.Specializations.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">Сначала добавьте хотя бы одну специализацию.</div>
                    }
                    else
                    {
                        <div class="vstack gap-2">
                            @foreach (var specialization in Model.Specializations)
                            {
                                var isChecked = Model.Form.SelectedSpecializationIds.Contains(specialization.Id);
                                <label class="border rounded-3 p-3 d-flex justify-content-between align-items-start gap-3">
                                    <span class="d-flex gap-2">
                                        <input type="checkbox" name="SelectedSpecializationIds" value="@specialization.Id" class="form-check-input mt-1" checked="@isChecked" />
                                        <span>
                                            <span class="fw-semibold d-block">@specialization.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(specialization.SecondaryText))
                                            {
                                                <span class="text-muted small">@specialization.SecondaryText</span>
                                            }
                                        </span>
                                    </span>
                                    <span class="form-check">
                                        <input type="radio" name="PrimarySpecializationId" value="@specialization.Id" class="form-check-input" checked="@(Model.Form.PrimarySpecializationId == specialization.Id)" />
                                    </span>
                                </label>
                            }
                        </div>
                        <div class="text-muted small mt-2">Радиокнопка справа отмечает основную специализацию.</div>
                    }
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Сохранить назначения</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Отмена</a>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="doctorScheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h4 mb-1">Настройка смены</h2>
                    <p class="text-muted mb-0">Базовая смена действует по шаблону недели, а отдельные даты могут ее переопределять.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="border rounded-3 p-3">
                            <div class="mb-3">
                                <h3 class="h6 mb-1">Базовая смена</h3>
                                <p class="text-muted small mb-0">Один раз настройте типовой график врача по дням недели.</p>
                            </div>

                            @if (!Model.DoctorSchedulesReady)
                            {
                                <div class="alert alert-warning mb-0">@Model.DoctorSchedulesMessage</div>
                            }
                            else
                            {
                                <form method="post" asp-action="SaveSchedule" asp-route-id="@Model.DoctorId" class="row g-3">
                                    @Html.AntiForgeryToken()
                                    <div class="col-12">
                                        <label class="form-label d-block">Рабочие дни</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            @for (var day = 1; day <= 7; day++)
                                            {
                                                var label = day switch
                                                {
                                                    1 => "Пн",
                                                    2 => "Вт",
                                                    3 => "Ср",
                                                    4 => "Чт",
                                                    5 => "Пт",
                                                    6 => "Сб",
                                                    _ => "Вс"
                                                };
                                                var isChecked = Model.ScheduleForm.DaysOfWeek.Contains(day);
                                                <label class="schedule-radio">
                                                    <input type="checkbox" name="DaysOfWeek" value="@day" checked="@isChecked" />
                                                    <span>@label</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Начало смены</label>
                                        <input class="form-control" type="time" name="StartTime" value="@Model.ScheduleForm.StartTime" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Конец смены</label>
                                        <input class="form-control" type="time" name="EndTime" value="@Model.ScheduleForm.EndTime" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Длительность приема (мин)</label>
                                        <select class="form-select" name="AppointmentDurationMinutes">
                                            @{
                                                var durations = new[] { 10, 15, 20, 25, 30, 40, 45, 50, 60, 90, 120 };
                                            }
                                            @foreach (var duration in durations)
                                            {
                                                if (Model.ScheduleForm.AppointmentDurationMinutes == duration)
                                                {
                                                    <option value="@duration" selected>@duration минут</option>
                                                }
                                                else
                                                {
                                                    <option value="@duration">@duration минут</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">Сохранить базовую смену</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="border rounded-3 p-3">
                            <div class="mb-3">
                                <h3 class="h6 mb-1">Особый день</h3>
                                <p class="text-muted small mb-0">Можно сделать выбранную дату выходным или задать для нее собственное время работы.</p>
                            </div>

                            @if (!Model.DoctorScheduleOverridesReady)
                            {
                                <div class="alert alert-warning mb-0">@Model.DoctorScheduleOverridesMessage</div>
                            }
                            else
                            {
                                <form method="post" asp-action="SaveScheduleOverride" asp-route-id="@Model.DoctorId" class="row g-3" id="doctorScheduleOverrideForm">
                                    @Html.AntiForgeryToken()
                                    <div class="col-md-4">
                                        <label class="form-label">Дата</label>
                                        <input class="form-control" type="date" name="WorkDate" value="@Model.OverrideForm.WorkDate?.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label d-block">Режим</label>
                                        <div class="d-flex flex-wrap gap-3">
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="Mode" value="default" checked />
                                                <span class="form-check-label">Использовать базовую смену</span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="Mode" value="off" />
                                                <span class="form-check-label">Выходной</span>
                                            </label>
                                            <label class="form-check">
                                                <input class="form-check-input" type="radio" name="Mode" value="custom" />
                                                <span class="form-check-label">Своя смена</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Начало смены</label>
                                        <input class="form-control" type="time" name="StartTime" value="08:00" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Конец смены</label>
                                        <input class="form-control" type="time" name="EndTime" value="18:00" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Комментарий</label>
                                        <input class="form-control" type="text" name="Comment" placeholder="Например: дежурство, сокращенный день, отпуск" />
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-outline-primary">Сохранить особый день</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const overrideForm = document.getElementById("doctorScheduleOverrideForm");
            if (!overrideForm) return;

            const modeInputs = overrideForm.querySelectorAll('input[name="Mode"]');
            const startInput = overrideForm.querySelector('input[name="StartTime"]');
            const endInput = overrideForm.querySelector('input[name="EndTime"]');

            function syncOverrideMode() {
                const mode = overrideForm.querySelector('input[name="Mode"]:checked')?.value || "default";
                const disabled = mode !== "custom";
                if (startInput) startInput.disabled = disabled;
                if (endInput) endInput.disabled = disabled;
            }

            modeInputs.forEach((input) => input.addEventListener("change", syncOverrideMode));
            syncOverrideMode();
        })();
    </script>
}
