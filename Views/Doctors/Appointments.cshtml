@model WebApplication1.ViewModels.Doctors.DoctorAssignmentsEditViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.DoctorName + " — Приёмы";
    ViewData["HideTopbarTitle"] = true;
    var eventsJson = JsonSerializer.Serialize(Model.Events.Select(x => new
    {
        id = x.Id,
        title = x.Title,
        patientName = x.PatientName,
        start = x.Start,
        end = x.End,
        status = x.Status
    }));
    var schedulesJson = JsonSerializer.Serialize(Model.DoctorSchedules);
    var overridesJson = JsonSerializer.Serialize(Model.DoctorScheduleOverrides);
}

@section Styles {
    <partial name="Partials/_MedclinicStaffStyles" />
    <link rel="stylesheet" href="~/web/medclinic/css/medclinic-schedule.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doctor-schedule.css" asp-append-version="true" />
}

<div class="mc-staff dashboard-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mc-staff-alert">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mc-staff-alert">@TempData["Error"]</div>
    }

    <nav class="mc-staff-breadcrumb" aria-label="Навигация">
        <a asp-action="Index">Сотрудники</a>
        <span class="mc-staff-breadcrumb__sep">›</span>
        <a asp-controller="Users" asp-action="Edit" asp-route-id="@Model.DoctorId">@Model.DoctorName</a>
        <span class="mc-staff-breadcrumb__sep">›</span>
        <span>Приёмы</span>
    </nav>

    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">@Model.DoctorName</h1>
                <p class="mc-staff-hero__sub">Календарь приёмов сотрудника.</p>
            </div>
            <div class="mc-staff-hero__actions">
                <a class="mc-staff-btn mc-staff-btn--ghost" asp-action="Index">Назад к списку</a>
            </div>
        </div>
    </div>

    <div class="mc-staff-panel mc-staff-calendar-panel schedule-board">
        <div class="mc-staff-calendar-toolbar" id="doctorCalendarToolbar">
            <div>
                <h2 class="mc-staff-panel__title mb-0">Календарь</h2>
                <p class="mc-staff-panel__sub mb-0">Рабочее время и назначенные приёмы.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <div class="mc-staff-seg btn-group" role="group">
                    <button class="btn btn-outline-secondary doctor-calendar-nav" data-direction="prev" type="button">‹</button>
                    <button class="btn btn-outline-secondary doctor-calendar-nav" data-direction="today" type="button">Сегодня</button>
                    <button class="btn btn-outline-secondary doctor-calendar-nav" data-direction="next" type="button">›</button>
                </div>
                <div class="mc-staff-seg btn-group doctor-calendar-switcher" role="group">
                    <button class="btn active" data-view="week" type="button">Неделя</button>
                    <button class="btn" data-view="month" type="button">Месяц</button>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-2">
            <span class="medclinic-badge medclinic-badge--available">Рабочий день</span>
            <span class="medclinic-badge medclinic-badge--busy">Приём</span>
        </div>

        <div class="schedule-calendar">
            <div class="schedule-calendar__header">
                <div id="doctorCalendarPeriodLabel" class="schedule-calendar__period"></div>
            </div>
            <div id="doctorCalendarGrid" class="schedule-calendar__grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.doctorScheduleCalendar = {
            events: @Html.Raw(eventsJson),
            schedules: @Html.Raw(schedulesJson),
            overrides: @Html.Raw(overridesJson)
        };
    </script>
    <script src="~/js/doctor-schedule.js" asp-append-version="true"></script>
}
