@model WebApplication1.ViewModels.Doctors.DoctorAssignmentsEditViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Приемы врача";
    var eventsJson = JsonSerializer.Serialize(Model.Events.Select(x => new
    {
        id = x.Id,
        title = x.Title,
        patientName = x.PatientName,
        start = x.Start,
        end = x.End,
        status = x.Status
    }));
    var schedulesJson = JsonSerializer.Serialize(Model.DoctorSchedules);
    var overridesJson = JsonSerializer.Serialize(Model.DoctorScheduleOverrides);
}

@section Styles {
    <link rel="stylesheet" href="~/web/medclinic/css/medclinic-schedule.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/doctor-schedule.css" asp-append-version="true" />
}

<div class="dashboard-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <div class="medclinic-surface p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">@Model.DoctorName</h1>
                <p class="text-muted mb-0">Календарь приемов врача.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index">К списку докторов</a>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.DoctorId">Edit</a>
                <a class="btn btn-outline-primary" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.DoctorId">Карточка пользователя</a>
            </div>
        </div>
    </div>

    <div class="medclinic-surface schedule-board mb-4">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="h5 mb-1">Календарь врача</h2>
                <p class="text-muted mb-0">Фон показывает рабочее время, поверх него отображаются назначенные приемы.</p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-secondary doctor-calendar-nav" data-direction="prev" type="button">Назад</button>
                    <button class="btn btn-outline-secondary doctor-calendar-nav" data-direction="today" type="button">Сегодня</button>
                    <button class="btn btn-outline-secondary doctor-calendar-nav" data-direction="next" type="button">Вперед</button>
                </div>
                <div class="btn-group doctor-calendar-switcher" role="group">
                    <button class="btn btn-primary active" data-view="week" type="button">Неделя</button>
                    <button class="btn btn-outline-primary" data-view="month" type="button">Месяц</button>
                </div>
            </div>
        </div>
        <div class="px-4 pt-3">
            <div class="d-flex flex-wrap gap-2 text-muted small mb-3">
                <span class="medclinic-badge medclinic-badge--available">Рабочий день</span>
                <span class="medclinic-badge medclinic-badge--busy">Прием</span>
            </div>
        </div>
        <div class="schedule-calendar px-4 pb-4">
            <div class="schedule-calendar__header">
                <div id="doctorCalendarPeriodLabel" class="schedule-calendar__period"></div>
            </div>
            <div id="doctorCalendarGrid" class="schedule-calendar__grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.doctorScheduleCalendar = {
            events: @Html.Raw(eventsJson),
            schedules: @Html.Raw(schedulesJson),
            overrides: @Html.Raw(overridesJson)
        };
    </script>
    <script src="~/js/doctor-schedule.js" asp-append-version="true"></script>
}
