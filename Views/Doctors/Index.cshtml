@model WebApplication1.ViewModels.Doctors.DoctorsIndexViewModel
@{
    ViewData["Title"] = "Сотрудники";
    ViewData["HideTopbarTitle"] = true;
}

@section Styles {
    <partial name="Partials/_MedclinicStaffStyles" />
}

<div class="mc-staff dashboard-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mc-staff-alert">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mc-staff-alert">@TempData["Error"]</div>
    }

    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">Сотрудники</h1>
                <p class="mc-staff-hero__sub">Пользователи клиники, роли, отделения и специализации.</p>
            </div>
            <div class="mc-staff-hero__actions">
                @if (Model.CanManageStaff)
                {
                    <a asp-controller="Users" asp-action="Create" class="mc-staff-btn mc-staff-btn--primary">Добавить сотрудника</a>
                }
            </div>
        </div>
    </div>

    <div class="mc-staff-panel">
        <form method="get" class="mc-staff-filters">
            <label class="mc-staff-field mc-staff-field--grow">
                <span class="mc-staff-field__label">Поиск</span>
                <input id="search" name="search" value="@Model.Search" class="mc-staff-input" placeholder="Имя, email или телефон" />
            </label>
            <div class="d-flex gap-2">
                <button type="submit" class="mc-staff-btn mc-staff-btn--primary">Найти</button>
                <a asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">Сброс</a>
            </div>
        </form>

        @if (Model.Doctors.Count == 0)
        {
            <div class="mc-staff-empty">В реестре пока нет сотрудников.</div>
        }
        else
        {
            <div class="mc-staff-table-wrap">
                <table class="mc-staff-table">
                    <thead>
                        <tr>
                            <th>Сотрудник</th>
                            <th>Контакты</th>
                            <th>Роли</th>
                            <th>Отделения</th>
                            <th>Специализации</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.Doctors)
                        {
                            <tr>
                                <td><span class="mc-staff-table__name">@doctor.Name</span></td>
                                <td>
                                    <div class="mc-staff-table__name" style="font-size:.84rem;font-weight:600;">@(doctor.Email ?? "—")</div>
                                    <div class="mc-staff-table__muted">@(doctor.Phone ?? "—")</div>
                                </td>
                                <td>
                                    @if (doctor.Roles.Count == 0)
                                    {
                                        <span class="mc-staff-table__muted">Без ролей</span>
                                    }
                                    else
                                    {
                                        <div class="mc-staff-chips">
                                            @foreach (var role in doctor.Roles)
                                            {
                                                <span class="mc-staff-chip mc-staff-chip--role">@role</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (doctor.Departments.Count == 0)
                                    {
                                        <span class="mc-staff-table__muted">—</span>
                                    }
                                    else
                                    {
                                        <div class="mc-staff-chips">
                                            @foreach (var department in doctor.Departments)
                                            {
                                                <span class="mc-staff-chip mc-staff-chip--dept">@department</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (doctor.Specializations.Count == 0)
                                    {
                                        <span class="mc-staff-table__muted">—</span>
                                    }
                                    else
                                    {
                                        <div class="mc-staff-chips">
                                            @foreach (var specialization in doctor.Specializations)
                                            {
                                                <span class="mc-staff-chip mc-staff-chip--spec">@specialization</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="mc-staff-table__actions">
                                        <a asp-action="Appointments" asp-route-id="@doctor.Id" class="mc-staff-btn mc-staff-btn--soft mc-staff-btn--sm">Приёмы</a>
                                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@doctor.Id" class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm">@(Model.CanManageStaff ? "Карточка" : "Просмотр")</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
