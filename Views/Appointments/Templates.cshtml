@model WebApplication1.ViewModels.Appointments.AppointmentTemplatesIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Шаблоны приемов";
    ViewData["HideTopbarTitle"] = true;

    string TemplateTypeLabel(string? type) => (type ?? "").Trim().ToLowerInvariant() switch
    {
        "complaints" => "Жалобы",
        "diagnosis" => "Диагноз",
        "recommendation" or "recommendations" => "Рекомендации",
        "research" => "Направления",
        "comment" or "comments" => "Комментарий",
        _ => string.IsNullOrWhiteSpace(type) ? "—" : type
    };
}

@section Styles {
    <partial name="Partials/_MedclinicCatalogStyles" />
}

<div class="mc-staff dashboard-page">
    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">Шаблоны текста приемов</h1>
                <p class="mc-staff-hero__sub">Отдельная таблица шаблонов для быстрого заполнения карты приема.</p>
            </div>
            <div class="mc-staff-hero__actions">
                <a class="mc-staff-btn mc-staff-btn--ghost" asp-action="Registry">К расписанию</a>
            </div>
        </div>
    </div>

    <div class="mc-staff-templates-grid">
        <div class="mc-staff-panel">
            <h2 class="mc-staff-panel__title">Текущие шаблоны</h2>
            @if (!Model.StorageReady)
            {
                <div class="mc-staff-empty">
                    @(string.IsNullOrWhiteSpace(Model.StorageMessage)
                        ? "Таблица шаблонов пока недоступна."
                        : Model.StorageMessage)
                </div>
            }
            else if (Model.Templates.Count == 0)
            {
                <div class="mc-staff-empty">Шаблонов пока нет.</div>
            }
            else
            {
                <div class="mc-staff-table-wrap">
                    <table class="mc-staff-table">
                        <thead>
                            <tr>
                                <th>Тип</th>
                                <th>Название</th>
                                <th>Порядок</th>
                                <th>Статус</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Templates)
                            {
                                <tr>
                                    <td>@TemplateTypeLabel(item.Type)</td>
                                    <td><span class="mc-staff-table__name">@item.Title</span></td>
                                    <td>@item.SortOrder</td>
                                    <td>
                                        <span class="mc-staff-badge @(item.IsActive ? "mc-staff-badge--active" : "mc-staff-badge--muted")">
                                            @(item.IsActive ? "Активен" : "Выключен")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="mc-staff-table__actions">
                                            <button type="button"
                                                    class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm template-edit-btn"
                                                    data-id="@item.Id"
                                                    data-type="@item.Type"
                                                    data-title="@item.Title"
                                                    data-content-json="@System.Net.WebUtility.HtmlEncode(JsonSerializer.Serialize(item.Content ?? ""))"
                                                    data-sort="@item.SortOrder"
                                                    data-active="@item.IsActive">
                                                Редактировать
                                            </button>
                                            <form method="post" asp-action="DeleteTemplate" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@item.Id" />
                                                <button type="submit"
                                                        class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm"
                                                        onclick="return confirm('Удалить шаблон?')">
                                                    Удалить
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mc-staff-panel mc-staff-form">
            <h2 class="mc-staff-panel__title">Форма шаблона</h2>
            <form method="post" asp-action="SaveTemplate" class="mc-catalog-form vstack gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="templateId" />

                <div>
                    <label class="form-label" for="templateType">Тип</label>
                    <select class="form-select" name="Type" id="templateType" required>
                        <option value="complaints">Жалобы</option>
                        <option value="diagnosis">Диагноз</option>
                        <option value="recommendations">Рекомендации</option>
                        <option value="research">Направления</option>
                        <option value="comment">Комментарий</option>
                    </select>
                </div>
                <div>
                    <label class="form-label" for="templateTitle">Название</label>
                    <input class="form-control" type="text" name="Title" id="templateTitle" maxlength="160" required />
                </div>
                <div>
                    <label class="form-label" for="templateContent">Текст</label>
                    <textarea class="form-control" rows="6" name="Content" id="templateContent" required></textarea>
                </div>
                <div>
                    <label class="form-label" for="templateSortOrder">Порядок</label>
                    <input class="form-control" type="number" min="0" max="10000" name="SortOrder" id="templateSortOrder" value="0" />
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="IsActive" id="templateIsActive" value="true" checked />
                    <label class="form-check-label" for="templateIsActive">Активный шаблон</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="mc-staff-btn mc-staff-btn--primary" data-loading-text="Сохранение...">Сохранить</button>
                    <button type="button" class="mc-staff-btn mc-staff-btn--ghost" id="templateResetBtn">Очистить форму</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="Partials/_MedclinicCatalogScripts" />
    <script>
        (function () {
            const id = document.getElementById("templateId");
            const type = document.getElementById("templateType");
            const title = document.getElementById("templateTitle");
            const content = document.getElementById("templateContent");
            const sort = document.getElementById("templateSortOrder");
            const active = document.getElementById("templateIsActive");
            const resetBtn = document.getElementById("templateResetBtn");
            const buttons = document.querySelectorAll(".template-edit-btn");

            function resetForm() {
                id.value = "";
                type.value = "complaints";
                title.value = "";
                content.value = "";
                sort.value = "0";
                active.checked = true;
            }

            buttons.forEach((btn) => {
                btn.addEventListener("click", function () {
                    id.value = this.dataset.id || "";
                    let typeVal = this.dataset.type || "complaints";
                    if (typeVal === "recommendation") typeVal = "recommendations";
                    if (typeVal === "comments") typeVal = "comment";
                    type.value = typeVal;
                    title.value = this.dataset.title || "";

                    const contentJson = this.getAttribute("data-content-json");
                    if (contentJson) {
                        try {
                            content.value = JSON.parse(contentJson);
                        } catch {
                            content.value = contentJson;
                        }
                    } else {
                        content.value = "";
                    }

                    sort.value = this.dataset.sort || "0";
                    active.checked = (this.dataset.active || "").toLowerCase() === "true";
                });
            });

            resetBtn?.addEventListener("click", resetForm);
        })();
    </script>
}
