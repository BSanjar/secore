@model WebApplication1.ViewModels.Appointments.AppointmentsIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "График";
    
    var isDoctorRole = (bool?)ViewBag.IsDoctorRole == true;
    var canManageAppointments = (bool?)ViewBag.CanManageAppointments == true;
    var canGenerateInvoice = (bool?)ViewBag.CanGenerateInvoice == true;
var eventsJson = JsonSerializer.Serialize(Model.Events.Select(x => new
    {
        id = x.Id,
        title = x.Title,
        doctorId = x.DoctorId,
        doctor = x.Doctor,
        patientId = x.PatientId,
        patientName = x.PatientName,
        phone = x.Phone,
        email = x.Email,
        start = x.Start,
        end = x.End,
        status = x.Status,
        notes = x.Notes,
        referralSource = x.ReferralSource,
        paymentType = x.PaymentType,
        isActive = x.IsActive,
        services = x.Services
    }));
    var patientsJson = JsonSerializer.Serialize(Model.Patients.Select(x => new
    {
        id = x.Id,
        name = x.Name,
        phone = x.Phone,
        email = x.Email,
        whatsApp = x.WhatsApp
    }));
    var serviceCatalogJson = JsonSerializer.Serialize(Model.ServiceCatalog.Select(x => new
    {
        id = x.Id,
        name = x.Name,
        priceTyiyn = x.PriceTyiyn
    }));
    var doctorSchedulesJson = JsonSerializer.Serialize(Model.DoctorSchedules);
    var doctorScheduleOverridesJson = JsonSerializer.Serialize(Model.DoctorScheduleOverrides.Select(x => new
    {
        userId = x.UserId,
        workDate = x.WorkDate,
        isWorking = x.IsWorking,
        startTime = x.StartTime,
        endTime = x.EndTime
    }));
    var departmentsJson = JsonSerializer.Serialize(Model.Departments.Select(x => new
    {
        value = x.Value,
        label = x.Label
    }));
    var doctorFiltersJson = JsonSerializer.Serialize(Model.DoctorFilters.Select(x => new
    {
        value = x.Value,
        label = x.Label,
        departmentIds = x.DepartmentIds
    }));
}

@section Styles {
    <link rel="stylesheet" href="~/css/medclinic-schedule.css" asp-append-version="true" />
}

<div class="dashboard-page">
    @if (!string.IsNullOrWhiteSpace(Model.StorageMessage))
    {
        <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            @Model.StorageMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.DoctorSchedulesMessage))
    {
        <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            @Model.DoctorSchedulesMessage
        </div>
    }

    @if (!isDoctorRole)
    {
    <div class="medclinic-surface p-3 mb-4">
        <div class="appointments-filterbar">
            <div class="appointments-filterbar__item">
                <div class="appointments-multiselect" data-filter-root="departments">
                    <div class="appointments-multiselect__label">Отделения</div>
                    <button type="button" class="appointments-multiselect__trigger" id="appointmentsDepartmentsTrigger" data-filter-toggle="departments" aria-expanded="false">
                        <span id="appointmentsDepartmentsSummary">Выбраны все</span>
                        <span class="appointments-multiselect__chevron">▾</span>
                    </button>
                    <div class="appointments-multiselect__menu" id="appointmentsDepartmentsMenu" hidden>
                        <div class="appointments-multiselect__search">
                            <input type="search" class="form-control" id="appointmentsDepartmentSearch" placeholder="Поиск отделения" />
                        </div>
                        <div class="appointments-multiselect__actions">
                            <button type="button" class="btn btn-sm btn-link" id="appointmentsSelectAllDepartments">Выбрать все</button>
                        </div>
                        <div class="filter-list" id="appointmentsDepartmentsList"></div>
                    </div>
                </div>
            </div>
            <div class="appointments-filterbar__item">
                <div class="appointments-multiselect" data-filter-root="doctors">
                    <div class="appointments-multiselect__label">Сотрудники</div>
                    <button type="button" class="appointments-multiselect__trigger" id="appointmentsDoctorsTrigger" data-filter-toggle="doctors" aria-expanded="false">
                        <span id="appointmentsDoctorsSummary">Выбраны все</span>
                        <span class="appointments-multiselect__chevron">▾</span>
                    </button>
                    <div class="appointments-multiselect__menu" id="appointmentsDoctorsMenu" hidden>
                        <div class="appointments-multiselect__search">
                            <input type="search" class="form-control" id="appointmentsDoctorSearch" placeholder="Поиск сотрудника" />
                        </div>
                        <div class="appointments-multiselect__actions">
                            <button type="button" class="btn btn-sm btn-link" id="appointmentsSelectAllDoctors">Выбрать все</button>
                        </div>
                        <div class="filter-list" id="appointmentsDoctorsList"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    <div class="medclinic-surface schedule-board">
        <div class="p-4 border-bottom appointments-calendar-toolbar">
            <div class="appointments-calendar-toolbar__left">
                <div>
                    <h2 class="h5 mb-1">Календарь приемов</h2>
                    <p class="text-muted mb-0">Расписание учитывает рабочее время врача и особые дни по конкретным датам.</p>
                </div>
                <div id="appointmentsAnchorStrip" class="appointments-anchor-strip"></div>
                <div id="appointmentsQuickCards" class="appointments-quick-cards"></div>
            </div>
            <div class="appointments-calendar-toolbar__right">
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-secondary schedule-nav" data-direction="prev" type="button">Назад</button>
                    <button class="btn btn-outline-secondary schedule-nav" data-direction="today" type="button">Сегодня</button>
                    <button class="btn btn-outline-secondary schedule-nav" data-direction="next" type="button">Вперед</button>
                </div>
                <div class="btn-group schedule-view-switcher" role="group">
                    <button class="btn btn-primary active" data-view="week" type="button">Неделя</button>
                    <button class="btn btn-outline-primary" data-view="month" type="button">Месяц</button>
                </div>
            </div>
        </div>

        <div class="px-4 pt-3">
            <div class="d-flex flex-wrap gap-2 text-muted small mb-3">
                <span class="medclinic-badge medclinic-badge--busy">Прием</span>
                <span class="medclinic-badge medclinic-badge--available">Свободно</span>
            </div>
        </div>

        <div class="schedule-calendar px-4 pb-4">
            <div class="schedule-calendar__header">
                <div id="schedulePeriodLabel" class="schedule-calendar__period"></div>
            </div>
            <div id="scheduleCalendarGrid" class="schedule-calendar__grid"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="appointmentPeriodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h4 mb-1" id="appointmentPeriodModalTitle">Приемы за период</h2>
                    <p class="text-muted mb-0" id="appointmentPeriodModalSubtitle">Все записи за выбранный период.</p>
                </div>
                @if (canManageAppointments)
                {
                    <button type="button" class="btn btn-outline-primary" id="appointmentPeriodAddButton">Добавить новый прием</button>
                }
            </div>
            <div class="modal-body">
                <div id="appointmentPeriodList" class="vstack gap-3"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="appointmentDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h4 mb-1" id="appointmentDetailsTitle">Просмотр приема</h2>
                    <p class="text-muted mb-0" id="appointmentDetailsSubtitle">Детали записи пациента.</p>
                </div>
                @if (canManageAppointments)
                {
                    <button type="button" class="btn btn-outline-primary" id="appointmentDetailsEditButton">Редактировать</button>
                }
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="editor-block h-100">
                            <h3 class="editor-block__title">Пациент</h3>
                            <dl class="details-list mb-0">
                                <dt>ФИО</dt>
                                <dd id="appointmentDetailsPatient">—</dd>
                                <dt>Телефон</dt>
                                <dd id="appointmentDetailsPhone">—</dd>
                                <dt>Email</dt>
                                <dd id="appointmentDetailsEmail">—</dd>
                            </dl>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="editor-block h-100">
                            <h3 class="editor-block__title">Прием</h3>
                            <dl class="details-list mb-0">
                                <dt>Врач</dt>
                                <dd id="appointmentDetailsDoctor">—</dd>
                                <dt>Дата и время</dt>
                                <dd id="appointmentDetailsDateTime">—</dd>
                                <dt>Статус</dt>
                                <dd id="appointmentDetailsStatus">—</dd>
                                <dt>Тип оплаты</dt>
                                <dd id="appointmentDetailsPaymentType">—</dd>
                                <dt>Реферал</dt>
                                <dd id="appointmentDetailsReferral">—</dd>
                            </dl>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="editor-block">
                            <h3 class="editor-block__title">Комментарий</h3>
                            <div id="appointmentDetailsNotes" class="text-muted">—</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="editor-block">
                            <h3 class="editor-block__title">Услуги</h3>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                    <tr>
                                        <th>Услуга</th>
                                        <th>Стоимость</th>
                                        <th>Кол-во</th>
                                    </tr>
                                    </thead>
                                    <tbody id="appointmentDetailsServices"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <span class="text-muted small" id="appointmentDetailsFooterHint">Из просмотра можно сразу перейти к редактированию записи.</span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Закрыть</button>
                    @if (canGenerateInvoice)
                    {
                        <button type="button" class="btn btn-primary" id="appointmentGenerateInvoiceButton">Счет на оплату</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="appointmentEditorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h4 mb-1">Запись пациента</h2>
                    <p class="text-muted mb-0">Введите пациента, выберите врача, время и набор услуг.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning small" id="appointmentScheduleHint" style="display:none;"></div>
                <form id="appointmentForm" class="row g-4" autocomplete="off">
                    <input type="hidden" id="appointmentId" />
                    <input type="hidden" id="appointmentPatientId" />
                    <select id="appointmentPatient" class="d-none" tabindex="-1" aria-hidden="true">
                        <option value=""></option>
                        @foreach (var patient in Model.Patients)
                        {
                            <option value="@patient.Id">@patient.Name</option>
                        }
                    </select>

                    <div class="col-lg-6">
                        <div class="editor-block">
                            <h3 class="editor-block__title">Пациент</h3>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">ФИО пациента</label>
                                    <div class="patient-lookup">
                                        <input id="appointmentPatientName" class="form-control" placeholder="Начните вводить ФИО пациента" />
                                        <div id="appointmentPatientLookupState" class="form-text">Если пациент уже есть в базе, выберите его из подсказок. Иначе он будет создан при сохранении записи.</div>
                                        <div id="appointmentPatientSuggestions" class="patient-lookup__suggestions list-group" style="display:none;"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Телефон</label>
                                    <input id="appointmentPhone" class="form-control" placeholder="+996..." />
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" id="appointmentUsePhoneAsWhatsApp" checked />
                                        <label class="form-check-label" for="appointmentUsePhoneAsWhatsApp">Дублировать этот номер как WhatsApp</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input id="appointmentEmail" class="form-control" placeholder="patient@example.com" />
                                    <div class="form-text">Необязательное поле.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Комментарий</label>
                                    <textarea id="appointmentComment" class="form-control" rows="3" placeholder="Жалобы, запрос, краткая история обращения"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="editor-block">
                            <h3 class="editor-block__title">Параметры приема</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Врач</label>
                                    <select id="appointmentDoctor" class="form-select">
                                        <option value="">Не выбран</option>
                                        @foreach (var doctor in Model.Doctors)
                                        {
                                            <option value="@doctor.Value">@doctor.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Дата приема</label>
                                    <input id="appointmentDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Время начала</label>
                                    <input id="appointmentStart" type="time" class="form-control" value="09:00" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Время окончания</label>
                                    <input id="appointmentEnd" type="time" class="form-control" value="09:30" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label d-block">Быстрый выбор слота</label>
                                    <div class="slot-buttons" id="appointmentSlotButtons"></div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Реферал</label>
                                    <input id="appointmentReferral" class="form-control" placeholder="Источник / врач" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Тип оплаты</label>
                                    <select id="appointmentPaymentType" class="form-select">
                                        <option value="cash">Наличные</option>
                                        <option value="card">Карта</option>
                                        <option value="online">Онлайн</option>
                                        <option value="insurance">Страховка</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Статус</label>
                                    <select id="appointmentStatus" class="form-select">
                                        <option value="active">Новая</option>
                                        <option value="confirmed">Подтверждена</option>
                                        <option value="busy">Занята</option>
                                        <option value="completed">Завершена</option>
                                        <option value="cancelled">Отменена</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="appointmentIsActive" checked />
                                        <label class="form-check-label" for="appointmentIsActive">Запись активна</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="editor-block">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                                <h3 class="editor-block__title mb-0">Услуги</h3>
                                <div class="d-flex gap-2 align-items-center">
                                    <select id="appointmentServiceSelector" class="form-select">
                                        <option value="">Добавить услугу</option>
                                        @foreach (var service in Model.ServiceCatalog)
                                        {
                                            <option value="@service.Id">@service.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                    <tr>
                                        <th>Услуга</th>
                                        <th>Стоимость</th>
                                        <th style="width: 110px;">Кол-во</th>
                                        <th class="text-end">Действие</th>
                                    </tr>
                                    </thead>
                                    <tbody id="appointmentServicesTable">
                                    <tr class="appointment-services-empty">
                                        <td colspan="4" class="text-center text-muted py-4">Пока услуги не выбраны.</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <span class="text-muted small">Если у врача не настроена смена, запись на прием будет недоступна.</span>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" class="btn btn-primary" id="appointmentSaveButton" @(Model.StorageReady ? null : "disabled")>Сохранить запись</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.medclinicSchedule = {
            events: @Html.Raw(eventsJson),
            patients: @Html.Raw(patientsJson),
            serviceCatalog: @Html.Raw(serviceCatalogJson),
            doctorSchedules: @Html.Raw(doctorSchedulesJson),
            doctorScheduleOverrides: @Html.Raw(doctorScheduleOverridesJson),
            departments: @Html.Raw(departmentsJson),
            doctorFilters: @Html.Raw(doctorFiltersJson),
            saveUrl: '@Url.Action("Save", "Appointments")',
            generateInvoiceUrl: '@Url.Action("GenerateInvoice", "Appointments")',
            storageReady: @Json.Serialize(Model.StorageReady),
            doctorSchedulesReady: @Json.Serialize(Model.DoctorSchedulesReady),
            canManageAppointments: @Json.Serialize(canManageAppointments),
            canGenerateInvoice: @Json.Serialize(canGenerateInvoice)
        };
    </script>
    <script src="~/js/medclinic-schedule.js" asp-append-version="true"></script>
    <script src="~/js/medclinic-appointments-enhancements.js" asp-append-version="true"></script>
}


