@model WebApplication1.ViewModels.Appointments.AppointmentsIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Расписание записей";
    var canManageAppointments = (bool?)ViewBag.CanManageAppointments == true;
    var canGenerateInvoice = (bool?)ViewBag.CanGenerateInvoice == true;
    var canMarkAsPaidManually = (bool?)ViewBag.CanMarkAsPaidManually == true;
    var totalAppointments = Model.Events.Count;
    var todayDate = DateTime.Today;
    var todayAppointments = Model.Events.Count(x => x.Start.Date == todayDate);
    var todayDayOfWeek = (int)todayDate.DayOfWeek;
    var mondayOffset = (todayDayOfWeek + 6) % 7;
    var weekStart = todayDate.AddDays(-mondayOffset);
    var weekEnd = weekStart.AddDays(7);
    var weekAppointments = Model.Events.Count(x => x.Start >= weekStart && x.Start < weekEnd);
    var eventsJson = JsonSerializer.Serialize(Model.Events.Select(x => new { id = x.Id, title = x.Title, doctorId = x.DoctorId, doctor = x.Doctor, patientId = x.PatientId, patientName = x.PatientName, phone = x.Phone, email = x.Email, start = x.Start, end = x.End, status = x.Status, notes = x.Notes, referralSource = x.ReferralSource, paymentType = x.PaymentType, hasPaidInvoice = x.HasPaidInvoice, isActive = x.IsActive, createdAt = x.CreatedAt, updatedAt = x.UpdatedAt, services = x.Services }));
    var patientsJson = JsonSerializer.Serialize(Model.Patients.Select(x => new { id = x.Id, name = x.Name, phone = x.Phone, email = x.Email, whatsApp = x.WhatsApp }));
    var serviceCatalogJson = JsonSerializer.Serialize(Model.ServiceCatalog.Select(x => new { id = x.Id, name = x.Name, priceTyiyn = x.PriceTyiyn }));
    var doctorSchedulesJson = JsonSerializer.Serialize(Model.DoctorSchedules);
    var doctorScheduleOverridesJson = JsonSerializer.Serialize(Model.DoctorScheduleOverrides.Select(x => new { userId = x.UserId, workDate = x.WorkDate, isWorking = x.IsWorking, startTime = x.StartTime, endTime = x.EndTime }));
    var appointmentDurationsJson = JsonSerializer.Serialize(Model.AppointmentDurations.Select(x => new { doctorId = x.UserId, durationMinutes = x.DurationMinutes }));
    var departmentsJson = JsonSerializer.Serialize(Model.Departments.Select(x => new { value = x.Value, label = x.Label }));
    var doctorFiltersJson = JsonSerializer.Serialize(Model.DoctorFilters.Select(x => new { value = x.Value, label = x.Label, departmentIds = x.DepartmentIds }));
    var medicalTemplatesJson = JsonSerializer.Serialize(Model.MedicalTemplates.Select(x => new { id = x.Id, type = x.Type, title = x.Title, content = x.Content, sortOrder = x.SortOrder }));
}

@section Styles {
    <link rel="stylesheet" href="~/web/medclinic/css/medclinic-schedule.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/medclinic/css/appointments-role-layouts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/medclinic/css/medclinic-appointment-create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/medclinic/css/medclinic-appointment-details.css" asp-append-version="true" />
}

<div class="dashboard-page appointments-page registry-appointments-page registry-v2-page">
    @if (!string.IsNullOrWhiteSpace(Model.StorageMessage))
    {
        <div class="alert alert-warning border-0 shadow-sm mb-3" role="alert">@Model.StorageMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.DoctorSchedulesMessage))
    {
        <div class="alert alert-warning border-0 shadow-sm mb-3" role="alert">@Model.DoctorSchedulesMessage</div>
    }

    <section class="registry-v2-toolbar" aria-label="Фильтры расписания">
        <div class="registry-v2-toolbar__grid">
            <div class="registry-v2-period">
                <div class="registry-v2-period__shell">
                    <button type="button" class="registry-v2-period__icon-btn schedule-nav" data-direction="prev" title="Предыдущий день" aria-label="Предыдущий день">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="registry-v2-month-popover-wrap">
                        <button type="button" class="registry-v2-date-core" id="scheduleDateCore" aria-expanded="false" aria-controls="scheduleDatePanel" aria-haspopup="dialog" title="Выберите дату">
                            <span class="registry-v2-date-core__weekday" id="registryFilterWeekday"></span>
                            <span class="registry-v2-date-core__date" id="registryFilterDate"></span>
                            <span class="registry-v2-date-core__month" id="scheduleMonthLabel"></span>
                        </button>
                        <div class="registry-v2-date-panel" id="scheduleDatePanel" hidden role="dialog" aria-label="Выбор даты">
                            <div class="registry-v2-date-panel__year">
                                <button type="button" class="registry-v2-month-panel__year-btn" id="scheduleYearPrev" aria-label="Предыдущий год">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                                <span class="registry-v2-month-panel__year-value" id="scheduleYearLabel"></span>
                                <button type="button" class="registry-v2-month-panel__year-btn" id="scheduleYearNext" aria-label="Следующий год">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>
                            <div class="registry-v2-month-panel__grid" id="scheduleMonthGrid" role="listbox" aria-label="Месяц"></div>
                            <div class="registry-v2-date-panel__weekdays" aria-hidden="true">
                                <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span>
                            </div>
                            <div class="registry-v2-date-panel__days" id="scheduleDayGrid" role="grid" aria-label="Число"></div>
                        </div>
                    </div>
                    <button type="button" class="registry-v2-period__icon-btn schedule-nav" data-direction="next" title="Следующий день" aria-label="Следующий день">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <button type="button" class="registry-v2-period__today schedule-nav" data-direction="today">Сегодня</button>
                    <span class="registry-v2-period__sep" aria-hidden="true"></span>
                    <button type="button" class="registry-v2-period__icon-btn registry-v2-period__icon-btn--sm" id="scheduleMonthPrev" title="Предыдущий месяц" aria-label="Предыдущий месяц">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <button type="button" class="registry-v2-period__icon-btn registry-v2-period__icon-btn--sm" id="scheduleMonthNext" title="Следующий месяц" aria-label="Следующий месяц">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
            </div>

            <div class="registry-v2-filter-field">
                <label class="registry-v2-filter-field__label" for="registryDepartmentSelect">Отделение</label>
                <select id="registryDepartmentSelect" class="form-select registry-v2-select registry-v2-select--compact" required>
                    @{
                        var deptIdx = 0;
                    }
                    @foreach (var dept in Model.Departments)
                    {
                        var isFirstDept = deptIdx++ == 0;
                        if (isFirstDept)
                        {
                            <option value="@dept.Value" selected="selected">@dept.Label</option>
                        }
                        else
                        {
                            <option value="@dept.Value">@dept.Label</option>
                        }
                    }
                </select>
            </div>

            <div class="registry-v2-filter-field">
                <label class="registry-v2-filter-field__label" for="registryDoctorSelect">Врач</label>
                <select id="registryDoctorSelect" class="form-select registry-v2-select registry-v2-select--compact" required disabled></select>
            </div>
        </div>

        <div class="registry-v2-toolbar__foot">
            <div class="registry-v2-stats registry-v2-stats--inline" aria-label="Сводка">
                <span class="registry-v2-stat-inline"><strong>@totalAppointments</strong> всего</span>
                <span class="registry-v2-stat-inline"><strong>@todayAppointments</strong> сегодня</span>
                <span class="registry-v2-stat-inline"><strong>@weekAppointments</strong> на неделе</span>
            </div>
            <div class="registry-v2-legend registry-v2-legend--compact">
                <span class="registry-v2-legend__item"><span class="dot dot-green"></span> Оплачено</span>
                <span class="registry-v2-legend__item"><span class="dot dot-amber"></span> Не оплачено</span>
                <span class="registry-v2-legend__item"><span class="registry-v2-legend__free"></span> Свободно</span>
            </div>
        </div>
    </section>

    <section class="registry-v2-schedule" aria-label="Расписание">
        <div class="registry-v2-schedule__card">
            <div class="registry-v2-schedule__head">
                <p class="registry-v2-schedule__doctor" id="registryScheduleDoctorCaption"></p>
                <span class="registry-v2-schedule__badge" id="registryScheduleDayCount" hidden></span>
            </div>
            <div id="gridView" class="registry-v2-grid"></div>
        </div>
    </section>
</div>

<div class="modal fade" id="appointmentPeriodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg doctor-modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title mb-1" id="appointmentPeriodModalTitle">Приемы за период</h2>
                    <p class="text-muted mb-0" id="appointmentPeriodModalSubtitle">Все записи за выбранный период.</p>
                </div>
                <div class="doctor-modal-header-actions">
                    @if (canManageAppointments)
                    {
                        <button type="button" class="btn ghost-btn" id="appointmentPeriodAddButton">Добавить запись</button>
                    }
                    <button type="button" class="btn doctor-modal-close" data-bs-dismiss="modal" aria-label="Close">×</button>
                </div>
            </div>
            <div class="modal-body">
                <div id="appointmentPeriodList" class="vstack gap-3"></div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_AppointmentDetailsModal")
@await Html.PartialAsync("_AppointmentEditorModal", Model)
@await Html.PartialAsync("_AppointmentRescheduleModal")

<div class="modal fade" id="mcConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mc-confirm-dialog">
        <div class="modal-content border-0 shadow-lg mc-confirm-modal">
            <div class="modal-body mc-confirm-modal__body text-center">
                <div class="mc-confirm-modal__icon" aria-hidden="true">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16" r="1" fill="currentColor"/></svg>
                </div>
                <h2 class="mc-confirm-modal__title" id="mcConfirmModalTitle">Подтверждение</h2>
                <p class="mc-confirm-modal__message" id="mcConfirmModalMessage"></p>
                <div class="mc-confirm-modal__details" id="mcConfirmModalDetails"></div>
            </div>
            <div class="modal-footer border-0 mc-confirm-modal__footer justify-content-center gap-2 pb-4 pt-0">
                <button type="button" class="btn mc-confirm-modal__cancel" data-bs-dismiss="modal" id="mcConfirmModalCancel">Отмена</button>
                <button type="button" class="btn mc-confirm-modal__ok" id="mcConfirmModalOk">Подтвердить</button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_McPaidCancelChoiceModal")

@section Scripts {
    <script>
        window.medclinicSchedule = {
            pageType: 'registry',
            events: @Html.Raw(eventsJson),
            patients: @Html.Raw(patientsJson),
            serviceCatalog: @Html.Raw(serviceCatalogJson),
            doctorSchedules: @Html.Raw(doctorSchedulesJson),
            doctorScheduleOverrides: @Html.Raw(doctorScheduleOverridesJson),
            appointmentDurations: @Html.Raw(appointmentDurationsJson),
            medicalTemplates: @Html.Raw(medicalTemplatesJson),
            departments: @Html.Raw(departmentsJson),
            doctorFilters: @Html.Raw(doctorFiltersJson),
            saveUrl: '@Url.Action("Save", "Appointments")',
            cancelUrl: '@Url.Action("Cancel", "Appointments")',
            markPaidUrl: '@Url.Action("MarkPaid", "Appointments")',
            paymentQrUrl: '@Url.Action("GetPaymentQr", "Appointments")',
            appointmentInvoiceUrl: '@Url.Action("GetAppointmentInvoice", "Appointments")',
            sendInvoiceWhatsAppUrl: '@Url.Action("SendInvoiceWhatsApp", "Appointments")',
            generateInvoiceUrl: '@Url.Action("GenerateInvoice", "Appointments")',
            storageReady: @Json.Serialize(Model.StorageReady),
            doctorSchedulesReady: @Json.Serialize(Model.DoctorSchedulesReady),
            canManageAppointments: @Json.Serialize(canManageAppointments),
            canGenerateInvoice: @Json.Serialize(canGenerateInvoice),
            canMarkAsPaidManually: @Json.Serialize(canMarkAsPaidManually)
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js" crossorigin="anonymous"></script>
    <script src="~/web/medclinic/js/medclinic-ui.js" asp-append-version="true"></script>
    <script src="~/web/medclinic/js/medclinic-schedule.js" asp-append-version="true"></script>
    <script src="~/web/medclinic/js/medclinic-appointment-create.js" asp-append-version="true"></script>
    <script src="~/web/medclinic/js/medclinic-appointment-reschedule.js" asp-append-version="true"></script>
    <script src="~/web/medclinic/js/medclinic-appointments-enhancements.js" asp-append-version="true"></script>
}
