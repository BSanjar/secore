@model List<WebApplication1.Models.DBModels.Invoice>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["StandartInvoicesPageTitle"].Value;
}

<div class="invoices-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">@Localizer["StandartInvoicesPageTitle"]</h1>
            <p class="page-subtitle">@Localizer["StandartInvoicesPageSubtitle"]</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary" onclick="openCreateInvoiceModal()">@Localizer["StandartCreateInvoiceButton"]</button>
            <button type="button" class="btn btn-primary" onclick="openCreateOneTimePaymentModal()">@Localizer["StandartCreateOneTimePaymentButton"]</button>
        </div>
    </div>

    <div class="invoices-container">
        @if (TempData["StandartOneTimePaymentError"] is string paymentError && !string.IsNullOrWhiteSpace(paymentError))
        {
            <div class="alert alert-danger" role="alert">@paymentError</div>
        }
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="invoices-table">
                    <thead>
                        <tr>
                            <th>@Localizer["DateCreated"]</th>
                            <th>@Localizer["Client"]</th>
                            <th>@Localizer["ColForServices"]</th>
                            <th>@Localizer["ColAmount"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["Period"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr class="invoice-row">
                                <td class="invoice-date">
                                    @if (invoice.DateCreated.HasValue)
                                    {
                                        @invoice.DateCreated.Value.ToString("dd.MM.yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="invoice-client">
                                    @if (invoice.ClientNavigation != null)
                                    {
                                        <div class="client-info">
                                            <div class="client-name">@invoice.ClientNavigation.ClientName</div>
                                            @if (!string.IsNullOrEmpty(invoice.ClientNavigation.ClientPhone))
                                            {
                                                <div class="client-phone">@invoice.ClientNavigation.ClientPhone</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="invoice-services">
                                    @if (invoice.InvoiceServices != null && invoice.InvoiceServices.Any())
                                    {
                                        <div class="services-labels">
                                            @foreach (var invoiceService in invoice.InvoiceServices)
                                            {
                                                @if (invoiceService.ServiceNavigation != null)
                                                {
                                                    <span class="service-label service-label-@(invoiceService.ServiceNavigation.Id.GetHashCode() % 6)">
                                                        @invoiceService.ServiceNavigation.Name
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Localizer["NoServices"]</span>
                                    }
                                </td>
                                <td class="invoice-amount">
                                    @if (invoice.FixedSumm.HasValue)
                                    {
                                        var amount = invoice.FixedSumm.Value / 100;
                                        <span class="amount-value @(amount < 0 ? "amount-debt" : "")">
                                            @amount.ToString("N2") <span>@Localizer["Som"]</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="invoice-status">
                                    @if (invoice.InvoiceStatus == "actual")
                                    {
                                        <span class="status-badge status-actual">@Localizer["InvoiceStatusActive"]</span>
                                    }
                                    else if (invoice.InvoiceStatus == "closed")
                                    {
                                        <span class="status-badge status-closed">@Localizer["InvoiceStatusClosed"]</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-unknown">@invoice.InvoiceStatus</span>
                                    }
                                </td>
                                <td class="invoice-periodicity">
                                    @if (!string.IsNullOrEmpty(invoice.Periodicity))
                                    {
                                        <span class="periodicity-badge">
                                            @switch (invoice.Periodicity.ToLower())
                                            {
                                                case "daily":
                                                    <text>@Localizer["PeriodDaily"]</text>
                                                    break;
                                                case "weekly":
                                                    <text>@Localizer["PeriodWeekly"]</text>
                                                    break;
                                                case "monthly":
                                                    <text>@Localizer["PeriodMonthly"]</text>
                                                    break;
                                                case "yearly":
                                                    <text>@Localizer["PeriodYearly"]</text>
                                                    break;
                                                case "onetime":
                                                    <text>@Localizer["PeriodOneTime"]</text>
                                                    break;
                                                case "any":
                                                    <text>@Localizer["PeriodAny"]</text>
                                                    break;
                                                default:
                                                    <text>@invoice.Periodicity</text>
                                                    break;
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" fill="currentColor"/>
                    </svg>
                </div>
                <h3 class="empty-state-title">@Localizer["EmptyInvoicesTitle"]</h3>
                <p class="empty-state-description">@Localizer["EmptyInvoicesDescription"]</p>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="createInvoiceModal" tabindex="-1" aria-labelledby="createInvoiceModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createInvoiceModalLabel">@Localizer["CreateInvoiceModalTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body p-0" id="createInvoiceModalBody">
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createOneTimePaymentModal" tabindex="-1" aria-labelledby="createOneTimePaymentModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createOneTimePaymentModalLabel">@Localizer["OneTimePaymentModalTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Close"]"></button>
            </div>
            <div class="modal-body p-0" id="createOneTimePaymentModalBody">
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/web/kindergarten/js/detsad-create-invoice.js" asp-append-version="true"></script>
    <script src="~/web/standart/js/invoices.js" asp-append-version="true"></script>
}

