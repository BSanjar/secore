@model WebApplication1.ViewModels.Cabinet.MedclinicDashboardViewModel
@using WebApplication1.Helpers
@using System.Globalization
@{
    ViewData["Title"] = "Главная";
    var showServiceTerms = AuthorizationHelper.IsAdminRole(Context);
    var todayLabel = char.ToUpper(Model.TodayTitle[0], CultureInfo.GetCultureInfo("ru-RU")) + Model.TodayTitle.Substring(1);
}

@section Styles {
    <link rel="stylesheet" href="~/web/medclinic/css/medclinic-dashboard.css" asp-append-version="true" />
}

<div class="mc-dash">
    <header class="mc-dash-hero">
        <div>
            <p class="mc-dash-hero__eyebrow">Расписание на сегодня</p>
            <h1 class="mc-dash-hero__title">@todayLabel</h1>
            <p class="mc-dash-hero__org">@Model.OrganizationName</p>
        </div>
        @if (Model.ShowNewAppointmentButton && !string.IsNullOrEmpty(Model.NewAppointmentUrl))
        {
            <a class="mc-dash-cta" href="@Model.NewAppointmentUrl">
                <span class="mc-dash-cta__icon" aria-hidden="true">+</span>
                Новая запись
            </a>
        }
    </header>

    <section class="mc-dash-stats" aria-label="Записи на сегодня">
        <article class="mc-dash-stat">
            <div class="mc-dash-stat__label">Записей на сегодня</div>
            <div class="mc-dash-stat__value">@Model.AppointmentsTotalToday</div>
            <p class="mc-dash-stat__hint">Активные приёмы в расписании</p>
        </article>
        <article class="mc-dash-stat mc-dash-stat--accent">
            <div class="mc-dash-stat__label">Принято</div>
            <div class="mc-dash-stat__value">@Model.AppointmentsAcceptedToday</div>
            <p class="mc-dash-stat__hint">Оплачено или закрыто по оплате</p>
        </article>
        <article class="mc-dash-stat mc-dash-stat--warn">
            <div class="mc-dash-stat__label">Ожидают приёма</div>
            <div class="mc-dash-stat__value">@Model.AppointmentsRemainingToday</div>
            <p class="mc-dash-stat__hint">Ещё без оплаты / не приняты</p>
        </article>
    </section>

    <section class="mc-dash-finance" aria-label="Финансы">
        <h2 class="mc-dash-section-title">Финансы</h2>

        @if (Model.CanViewPaymentSums)
        {
            <div class="mc-dash-finance__today">
                <div class="mc-dash-finance__today-value">@Model.TodayTransactionsSumSom.ToString("N2") сом</div>
                <p class="mc-dash-finance__today-label">Поступления за сегодня (по доступным каналам из прав «Дашборд»)</p>
            </div>

            <div class="mc-dash-grid @(showServiceTerms ? "" : "mc-dash-grid--full")">
                <div class="mc-dash-panel">
                    <div class="mc-dash-panel__head">
                        <h3 class="mc-dash-panel__title">Динамика оплат</h3>
                        <p class="mc-dash-panel__sub">Суммы с учётом возвратов и разрешённых каналов</p>
                    </div>
                    <div class="mc-dash-panel__body">
                        <div class="mc-dash-period">
                            <button type="button" class="mc-dash-period__btn active" data-period="week">Неделя</button>
                            <button type="button" class="mc-dash-period__btn" data-period="month">Месяц</button>
                            <button type="button" class="mc-dash-period__btn" data-period="year">Год</button>
                        </div>
                        <div class="mc-dash-chart">
                            <canvas id="medclinicDashboardChart"></canvas>
                        </div>
                    </div>
                </div>

                @if (showServiceTerms)
                {
                    <aside class="mc-dash-panel">
                        <div class="mc-dash-panel__head">
                            <h3 class="mc-dash-panel__title">Условия обслуживания</h3>
                            <p class="mc-dash-panel__sub">Только для администратора</p>
                        </div>
                        <div class="mc-dash-panel__body">
                            <div class="mc-dash-terms-row">
                                <span class="mc-dash-terms-k">Тариф</span>
                                <span class="mc-dash-terms-v">@(Model.HasSubscription ? "Подписка" : "Комиссия по операциям")</span>
                            </div>
                            <div class="mc-dash-terms-row">
                                <span class="mc-dash-terms-k">Статус</span>
                                <span class="mc-dash-terms-v">@Model.BillingStatus</span>
                            </div>
                            <div class="mc-dash-terms-row">
                                <span class="mc-dash-terms-k">Тип комиссии</span>
                                <span class="mc-dash-terms-v">@Model.CommissionKindText</span>
                            </div>
                            <div class="mc-dash-terms-row">
                                <span class="mc-dash-terms-k">Значение</span>
                                <span class="mc-dash-terms-v">@Model.CommissionValueText</span>
                            </div>
                            <div class="mc-dash-terms-row">
                                <span class="mc-dash-terms-k">Модель</span>
                                <span class="mc-dash-terms-v">@Model.CommissionModelName</span>
                            </div>
                        </div>
                    </aside>
                }
            </div>

            <div class="mc-dash-panel">
                <div class="mc-dash-panel__head">
                    <h3 class="mc-dash-panel__title">Платежи</h3>
                    <p class="mc-dash-panel__sub">Последние операции, включая возвраты по доступным каналам</p>
                </div>
                @if (Model.Transactions.Count == 0)
                {
                    <div class="mc-dash-empty">Операций пока нет</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="mc-dash-table">
                            <thead>
                                <tr>
                                    <th>Дата</th>
                                    <th>Пациент</th>
                                    <th>Описание</th>
                                    <th>Тип</th>
                                    <th>Статус</th>
                                    <th>Сумма</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.Transactions)
                                {
                                    <tr>
                                        <td>@(t.TransactionDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                        <td>@t.PatientName</td>
                                        <td>@t.Description</td>
                                        <td>@t.KindLabel</td>
                                        <td>
                                            <span class="mc-dash-badge @(t.IsCredit ? "mc-dash-badge--refund" : "mc-dash-badge--ok")">@t.StatusLabel</span>
                                        </td>
                                        <td class="@(t.IsCredit ? "mc-dash-amount--neg" : "")">@t.AmountSom.ToString("N2") сом</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mc-dash-finance__locked">
                Финансовые блоки скрыты: у роли нет прав категории «Дашборд» (суммы по каналам оплаты).
                Настройте их в <strong>Настройки → Роли → Права</strong>.
            </div>
        }
    </section>
</div>

@if (Model.CanViewPaymentSums)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                var chartWeek = @Html.Raw(Model.ChartWeekJson);
                var chartMonth = @Html.Raw(Model.ChartMonthJson);
                var chartYear = @Html.Raw(Model.ChartYearJson);
                var canvas = document.getElementById('medclinicDashboardChart');
                if (!canvas) return;

                var datasets = {
                    week: { labels: chartWeek.map(function (x) { return x.label; }), values: chartWeek.map(function (x) { return x.value; }) },
                    month: { labels: chartMonth.map(function (x) { return x.label; }), values: chartMonth.map(function (x) { return x.value; }) },
                    year: { labels: chartYear.map(function (x) { return x.label; }), values: chartYear.map(function (x) { return x.value; }) }
                };

                var chart = new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: datasets.week.labels,
                        datasets: [{
                            label: 'Оплаты, сом',
                            data: datasets.week.values,
                            backgroundColor: 'rgba(14, 116, 144, 0.78)',
                            borderRadius: 10,
                            maxBarThickness: 26
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { callback: function (v) { return v + ' сом'; } }
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });

                document.querySelectorAll('.mc-dash-period__btn').forEach(function (button) {
                    button.addEventListener('click', function () {
                        var period = this.dataset.period;
                        if (!period) return;
                        document.querySelectorAll('.mc-dash-period__btn').forEach(function (b) { b.classList.remove('active'); });
                        this.classList.add('active');
                        chart.data.labels = datasets[period].labels;
                        chart.data.datasets[0].data = datasets[period].values;
                        chart.update();
                    });
                });
            })();
        </script>
    }
}
