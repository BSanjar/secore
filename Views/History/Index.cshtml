@model IEnumerable<WebApplication1.Models.DBModels.History>
@{
    ViewData["Title"] = "История";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">История</h1>
        <p class="text-muted small mb-0">Журнал изменений (пользователи, счета)</p>
    </div>
    <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">← К настройкам</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Тип</th>
                    <th>Пользователь</th>
                    <th>Счёт (invoice)</th>
                    <th>Id</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.TypeHistory ?? "—")</td>
                        <td>@(item.UserEditor ?? "—")</td>
                        <td>@(item.Invoice ?? "—")</td>
                        <td class="small text-muted">@(item.Id ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Показано записей: @Model.Count()</p>
}
else
{
    <div class="alert alert-info">Записей в истории пока нет.</div>
    <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary">← К настройкам</a>
}
