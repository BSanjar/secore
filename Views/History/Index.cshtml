@model IEnumerable<WebApplication1.Models.DBModels.History>
@{
    ViewData["Title"] = "История";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-soft.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">Настройки</a>
        <span class="breadcrumb-sep">/</span>
        <span>История</span>
    </nav>

    <div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="page-title">История</h1>
            <p class="page-subtitle mb-0">Журнал изменений (пользователи, счета)</p>
        </div>
        <a asp-controller="Settings" asp-action="Index" class="detsad-btn-secondary">← К настройкам</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="dashboard-table-card">
            <div class="table-wrap">
                <table class="table-soft">
                    <thead>
                        <tr>
                            <th>Тип</th>
                            <th>Пользователь</th>
                            <th>Счёт (invoice)</th>
                            <th>Id</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="cell-name">@(item.TypeHistory ?? "—")</td>
                                <td>@(item.UserEditor ?? "—")</td>
                                <td class="cell-muted">@(item.Invoice ?? "—")</td>
                                <td class="cell-muted small">@(item.Id ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="settings-meta mb-0">Показано записей: @Model.Count()</p>
    }
    else
    {
        <div class="empty-state-settings">
            <p class="mb-0">Записей в истории пока нет.</p>
            <a asp-controller="Settings" asp-action="Index" class="detsad-btn-secondary mt-3 d-inline-flex">← К настройкам</a>
        </div>
    }
</div>
