@model IEnumerable<WebApplication1.Models.DBModels.Permission>
@{
    ViewData["Title"] = "Права доступа";
}

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="h2 mb-1">Права доступа</h1>
        <p class="text-muted small mb-0">Справочник прав, которые можно назначать ролям.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            К настройкам
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            Создать новое право
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Название</th>
                            <th>Код</th>
                            <th>Категория</th>
                            <th>Описание</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permission in Model)
                        {
                            <tr>
                                <td>@permission.Name</td>
                                <td><code>@permission.Code</code></td>
                                <td>@permission.Category</td>
                                <td>@permission.Description</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@permission.Id" class="btn btn-outline-warning">
                                            Редактировать
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@permission.Id" class="btn btn-outline-danger">
                                            Удалить
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Права доступа не найдены. <a asp-action="Create">Создайте первое право</a>.
    </div>
}