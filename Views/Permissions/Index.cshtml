@model IEnumerable<WebApplication1.Models.DBModels.Permission>
@{
    ViewData["Title"] = "Управление правами";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Управление правами доступа</h2>
        <a asp-action="Create" class="btn btn-primary">Создать новое право</a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Код</th>
                        <th>Категория</th>
                        <th>Описание</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var permission in Model)
                    {
                        <tr>
                            <td>@permission.Name</td>
                            <td><code>@permission.Code</code></td>
                            <td>@permission.Category</td>
                            <td>@permission.Description</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@permission.Id" class="btn btn-sm btn-warning">Редактировать</a>
                                <a asp-action="Delete" asp-route-id="@permission.Id" class="btn btn-sm btn-danger">Удалить</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Права доступа не найдены. <a asp-action="Create">Создайте первое право</a>.
        </div>
    }
</div>

