@model IEnumerable<WebApplication1.Models.DBModels.Permission>
@{
    ViewData["Title"] = "Права доступа";
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage settings-list-page">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">Настройки</a>
        <span class="breadcrumb-sep">/</span>
        <span>Права доступа</span>
    </nav>

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="page-title mb-0">Права доступа</h1>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Settings" asp-action="Index" class="detsad-btn-secondary">← К настройкам</a>
            <a asp-action="Create" class="detsad-btn-primary">Создать право</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="dashboard-table-card">
            <div class="table-wrap">
                <table class="table-soft">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Код</th>
                            <th>Категория</th>
                            <th>Описание</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permission in Model)
                        {
                            <tr>
                                <td class="cell-name">@permission.Name</td>
                                <td class="cell-muted"><code class="small">@permission.Code</code></td>
                                <td class="cell-muted">@(permission.Category ?? "—")</td>
                                <td class="cell-muted">@(permission.Description ?? "—")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@permission.Id" class="btn btn-outline-secondary">Детали</a>
                                        <a asp-action="Edit" asp-route-id="@permission.Id" class="btn btn-outline-warning">Изменить</a>
                                        <a asp-action="Delete" asp-route-id="@permission.Id" class="btn btn-outline-danger">Удалить</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state-settings">
            <p class="mb-0">Права не найдены.</p>
            <a asp-action="Create" class="detsad-btn-primary mt-3 d-inline-flex">Создать первое право</a>
        </div>
    }
</div>
