@model WebApplication1.Models.DBModels.Permission
@{
    ViewData["Title"] = "Удалить право";
}

<div class="container mt-4">
    <h2>Удалить право доступа</h2>
    <hr />

    <h3>Вы уверены, что хотите удалить это право?</h3>
    <div>
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">Код</dt>
            <dd class="col-sm-10"><code>@Model.Code</code></dd>

            <dt class="col-sm-2">Категория</dt>
            <dd class="col-sm-10">@Model.Category</dd>

            <dt class="col-sm-2">Описание</dt>
            <dd class="col-sm-10">@Model.Description</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>

