@model WebApplication1.Dtos.LoginViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Login"].Value;
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName" class="login-page-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SECORE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-lang-wrap">
        @await Html.PartialAsync("_LanguageSwitcher")
    </div>

    <div class="login-shell">
        <section class="login-showcase">
            <div>
                <div class="login-brand">
                    <img src="~/web/kindergarten/img/secore-logo.png" alt="SECORE Software Development" class="login-brand-logo" asp-append-version="true" />
                    <div class="login-brand-text">
                        <strong>SECORE</strong>
                        <span>@Localizer["LoginBrandTagline"]</span>
                    </div>
                </div>

                <div class="login-hero">
                    <div class="login-eyebrow">@Localizer["LoginHeroEyebrow"]</div>
                    <h1>@Localizer["LoginHeroTitle"]</h1>
                    <p>@Localizer["LoginHeroParagraph"]</p>

                    <div class="login-mini-cards">
                        <div class="login-mini-card">
                            <span class="login-mini-label">@Localizer["LoginMiniAccessLabel"]</span>
                            <div class="login-mini-value">24/7</div>
                            <div class="login-mini-meta"><strong>@Localizer["LoginMiniAccessBadge"]</strong> @Localizer["LoginMiniAccessMeta"]</div>
                        </div>
                        <div class="login-mini-card">
                            <span class="login-mini-label">@Localizer["LoginMiniSecurityLabel"]</span>
                            <div class="login-mini-value">99.9%</div>
                            <div class="login-mini-meta"><strong>@Localizer["LoginMiniSecurityBadge"]</strong> @Localizer["LoginMiniSecurityMeta"]</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="login-panel-wrap">
            <div class="login-panel">
                <div class="panel-top">
                    <span class="small">@Localizer["Login"]</span>
                    <h2>@Localizer["LoginPanelHeading"]</h2>
                    <p>@Localizer["LoginPanelIntro"]</p>
                </div>

                <form asp-action="Login" method="post" class="login-auth-form">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="field">
                        <label class="field-label" asp-for="Email">@Localizer["Email"]</label>
                        <div class="input-wrap">
                          
                            <input asp-for="Email" class="input" type="email" placeholder="@Localizer["Email"]" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label class="field-label" asp-for="Password">@Localizer["Password"]</label>
                        <div class="input-wrap">
                           
                            <input asp-for="Password" class="input" type="password" placeholder="@Localizer["Password"]" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="row-between">
                        <label class="checkbox">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>@Localizer["RememberMe"]</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-primary" id="loginSubmitBtn" data-loading-text="@Localizer["SignIn"]...">@Localizer["SignIn"]</button>
                </form>
            </div>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            var form = document.querySelector('.login-auth-form');
            var btn = document.getElementById('loginSubmitBtn');
            if (!form || !btn) return;
            form.addEventListener('submit', function () {
                if (btn.classList.contains('is-loading')) return;
                btn.classList.add('is-loading');
                btn.disabled = true;
                var label = btn.getAttribute('data-loading-text') || 'Вход...';
                btn.innerHTML = '<span class="login-btn-spinner" aria-hidden="true"></span><span>' + label + '</span>';
            });
        })();
    </script>
</body>
</html>
