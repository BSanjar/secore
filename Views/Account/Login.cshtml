@model WebApplication1.Dtos.LoginViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Login"].Value;
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName" class="login-page-root">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SECORE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-lang-wrap">
        @await Html.PartialAsync("_LanguageSwitcher")
    </div>

    <div class="login-shell">
        <section class="login-showcase">
            <div>
                <div class="login-brand">
                    <div class="login-brand-mark">S</div>
                    <div class="login-brand-text">
                        <strong>SECORE</strong>
                        <span>Service Ecosystem for Commerce, Organizations and Reporting Engine</span>
                    </div>
                </div>

                <div class="login-hero">
                    <div class="login-eyebrow">Secure access portal</div>
                    <h1>Управляйте платежами в едином рабочем пространстве</h1>
                    <p>Войдите в систему для доступа к клиентской базе, услугам, платежам, транзакциям и отчетам. Безопасная авторизация и удобный интерфейс для ежедневной работы организации с клиентами.</p>

                    <div class="login-mini-cards">
                        <div class="login-mini-card">
                            <span class="login-mini-label">Доступ к системе</span>
                            <div class="login-mini-value">24/7</div>
                            <div class="login-mini-meta"><strong>Active</strong> стабильный доступ</div>
                        </div>
                        <div class="login-mini-card">
                            <span class="login-mini-label">Безопасность</span>
                            <div class="login-mini-value">99.9%</div>
                            <div class="login-mini-meta"><strong>Safe</strong> защищённая авторизация</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="login-panel-wrap">
            <div class="login-panel">
                <div class="panel-top">
                    <span class="small">@Localizer["Login"]</span>
                    <h2>Вход в SECORE</h2>
                    <p>Введите email и пароль для доступа к системе.</p>
                </div>

                <form asp-action="Login" method="post" class="login-auth-form">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="field">
                        <label class="field-label" asp-for="Email">@Localizer["Email"]</label>
                        <div class="input-wrap">
                          
                            <input asp-for="Email" class="input" type="email" placeholder="@Localizer["Email"]" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label class="field-label" asp-for="Password">@Localizer["Password"]</label>
                        <div class="input-wrap">
                           
                            <input asp-for="Password" class="input" type="password" placeholder="@Localizer["Password"]" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="row-between">
                        <label class="checkbox">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>@Localizer["RememberMe"]</span>
                        </label>
                    </div>

                    <button type="submit" class="btn-primary">@Localizer["SignIn"]</button>
                </form>
            </div>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
