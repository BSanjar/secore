@model WebApplication1.Dtos.SpecializationUpsertDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Редактирование специализации";
    ViewData["HideTopbarTitle"] = true;
    var departments = ViewBag.Departments as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var services = ViewBag.Services as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

@section Styles {
    <partial name="Partials/_MedclinicCatalogStyles" />
}

<div class="mc-staff dashboard-page">
    <nav class="mc-staff-breadcrumb" aria-label="Навигация">
        <a asp-action="Index">Специализации</a>
        <span class="mc-staff-breadcrumb__sep">›</span>
        <span>@Model.Name</span>
    </nav>

    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">@Model.Name</h1>
                <p class="mc-staff-hero__sub">Обновление профиля врача или направления приема.</p>
            </div>
            <div class="mc-staff-hero__actions">
                <a class="mc-staff-btn mc-staff-btn--ghost" asp-action="Index">Назад к списку</a>
            </div>
        </div>
    </div>

    <div class="mc-staff-panel mc-staff-form">
        <form method="post" class="mc-catalog-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mc-staff-alert py-2 px-3 small mc-staff-validation-summary"></div>
            <div class="mc-staff-form-grid">
                <div>
                    <label asp-for="Name" class="form-label">Название</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="DepartmentId" class="form-label">Отделение</label>
                    <select asp-for="DepartmentId" asp-items="departments" class="form-select"></select>
                    <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="SortOrder" class="form-label">Порядок</label>
                    <input asp-for="SortOrder" class="form-control" />
                </div>
                <div class="d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Активно</label>
                    </div>
                </div>
                <div style="grid-column:1/-1;">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div style="grid-column:1/-1;">
                    <label asp-for="ServiceIds" class="form-label">Услуги для специализации</label>
                    <select asp-for="ServiceIds" asp-items="services" class="form-select" multiple size="8"></select>
                    <div class="mc-staff-hint">При сохранении обновится список услуг для этой специализации.</div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="mc-staff-btn mc-staff-btn--primary" data-loading-text="Сохранение...">Сохранить</button>
                <a class="mc-staff-btn mc-staff-btn--ghost" asp-action="Index">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="Partials/_MedclinicCatalogScripts" />
}
