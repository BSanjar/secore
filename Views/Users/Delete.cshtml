@model WebApplication1.Models.DBModels.User
@using WebApplication1.Helpers
@{
    ViewData["Title"] = Localizer["DeleteUser"].Value;
    var isMedclinic = string.Equals(AuthorizationHelper.GetOrganizationType(Context), "medclinic", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    @if (isMedclinic)
    {
        <partial name="Partials/_MedclinicStaffStyles" />
    }
}

@if (isMedclinic)
{
    <div class="mc-staff dashboard-page">
        <nav class="mc-staff-breadcrumb" aria-label="Навигация">
            <a asp-controller="Doctors" asp-action="Index">Сотрудники</a>
            <span class="mc-staff-breadcrumb__sep">›</span>
            <span>Удаление</span>
        </nav>

        <div class="mc-staff-hero">
            <div class="mc-staff-hero__row">
                <div>
                    <h1 class="mc-staff-hero__title">@Localizer["DeleteUser"]</h1>
                    <p class="mc-staff-hero__sub">@Localizer["DeleteUserDescription"]</p>
                </div>
                <a asp-controller="Doctors" asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">К списку</a>
            </div>
        </div>

        <div class="mc-staff-panel">
            <div class="alert alert-warning mc-staff-alert mb-3">
                <strong>@Localizer["AreYouSure"]</strong><br />
                @Localizer["DeleteUserWarning"]
            </div>
            <dl class="row mb-0 small">
                <dt class="col-sm-3">@Localizer["Name"]</dt>
                <dd class="col-sm-9 fw-semibold">@Model.Name</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>
                <dt class="col-sm-3">@Localizer["Phone"]</dt>
                <dd class="col-sm-9">@Model.Phone</dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post" class="mc-staff-form-actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="mc-staff-btn mc-staff-btn--danger">@Localizer["Delete"]</button>
            <a asp-controller="Doctors" asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">@Localizer["Cancel"]</a>
        </form>
    </div>
}
else
{
    <div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">@Localizer["DeleteUser"]</h1>
            <p class="text-muted small mb-0">@Localizer["DeleteUserDescription"]</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["BackToUsers"]</a>
    </div>
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="alert alert-warning mb-3">
                <h5 class="alert-heading mb-1">@Localizer["AreYouSure"]</h5>
                <p class="mb-0">@Localizer["DeleteUserWarning"]</p>
            </div>
            <dl class="row mb-0">
                <dt class="col-sm-3">@Localizer["Name"]</dt>
                <dd class="col-sm-9">@Model.Name</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>
                <dt class="col-sm-3">@Localizer["Phone"]</dt>
                <dd class="col-sm-9">@Model.Phone</dd>
            </dl>
        </div>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
}
