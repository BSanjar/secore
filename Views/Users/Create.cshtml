@model WebApplication1.Models.DBModels.User
@using WebApplication1.Helpers
@{
    ViewData["Title"] = Localizer["CreateUser"].Value;
    var isMedclinic = string.Equals(AuthorizationHelper.GetOrganizationType(Context), "medclinic", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    @if (isMedclinic)
    {
        <partial name="Partials/_MedclinicStaffStyles" />
    }
}

@if (isMedclinic)
{
    <div class="mc-staff dashboard-page">
        <nav class="mc-staff-breadcrumb" aria-label="?????????">
            <a asp-controller="Doctors" asp-action="Index">??????????</a>
            <span class="mc-staff-breadcrumb__sep">›</span>
            <span>????? ?????????</span>
        </nav>

        <div class="mc-staff-hero">
            <div class="mc-staff-hero__row">
                <div>
                    <h1 class="mc-staff-hero__title">@Localizer["CreateUser"]</h1>
                    <p class="mc-staff-hero__sub">@Localizer["CreateUserDescription"]</p>
                </div>
                <a asp-controller="Doctors" asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">? ??????</a>
            </div>
        </div>

        <div class="mc-staff-panel mc-staff-form">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-2 small"></div>
                <div class="mc-staff-form-grid">
                    <div>
                        <label asp-for="Name" class="form-label">???</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Phone" class="form-label">@Localizer["Phone"]</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div>
                        <label asp-for="Password" class="form-label">@Localizer["Password"]</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mc-staff-form-actions">
                    <button type="submit" class="mc-staff-btn mc-staff-btn--primary">@Localizer["Create"]</button>
                    <a asp-controller="Doctors" asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">@Localizer["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">@Localizer["CreateUser"]</h1>
            <p class="text-muted small mb-0">@Localizer["CreateUserDescription"]</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["BackToUsers"]</a>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">???</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">@Localizer["Phone"]</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">@Localizer["Password"]</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="mt-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">@Localizer["Create"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
