@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@model IEnumerable<WebApplication1.Models.DBModels.User>
@{
    ViewData["Title"] = Localizer["Users"].Value;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Localizer["Users"]</h2>
        <a asp-action="Create" class="btn btn-primary">@Localizer["Create"]</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        <th>Email</th>
                        <th>@Localizer["Phone"]</th>
                        <th>@Localizer["Roles"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.Phone</td>
                            <td>
                                @if (user.UserRoles != null && user.UserRoles.Any(ur => ur.Isdeleted == null || ur.Isdeleted == 0))
                                {
                                    @foreach (var userRole in user.UserRoles.Where(ur => ur.Isdeleted == null || ur.Isdeleted == 0))
                                    {
                                        <span class="badge bg-primary me-1">@userRole.RoleNavigation?.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["NoRolesAssigned"]</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">@Localizer["Edit"]</a>
                                <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">@Localizer["Delete"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            @Localizer["NoUsersFound"]. <a asp-action="Create">@Localizer["CreateFirstUser"]</a>.
        </div>
    }
</div>

