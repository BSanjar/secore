@model IEnumerable<WebApplication1.Models.DBModels.User>
@{
    ViewData["Title"] = Localizer["Users"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage settings-list-page">
    <nav class="detsad-breadcrumb" aria-label="?????????">
        <a asp-controller="Settings" asp-action="Index">@Localizer["Settings"]</a>
        <span class="breadcrumb-sep">/</span>
        <span>@Localizer["Users"]</span>
    </nav>

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="page-title mb-0">@Localizer["Users"]</h1>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Settings" asp-action="Index" class="detsad-btn-secondary">@Localizer["BackToSettings"]</a>
            <a asp-action="Create" class="detsad-btn-primary">@Localizer["Create"]</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="dashboard-table-card">
            <div class="table-wrap">
                <table class="table-soft">
                    <thead>
                        <tr>
                            <th>???</th>
                            <th>Email</th>
                            <th>@Localizer["Phone"]</th>
                            <th>@Localizer["Roles"]</th>
                            <th class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var roles = user.UserRoles?
                                .Where(ur => ur.Isdeleted == null || ur.Isdeleted == 0)
                                .Select(ur => ur.RoleNavigation?.Name)
                                .Where(n => !string.IsNullOrEmpty(n))
                                .ToList() ?? new List<string>();

                            <tr>
                                <td class="cell-name">@user.Name</td>
                                <td class="cell-muted">@user.Email</td>
                                <td class="cell-muted">@user.Phone</td>
                                <td>
                                    @if (roles.Any())
                                    {
                                        @foreach (var r in roles)
                                        {
                                            <span class="status-badge status-active me-1">@r</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Localizer["NoRolesAssigned"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["Actions"]">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary">@Localizer["Edit"]</a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger">@Localizer["Delete"]</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state-settings">
            <p class="mb-0">@Localizer["NoUsersFound"]</p>
            <a asp-action="Create" class="detsad-btn-primary mt-3 d-inline-flex">@Localizer["CreateFirstUser"]</a>
        </div>
    }
</div>
