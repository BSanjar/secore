@model IEnumerable<WebApplication1.Models.DBModels.User>
@{
    ViewData["Title"] = Localizer["Users"].Value;
}

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="h2 mb-1">@Localizer["Users"]</h1>
        <p class="text-muted small mb-0">
            @Localizer["ManageUsers"]
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            @Localizer["BackToSettings"]
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            @Localizer["Create"]
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>‘»Œ</th>
                            <th>Email</th>
                            <th>@Localizer["Phone"]</th>
                            <th>@Localizer["Roles"]</th>
                            <th class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var roles = user.UserRoles?
                                .Where(ur => ur.Isdeleted == null || ur.Isdeleted == 0)
                                .Select(ur => ur.RoleNavigation?.Name)
                                .Where(n => !string.IsNullOrEmpty(n))
                                .ToList() ?? new List<string>();

                            <tr>
                                <td>@user.Name</td>
                                <td>@user.Email</td>
                                <td>@user.Phone</td>
                                <td>
                                    @if (roles.Any())
                                    {
                                        @foreach (var r in roles)
                                        {
                                            <span class="badge bg-primary text-white me-1">@r</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Localizer["NoRolesAssigned"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["Actions"]">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary">
                                            @Localizer["Edit"]
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger">
                                            @Localizer["Delete"]
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        @Localizer["NoUsersFound"]
        <a asp-action="Create" class="alert-link">@Localizer["CreateFirstUser"]</a>.
    </div>
}

