@model WebApplication1.ViewModels.Patients.PatientsIndexViewModel
@{
    ViewData["Title"] = "Пациенты";
    ViewData["HideTopbarTitle"] = true;
    var canViewAppointmentRegistry = ViewBag.CanViewAppointmentRegistry as bool? == true;

    string PatientStatusBadgeClass(string label) => label switch
    {
        "Активный" => "mc-staff-badge--active",
        _ => "mc-staff-badge--muted"
    };
}

@section Styles {
    <partial name="Partials/_MedclinicCatalogStyles" />
}

<div class="mc-staff dashboard-page">
    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">Пациенты</h1>
                <p class="mc-staff-hero__sub">Реестр пациентов клиники: контакты, идентификаторы и статус.</p>
            </div>
            <div class="mc-staff-hero__actions">
                <partial name="Partials/_MedclinicExcelExportButton" view-data="@(new ViewDataDictionary(ViewData) {
                    ["ExportHref"] = Url.Action("ExportExcel", "Patients", new { search = Model.Search }),
                    ["ExportSuccessMessage"] = "Список пациентов выгружен в Excel."
                })" />
                <a asp-controller="Patients" asp-action="Create" class="mc-staff-btn mc-staff-btn--primary">Добавить пациента</a>
            </div>
        </div>
    </div>

    <div class="mc-staff-panel">
        <form method="get" class="mc-staff-filters">
            <label class="mc-staff-field mc-staff-field--grow">
                <span class="mc-staff-field__label">Поиск</span>
                <input id="search" name="search" value="@Model.Search" class="mc-staff-input" placeholder="Имя, телефон, email, ИИН/ИНН" />
            </label>
            <div class="d-flex gap-2">
                <button type="submit" class="mc-staff-btn mc-staff-btn--primary">Найти</button>
                <a asp-controller="Patients" asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">Сброс</a>
            </div>
        </form>

        @if (Model.Patients.Count == 0)
        {
            <div class="mc-staff-empty">Пациенты пока не добавлены.</div>
        }
        else
        {
            <div class="mc-staff-table-wrap">
                <table class="mc-staff-table">
                    <thead>
                        <tr>
                            <th>Пациент</th>
                            <th>Пол</th>
                            <th>Дата рождения</th>
                            <th>ИИН/ИНН</th>
                            <th>Телефон</th>
                            <th>Email</th>
                            <th>Записей</th>
                            <th>Статус</th>
                            <th>Создан</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td>
                                    <div class="mc-staff-table__name">@patient.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(patient.Address))
                                    {
                                        <div class="mc-staff-table__muted">@patient.Address</div>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(patient.Gender) ? "—" : patient.Gender)</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(patient.BirthDate))
                                    {
                                        @:—
                                    }
                                    else if (DateTime.TryParse(patient.BirthDate, out var birthDate))
                                    {
                                        @(patient.Age is not null ? $"{birthDate:dd.MM.yyyy} ({patient.Age} лет)" : birthDate.ToString("dd.MM.yyyy"))
                                    }
                                    else
                                    {
                                        @patient.BirthDate
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(patient.Identifier) ? "—" : patient.Identifier)</td>
                                <td>@(string.IsNullOrWhiteSpace(patient.Phone) ? "—" : patient.Phone)</td>
                                <td>@(string.IsNullOrWhiteSpace(patient.Email) ? "—" : patient.Email)</td>
                                <td>@patient.AppointmentsCount</td>
                                <td>
                                    <span class="mc-staff-badge @PatientStatusBadgeClass(patient.StatusLabel)">
                                        @patient.StatusLabel
                                    </span>
                                </td>
                                <td>@(patient.CreatedDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>
                                    <div class="mc-staff-table__actions">
                                        @if (canViewAppointmentRegistry)
                                        {
                                            <a asp-controller="Appointments"
                                               asp-action="Registry"
                                               asp-route-patientId="@patient.Id"
                                               class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm"
                                               title="Открыть записи пациента в расписании">
                                                Записи
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="mc-staff-table__muted">—</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="Partials/_MedclinicCatalogScripts" />
}
