@model WebApplication1.Dtos.DepartmentUpsertDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Редактирование отделения";
    var specializations = ViewBag.Specializations as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="dashboard-page">
    <div class="medclinic-surface p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Редактирование отделения</h1>
                <p class="text-muted mb-0">Обновление параметров подразделения клиники.</p>
            </div>
            <a class="btn btn-outline-secondary" asp-action="Index">Назад к списку</a>
        </div>

        <form method="post" class="row g-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Название</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Code" class="form-label">Код</label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SortOrder" class="form-label">Порядок</label>
                <input asp-for="SortOrder" class="form-control" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Активно</label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="SpecializationIds" class="form-label">Специализации в отделении</label>
                <select asp-for="SpecializationIds" asp-items="specializations" class="form-select" multiple size="8"></select>
                <div class="form-text">При сохранении выбранные специализации будут привязаны к этому отделению.</div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
