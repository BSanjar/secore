@model IReadOnlyList<WebApplication1.Controllers.DepartmentsController.DepartmentIndexItem>
@{
    ViewData["Title"] = "Отделения";
    var search = ViewBag.Search as string ?? string.Empty;
}

<div class="dashboard-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">@TempData["Error"]</div>
    }

    <div class="medclinic-surface p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">Отделения</h1>
                <p class="text-muted mb-0">Структура клиники и распределение врачей по подразделениям.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" />
                    <button type="submit" class="btn btn-outline-success btn-sm">Загрузить Excel</button>
                </form>
                <a class="btn btn-primary" asp-action="Create">Добавить отделение</a>
            </div>
        </div>
        <div class="text-muted small mt-3">Excel: название, код, описание, порядок, активно.</div>
    </div>

    <div class="medclinic-surface p-4">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-8">
                <label class="form-label">Поиск</label>
                <input name="search" value="@search" class="form-control" placeholder="По названию, коду или описанию" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-outline-primary">Найти</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="text-muted">Отделения пока не добавлены.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Отделение</th>
                            <th>Код</th>
                            <th>Статус</th>
                            <th>Специализации</th>
                            <th>Доктора</th>
                            <th>Порядок</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Code) ? "—" : item.Code)</td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                        @(item.IsActive ? "Активно" : "Скрыто")
                                    </span>
                                </td>
                                <td>@item.SpecializationsCount</td>
                                <td>@item.DoctorsCount</td>
                                <td>@item.SortOrder</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Редактировать</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
