@model IReadOnlyList<WebApplication1.Controllers.DepartmentsController.DepartmentIndexItem>
@{
    ViewData["Title"] = "Отделения";
    ViewData["HideTopbarTitle"] = true;
    var search = ViewBag.Search as string ?? string.Empty;
}

@section Styles {
    <partial name="Partials/_MedclinicCatalogStyles" />
}

<div class="mc-staff dashboard-page">
    <div class="mc-staff-hero">
        <div class="mc-staff-hero__row">
            <div>
                <h1 class="mc-staff-hero__title">Отделения</h1>
                <p class="mc-staff-hero__sub">Структура клиники и распределение врачей по подразделениям.</p>
            </div>
            <div class="mc-staff-hero__actions">
                <a class="mc-staff-btn mc-staff-btn--primary" asp-action="Create">Добавить отделение</a>
            </div>
        </div>
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="mc-staff-import mc-catalog-import-form mt-3">
            @Html.AntiForgeryToken()
            <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" />
            <button type="submit" class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm">Загрузить Excel</button>
            <div class="mc-staff-import__hint">Excel: название, код, описание, порядок, активно.</div>
        </form>
    </div>

    <div class="mc-staff-panel">
        <form method="get" class="mc-staff-filters">
            <label class="mc-staff-field mc-staff-field--grow">
                <span class="mc-staff-field__label">Поиск</span>
                <input name="search" value="@search" class="mc-staff-input" placeholder="По названию, коду или описанию" />
            </label>
            <div class="d-flex gap-2">
                <button type="submit" class="mc-staff-btn mc-staff-btn--primary">Найти</button>
                <a asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">Сброс</a>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="mc-staff-empty">Отделения пока не добавлены.</div>
        }
        else
        {
            <div class="mc-staff-table-wrap">
                <table class="mc-staff-table">
                    <thead>
                        <tr>
                            <th>Отделение</th>
                            <th>Код</th>
                            <th>Статус</th>
                            <th>Специализации</th>
                            <th>Доктора</th>
                            <th>Порядок</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="mc-staff-table__name">@item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="mc-staff-table__muted">@item.Description</div>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Code) ? "—" : item.Code)</td>
                                <td>
                                    <span class="mc-staff-badge @(item.IsActive ? "mc-staff-badge--active" : "mc-staff-badge--muted")">
                                        @(item.IsActive ? "Активно" : "Скрыто")
                                    </span>
                                </td>
                                <td>@item.SpecializationsCount</td>
                                <td>@item.DoctorsCount</td>
                                <td>@item.SortOrder</td>
                                <td>
                                    <div class="mc-staff-table__actions">
                                        <a class="mc-staff-btn mc-staff-btn--ghost mc-staff-btn--sm" asp-action="Edit" asp-route-id="@item.Id">Редактировать</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="Partials/_MedclinicCatalogScripts" />
}
