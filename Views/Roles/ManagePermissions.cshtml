@model WebApplication1.Models.DBModels.Role
@{
    ViewData["Title"] = "Права роли";
    var permissions = ViewBag.Permissions as List<WebApplication1.Models.DBModels.Permission> ?? new List<WebApplication1.Models.DBModels.Permission>();
    var categories = ViewBag.PermissionCategories as List<string> ?? new List<string>();
    var selectedPermissionIds = ViewBag.SelectedPermissionIds as List<string> ?? new List<string>();
    var organization = ViewBag.Organization as WebApplication1.Models.DBModels.Organization;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-soft.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">Настройки</a>
        <span class="breadcrumb-sep">/</span>
        <a asp-action="Index" asp-controller="Roles">Роли</a>
        <span class="breadcrumb-sep">/</span>
        <span>Права</span>
    </nav>

    <div class="page-header">
        <h1 class="page-title">Права роли</h1>
        <p class="page-subtitle mb-0">@Model.Name</p>
    </div>

    @if (organization != null)
    {
        <div class="alert alert-info border-0 mb-3" style="border-radius: 12px;">
            <strong>Организация:</strong> @organization.Name (@organization.Organizationtype)
        </div>
    }

    <form asp-action="ManagePermissions" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Права доступа для выбранной организации</label>
            <div class="settings-scroll-panel">
                @if (categories.Any())
                {
                    @foreach (var category in categories)
                    {
                        <div class="mb-4">
                            <h2 class="settings-perm-category">@category</h2>
                            <div class="ms-1 ms-md-2">
                                @foreach (var permission in permissions.Where(p => p.Category == category))
                                {
                                    var isChecked = selectedPermissionIds.Contains(permission.Id);
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="selectedPermissions" value="@permission.Id" id="permission_@permission.Id" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label" for="permission_@permission.Id">
                                            <strong>@permission.Name</strong>
                                            @if (!string.IsNullOrEmpty(permission.Description))
                                            {
                                                <br />
                                                <small class="text-muted">@permission.Description</small>
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var permission in permissions)
                    {
                        var isChecked = selectedPermissionIds.Contains(permission.Id);
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="selectedPermissions" value="@permission.Id" id="permission_@permission.Id" @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="permission_@permission.Id">
                                <strong>@permission.Name</strong>
                                @if (!string.IsNullOrEmpty(permission.Description))
                                {
                                    <br />
                                    <small class="text-muted">@permission.Description</small>
                                }
                            </label>
                        </div>
                    }
                }

                @if (!permissions.Any())
                {
                    <div class="alert alert-warning mb-0">
                        Права доступа не найдены. <a asp-controller="Permissions" asp-action="Create">Создайте первое право</a>.
                    </div>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="detsad-btn-primary">Сохранить права</button>
            <a asp-action="Index" class="detsad-btn-secondary">Назад к списку</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
