@model WebApplication1.Models.DBModels.Role
@{
    ViewData["Title"] = "Создать роль";
    var organization = ViewBag.Organization as WebApplication1.Models.DBModels.Organization;
}

<div class="container mt-4">
    <h2>Создать новую роль</h2>
    <hr />
    @if (organization != null)
    {
        <div class="alert alert-info">
            <strong>Организация:</strong> @organization.Name (@organization.Organizationtype)
        </div>
    }

    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Название роли</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Создать</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

