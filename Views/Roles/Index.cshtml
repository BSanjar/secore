@model IEnumerable<WebApplication1.Models.DBModels.Role>
@{
    ViewData["Title"] = "Роли";
}

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="h2 mb-1">Роли</h1>
        <p class="text-muted small mb-0">Список ролей и количество прав в каждой.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            К настройкам
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            Создать новую роль
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Название</th>
                            <th>Количество прав</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            var permissionsCount = role.RolePermissions?.Count(rp => rp.Isdeleted == null || rp.Isdeleted == 0) ?? 0;
                            <tr>
                                <td>@role.Name</td>
                                <td>@permissionsCount</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="ManagePermissions" asp-route-id="@role.Id" class="btn btn-outline-primary">
                                            Права
                                        </a>
                                        <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-outline-secondary">
                                            Детали
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-outline-warning">
                                            Редактировать
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-outline-danger">
                                            Удалить
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Роли не найдены. <a asp-action="Create">Создайте первую роль</a>.
    </div>
}