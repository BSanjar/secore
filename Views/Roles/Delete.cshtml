@model WebApplication1.Models.DBModels.Role
@{
    ViewData["Title"] = "Удалить роль";
}

<div class="container mt-4">
    <h2>Удалить роль</h2>
    <hr />

    <h3>Вы уверены, что хотите удалить эту роль?</h3>
    <div>
        <dl class="row">
            <dt class="col-sm-2">Название</dt>
            <dd class="col-sm-10">@Model.Name</dd>

            <dt class="col-sm-2">Количество прав</dt>
            <dd class="col-sm-10">
                @(Model.RolePermissions?.Count(rp => rp.Isdeleted == null || rp.Isdeleted == 0) ?? 0)
            </dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
        </form>
    </div>
</div>

