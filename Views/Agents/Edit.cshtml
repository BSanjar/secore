@model WebApplication1.Models.DBModels.Agent
@{
    ViewData["Title"] = "Изменить агента";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Изменить агента</h1>
    <p class="text-muted small mb-4">@(Model.Name ?? Model.Id)</p>
</div>

<form asp-action="Edit" method="post" class="mb-4">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Название</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ApiLogin" class="form-label">API логин</label>
                <input asp-for="ApiLogin" class="form-control" />
                <span asp-validation-for="ApiLogin" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ApiPassword" class="form-label">API пароль</label>
                <input asp-for="ApiPassword" type="password" class="form-control" placeholder="Оставьте пустым, чтобы не менять" autocomplete="new-password" />
                <small class="form-text text-muted">Оставьте пустым, чтобы не менять текущий пароль</small>
            </div>

            <div class="mb-3">
                <button type="submit" class="action-btn action-btn--edit">Сохранить</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="action-btn action-btn--view">Просмотр</a>
                <a asp-action="Index" class="action-btn action-btn--view">К списку</a>
            </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
