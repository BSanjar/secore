@model IEnumerable<WebApplication1.Models.DBModels.Notification>
@{
    ViewData["Title"] = "Уведомления";
    var pageNum = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var totalCount = (int)ViewBag.TotalCount;
    var status = ViewBag.Status as string ?? "";
    var channel = ViewBag.Channel as string ?? "";
    var createdFrom = ViewBag.CreatedFrom as string ?? "";
    var createdTo = ViewBag.CreatedTo as string ?? "";
    var sentFrom = ViewBag.SentFrom as string ?? "";
    var sentTo = ViewBag.SentTo as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-soft.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">Настройки</a>
        <span class="breadcrumb-sep">/</span>
        <span>Уведомления</span>
    </nav>

    <div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="page-title">Уведомления</h1>
            <p class="page-subtitle mb-0">Отправка и статус уведомлений по каналам (email, telegram и др.)</p>
        </div>
        <a asp-controller="Settings" asp-action="Index" class="detsad-btn-secondary">← К настройкам</a>
    </div>

    <form method="get" asp-action="Index" class="dashboard-filters">
        <div class="settings-filters-inner">
            <div class="filter-field">
                <label for="filterStatus">Статус</label>
                <select name="status" id="filterStatus" class="form-select-soft">
                    <option value="">Все</option>
                    @if (status == "new") { <option value="new" selected>new</option> } else { <option value="new">new</option> }
                    @if (status == "processing") { <option value="processing" selected>processing</option> } else { <option value="processing">processing</option> }
                    @if (status == "sent") { <option value="sent" selected>sent</option> } else { <option value="sent">sent</option> }
                    @if (status == "failed") { <option value="failed" selected>failed</option> } else { <option value="failed">failed</option> }
                </select>
            </div>
            <div class="filter-field">
                <label for="filterChannel">Канал</label>
                <select name="channel" id="filterChannel" class="form-select-soft">
                    <option value="">Все</option>
                    @if (channel == "email") { <option value="email" selected>email</option> } else { <option value="email">email</option> }
                    @if (channel == "telegram") { <option value="telegram" selected>telegram</option> } else { <option value="telegram">telegram</option> }
                    @if (channel == "whatsapp") { <option value="whatsapp" selected>whatsapp</option> } else { <option value="whatsapp">whatsapp</option> }
                </select>
            </div>
            <div class="filter-field">
                <label for="createdFrom">Created_at с</label>
                <input type="date" name="createdFrom" id="createdFrom" value="@createdFrom" />
            </div>
            <div class="filter-field">
                <label for="createdTo">Created_at по</label>
                <input type="date" name="createdTo" id="createdTo" value="@createdTo" />
            </div>
            <div class="filter-field">
                <label for="sentFrom">Sent_at с</label>
                <input type="date" name="sentFrom" id="sentFrom" value="@sentFrom" />
            </div>
            <div class="filter-field">
                <label for="sentTo">Sent_at по</label>
                <input type="date" name="sentTo" id="sentTo" value="@sentTo" />
            </div>
            <div class="filter-field d-flex flex-row gap-2 align-items-end">
                <button type="submit" class="btn-soft-primary">Применить</button>
                <a asp-action="Index" class="btn-soft-secondary">Сбросить</a>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <div class="dashboard-table-card">
            <div class="table-wrap">
                <table class="table-soft">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Канал</th>
                            <th>Статус</th>
                            <th>Тема</th>
                            <th>Клиент</th>
                            <th>Контакт</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var n in Model)
                        {
                            var st = n.Status ?? "";
                            var statusClass = st == "sent" ? "notify-status--sent"
                                : st == "failed" ? "notify-status--failed"
                                : st == "processing" ? "notify-status--processing"
                                : "notify-status--new";
                            <tr>
                                <td class="cell-muted">@(n.CreatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                <td>@(n.Channel ?? "—")</td>
                                <td>
                                    <span class="notify-status @statusClass">@(n.Status ?? "—")</span>
                                </td>
                                <td class="text-break cell-name">@(n.Subject != null && n.Subject.Length > 50 ? n.Subject.Substring(0, 50) + "…" : n.Subject ?? "—")</td>
                                <td>@(n.ClientNavigation?.ClientName ?? n.ClientId ?? "—")</td>
                                <td class="cell-muted small">@(n.ContactInfo ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            var routeVals = new Dictionary<string, string> {
                ["status"] = status,
                ["channel"] = channel,
                ["createdFrom"] = createdFrom,
                ["createdTo"] = createdTo,
                ["sentFrom"] = sentFrom,
                ["sentTo"] = sentTo
            };
            <nav aria-label="Страницы уведомлений" class="settings-pagination">
                @if (pageNum > 1)
                {
                    <a class="btn-soft-secondary" asp-action="Index" asp-route-page="@(pageNum - 1)" asp-all-route-data="@routeVals">Назад</a>
                }
                else
                {
                    <span class="btn-soft-secondary" style="opacity: .5; pointer-events: none;">Назад</span>
                }
                <span class="settings-page-info">Страница @(pageNum) из @totalPages</span>
                @if (pageNum < totalPages)
                {
                    <a class="btn-soft-secondary" asp-action="Index" asp-route-page="@(pageNum + 1)" asp-all-route-data="@routeVals">Вперёд</a>
                }
                else
                {
                    <span class="btn-soft-secondary" style="opacity: .5; pointer-events: none;">Вперёд</span>
                }
            </nav>
        }
        <p class="settings-meta mb-0">Всего записей: @totalCount</p>
    }
    else
    {
        <div class="empty-state-settings">
            <p class="mb-0">Уведомлений пока нет.</p>
            <a asp-controller="Settings" asp-action="Index" class="detsad-btn-secondary mt-3 d-inline-flex">← К настройкам</a>
        </div>
    }
</div>
