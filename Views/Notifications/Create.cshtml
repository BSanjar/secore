@model WebApplication1.ViewModels.Notifications.NotificationCreateViewModel
@using WebApplication1.Services
@using WebApplication1.Helpers
@{
    var isMedclinic = string.Equals(WebApplication1.Helpers.AuthorizationHelper.GetOrganizationType(Context), "medclinic", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = "Новая рассылка";
    if (isMedclinic)
    {
        ViewData["HideTopbarTitle"] = true;
    }
}

@section Styles {
    @if (isMedclinic)
    {
        <partial name="Partials/_MedclinicCatalogStyles" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/dashboard-soft.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
        <style>
            .notify-create-grid { display:grid; grid-template-columns:1.4fr 1fr; gap:1.5rem; }
            .notify-card { background:#fff; border:1px solid rgba(15,23,42,.08); border-radius:20px; box-shadow:0 12px 32px rgba(15,23,42,.06); padding:1.25rem; }
            .notify-pickers { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
            .notify-picker { border:1px solid rgba(148,163,184,.35); border-radius:16px; background:#f8fafc; overflow:hidden; }
            .notify-picker__head { display:flex; justify-content:space-between; gap:.75rem; align-items:center; padding:.9rem 1rem; background:#fff; border-bottom:1px solid rgba(148,163,184,.25); }
            .notify-picker__list { max-height:420px; overflow:auto; padding:.75rem; display:grid; gap:.65rem; }
            .notify-option { display:block; border:1px solid rgba(148,163,184,.3); border-radius:14px; background:#fff; padding:.8rem .9rem; cursor:pointer; }
            .notify-option__row { display:flex; align-items:flex-start; gap:.65rem; }
            .notify-option__title { font-weight:700; color:#0f172a; }
            .notify-option__meta, .notify-option__channels { color:#475569; font-size:.9rem; margin-top:.2rem; display:block; }
            .notify-channel { display:flex; gap:.75rem; align-items:center; border:1px solid rgba(148,163,184,.35); border-radius:14px; padding:.9rem 1rem; background:#fff; margin-bottom:.75rem; }
            .notify-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; margin-top:1rem; }
            .notify-summary__item { border-radius:14px; padding:.85rem 1rem; background:#f8fafc; border:1px solid rgba(148,163,184,.25); }
            .notify-summary__label { color:#64748b; font-size:.85rem; }
            .notify-summary__value { display:block; margin-top:.2rem; font-size:1.2rem; font-weight:700; color:#0f172a; }
            @@media (max-width: 1100px) { .notify-create-grid, .notify-pickers { grid-template-columns:1fr; } }
        </style>
    }
}

@if (isMedclinic)
{
    <div class="mc-staff dashboard-page">
        <nav class="mc-staff-breadcrumb" aria-label="Навигация">
            <a asp-action="Index">Уведомления</a>
            <span class="mc-staff-breadcrumb__sep">›</span>
            <span>Новая рассылка</span>
        </nav>

        <div class="mc-staff-hero">
            <div class="mc-staff-hero__row">
                <div>
                    <h1 class="mc-staff-hero__title">Новая рассылка</h1>
                    <p class="mc-staff-hero__sub">Выберите аудиторию или отдельных пациентов, заполните сообщение и поставьте уведомления в очередь.</p>
                </div>
                <div class="mc-staff-hero__aside">
                    <div class="mc-staff-hero__actions">
                        <a asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">К журналу уведомлений</a>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Create" class="mc-catalog-form">
            @Html.AntiForgeryToken()
            <div class="mc-staff-templates-grid">
                <div class="mc-staff-panel">
                    <div class="mc-staff-panel__head">
                        <h2 class="mc-staff-panel__title">Получатели</h2>
                        <p class="mc-staff-panel__sub">Фильтр по аудитории или ручной выбор пациентов.</p>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mc-staff-alert py-2 px-3 small mc-staff-validation-summary"></div>

                    <div class="notify-audience">
                        <div class="notify-audience__label">Кому отправить</div>
                        <div class="notify-audience__chips" id="recipientModeChips">
                            @foreach (var option in NotificationRecipientModes.MedclinicAudienceOptions)
                            {
                                var isChecked = string.Equals(Model.RecipientMode, option.Value, StringComparison.OrdinalIgnoreCase)
                                    || (string.IsNullOrWhiteSpace(Model.RecipientMode) && option.Value == NotificationRecipientModes.All);
                                <label class="notify-audience-chip">
                                    <input type="radio" name="RecipientMode" value="@option.Value" @(isChecked ? "checked" : null) />
                                    <span>@option.Label</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="notify-audience mt-3">
                        <div class="notify-audience__label">Пол</div>
                        <div class="notify-audience__chips" id="genderFilterChips">
                            @foreach (var option in NotificationGenderFilters.Options)
                            {
                                var isChecked = string.Equals(Model.GenderFilter ?? "", option.Value, StringComparison.OrdinalIgnoreCase);
                                <label class="notify-audience-chip">
                                    <input type="radio" name="GenderFilter" value="@option.Value" @(isChecked ? "checked" : null) />
                                    <span>@option.Label</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="notify-audience mt-3">
                        <div class="notify-audience__label">Возраст</div>
                        <div class="notify-audience__chips" id="ageFilterChips">
                            @foreach (var option in NotificationAgeFilters.Options)
                            {
                                var isChecked = string.Equals(Model.AgeFilter ?? "", option.Value, StringComparison.OrdinalIgnoreCase);
                                <label class="notify-audience-chip">
                                    <input type="radio" name="AgeFilter" value="@option.Value" @(isChecked ? "checked" : null) />
                                    <span>@option.Label</span>
                                </label>
                            }
                        </div>
                        <p class="notify-audience__hint">Возраст считается по дате рождения из карточки пациента. Фильтры по полу и возрасту можно комбинировать.</p>
                    </div>

                    <section class="mc-staff-panel notify-client-picker" id="clientPickerSection">
                        <div class="mc-staff-panel__head d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div>
                                <div class="mc-staff-panel__title">Пациенты</div>
                                <div class="mc-staff-panel__sub" id="clientPickerSubtitle">Предпросмотр аудитории по выбранным фильтрам</div>
                            </div>
                            <input type="search" id="clientSearchInput" class="mc-staff-input" placeholder="Поиск пациента" />
                        </div>
                        <div class="notify-picker__list" id="clientOptionsList">
                            @if (Model.AvailableClients.Count == 0)
                            {
                                <div class="mc-staff-table__muted small">Активных пациентов пока нет.</div>
                            }
                            else
                            {
                                @foreach (var client in Model.AvailableClients)
                                {
                                    var channels = string.Join(", ", new[]
                                    {
                                        !string.IsNullOrWhiteSpace(client.Email) ? "email" : null,
                                        !string.IsNullOrWhiteSpace(client.Telegram) ? "telegram" : null,
                                        !string.IsNullOrWhiteSpace(client.WhatsApp) ? "whatsapp" : null
                                    }.Where(x => x != null));
                                    var filterText = $"{client.Name} {client.Email} {client.Telegram} {client.WhatsApp}".ToLowerInvariant();
                                    var demoParts = new List<string>();
                                    if (client.Age is not null) demoParts.Add($"{client.Age} лет");
                                    if (!string.IsNullOrWhiteSpace(client.Gender))
                                        demoParts.Add(client.Gender == "male" ? "Мужской" : client.Gender == "female" ? "Женский" : client.Gender);

                                    <label class="notify-option" data-filter-item data-filter-text="@filterText" data-client-gender="@(client.Gender ?? "")" data-client-age="@(client.Age?.ToString() ?? "")">
                                        <span class="notify-option__row">
                                            <input type="checkbox" name="SelectedClientIds" value="@client.Id" @(Model.SelectedClientIds.Contains(client.Id) ? "checked" : null) />
                                            <span>
                                                <span class="notify-option__title">@client.Name</span>
                                                <span class="notify-option__meta">@client.StatusLabel@(demoParts.Count > 0 ? $" · {string.Join(" · ", demoParts)}" : "")</span>
                                                <span class="notify-option__channels">@(client.HasAnyChannel ? $"Каналы: {channels}" : "Нет контактных каналов")</span>
                                            </span>
                                        </span>
                                    </label>
                                }
                            }
                        </div>
                        <div class="notify-picker__empty d-none" id="clientOptionsEmpty">По выбранным фильтрам пациентов не найдено.</div>
                    </section>
                </div>

                <div class="mc-staff-panel mc-staff-form">
                    <div class="mc-staff-panel__head">
                        <h2 class="mc-staff-panel__title">Сообщение</h2>
                        <p class="mc-staff-panel__sub">Отправка уведомлений по выбранным каналам</p>
                    </div>

                    <label class="notify-channel">
                        <input asp-for="SendEmail" type="checkbox" />
                        <span><strong>Email</strong><span class="d-block text-muted small">Канал из <code>ClientEmail</code></span></span>
                    </label>
                    <label class="notify-channel">
                        <input asp-for="SendTelegram" type="checkbox" />
                        <span><strong>Telegram</strong><span class="d-block text-muted small">Канал из <code>ClientTg</code></span></span>
                    </label>
                    <label class="notify-channel">
                        <input asp-for="SendWhatsApp" type="checkbox" />
                        <span><strong>WhatsApp</strong><span class="d-block text-muted small">Канал из <code>ClientWa</code></span></span>
                    </label>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label">Тема</label>
                        <input asp-for="Subject" class="form-control" placeholder="Например: Напоминание об оплате" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label">Текст уведомления</label>
                        <textarea asp-for="Message" class="form-control" rows="10" placeholder="Введите сообщение для выбранных клиентов"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <div class="notify-summary">
                        <div class="notify-summary__item">
                            <span class="notify-summary__label">Получателей</span>
                            <span class="notify-summary__value" id="selectedRecipientsCount">0</span>
                        </div>
                        <div class="notify-summary__item">
                            <span class="notify-summary__label">Режим</span>
                            <span class="notify-summary__value notify-summary__value--text" id="selectedRecipientModeLabel">Все пациенты</span>
                        </div>
                    </div>

                    <div class="mc-staff-form-actions">
                        <button type="submit" class="mc-staff-btn mc-staff-btn--primary" data-loading-text="Отправка...">Поставить в очередь</button>
                        <a asp-action="Index" class="mc-staff-btn mc-staff-btn--ghost">Отмена</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
}
else
{
    <div class="children-page settings-page settings-subpage">
        <nav class="detsad-breadcrumb" aria-label="Навигация">
            <a asp-controller="Settings" asp-action="Index">Настройки</a>
            <span class="breadcrumb-sep">/</span>
            <a asp-action="Index">Уведомления</a>
            <span class="breadcrumb-sep">/</span>
            <span>Новая рассылка</span>
        </nav>

        <div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h1 class="page-title">Новая рассылка</h1>
                <p class="page-subtitle mb-0">Выберите клиентов или группы, заполните сообщение и поставьте уведомления в очередь.</p>
            </div>
            <a asp-action="Index" class="detsad-btn-secondary">К журналу уведомлений</a>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning">@TempData["Warning"]</div>
        }

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="notify-create-grid">
                <div class="notify-card">
                    <h2 class="h5 mb-1">Получатели</h2>
                    <p class="text-muted mb-4">Можно выбрать отдельных клиентов и группы одновременно. </p>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="notify-pickers">
                        <section class="notify-picker">
                            <div class="notify-picker__head">
                                <div>
                                    <div class="fw-semibold">Группы</div>
                                    <div class="text-muted small">Активные группы</div>
                                </div>
                                <input type="search" id="groupSearchInput" class="form-control form-control-sm" placeholder="Поиск группы" />
                            </div>
                            <div class="notify-picker__list" id="groupOptionsList">
                                @if (Model.AvailableGroups.Count == 0)
                                {
                                    <div class="text-muted small">Активных групп пока нет.</div>
                                }
                                else
                                {
                                    @foreach (var group in Model.AvailableGroups)
                                    {
                                        <label class="notify-option" data-filter-item data-filter-text="@group.Name.ToLowerInvariant()">
                                            <span class="notify-option__row">
                                                <input type="checkbox" name="SelectedGroupIds" value="@group.Id" @(Model.SelectedGroupIds.Contains(group.Id) ? "checked" : null) />
                                                <span>
                                                    <span class="notify-option__title">@group.Name</span>
                                                    <span class="notify-option__meta">Клиентов в группе: @group.ClientCount</span>
                                                </span>
                                            </span>
                                        </label>
                                    }
                                }
                            </div>
                        </section>

                        <section class="notify-picker">
                            <div class="notify-picker__head">
                                <div>
                                    <div class="fw-semibold">Клиенты</div>
                                    <div class="text-muted small">Только активные</div>
                                </div>
                                <input type="search" id="clientSearchInput" class="form-control form-control-sm" placeholder="Поиск клиента" />
                            </div>
                            <div class="notify-picker__list" id="clientOptionsList">
                                @if (Model.AvailableClients.Count == 0)
                                {
                                    <div class="text-muted small">Активных клиентов пока нет.</div>
                                }
                                else
                                {
                                    @foreach (var client in Model.AvailableClients)
                                    {
                                        var channels = string.Join(", ", new[]
                                        {
                                            !string.IsNullOrWhiteSpace(client.Email) ? "email" : null,
                                            !string.IsNullOrWhiteSpace(client.Telegram) ? "telegram" : null,
                                            !string.IsNullOrWhiteSpace(client.WhatsApp) ? "whatsapp" : null
                                        }.Where(x => x != null));
                                        var filterText = $"{client.Name} {client.GroupName} {client.Email} {client.Telegram} {client.WhatsApp}".ToLowerInvariant();

                                        <label class="notify-option" data-filter-item data-filter-text="@filterText">
                                            <span class="notify-option__row">
                                                <input type="checkbox" name="SelectedClientIds" value="@client.Id" @(Model.SelectedClientIds.Contains(client.Id) ? "checked" : null) />
                                                <span>
                                                    <span class="notify-option__title">@client.Name</span>
                                                    <span class="notify-option__meta">@(string.IsNullOrWhiteSpace(client.GroupName) ? "Без группы" : client.GroupName) • @client.StatusLabel</span>
                                                    <span class="notify-option__channels">@(client.HasAnyChannel ? $"Каналы: {channels}" : "Нет контактных каналов")</span>
                                                </span>
                                            </span>
                                        </label>
                                    }
                                }
                            </div>
                        </section>
                    </div>
                </div>

                <div class="notify-card">
                    <h2 class="h5 mb-1">Сообщение</h2>
                    <p class="text-muted mb-4">Отправка уведомлений по выбраным каналам</p>

                    <label class="notify-channel">
                        <input asp-for="SendEmail" type="checkbox" />
                        <span><strong>Email</strong><span class="d-block text-muted small">Канал из <code>ClientEmail</code></span></span>
                    </label>
                    <label class="notify-channel">
                        <input asp-for="SendTelegram" type="checkbox" />
                        <span><strong>Telegram</strong><span class="d-block text-muted small">Канал из <code>ClientTg</code></span></span>
                    </label>
                    <label class="notify-channel">
                        <input asp-for="SendWhatsApp" type="checkbox" />
                        <span><strong>WhatsApp</strong><span class="d-block text-muted small">Канал из <code>ClientWa</code></span></span>
                    </label>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label">Тема</label>
                        <input asp-for="Subject" class="form-control" placeholder="Например: Напоминание об оплате" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label">Текст уведомления</label>
                        <textarea asp-for="Message" class="form-control" rows="10" placeholder="Введите сообщение для выбранных клиентов"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>

                    <div class="notify-summary">
                        <div class="notify-summary__item">
                            <span class="notify-summary__label">Групп выбрано</span>
                            <span class="notify-summary__value" id="selectedGroupsCount">@Model.SelectedGroupIds.Count</span>
                        </div>
                        <div class="notify-summary__item">
                            <span class="notify-summary__label">Клиентов выбрано</span>
                            <span class="notify-summary__value" id="selectedClientsCount">@Model.SelectedClientIds.Count</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        <button type="submit" class="detsad-btn-primary">Поставить в очередь</button>
                        <a asp-action="Index" class="detsad-btn-secondary">Отмена</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (isMedclinic)
    {
        <partial name="Partials/_MedclinicCatalogScripts" />
        <script>
            (function () {
                const manualMode = '@NotificationRecipientModes.Manual';
                const allMode = '@NotificationRecipientModes.All';

                function getSelectedMode() {
                    const checked = document.querySelector('input[name="RecipientMode"]:checked');
                    return checked ? checked.value : allMode;
                }

                function getGenderFilter() {
                    const checked = document.querySelector('input[name="GenderFilter"]:checked');
                    return checked ? checked.value : '';
                }

                function getAgeFilter() {
                    const checked = document.querySelector('input[name="AgeFilter"]:checked');
                    return checked ? checked.value : '';
                }

                function matchesGender(item, genderFilter) {
                    if (!genderFilter) return true;
                    const gender = item.getAttribute('data-client-gender') || '';
                    if (genderFilter === 'male') return gender === 'male';
                    if (genderFilter === 'female') return gender === 'female';
                    return true;
                }

                function matchesAge(item, ageFilter) {
                    if (!ageFilter) return true;
                    const ageRaw = item.getAttribute('data-client-age');
                    const age = ageRaw === '' || ageRaw == null ? null : Number(ageRaw);
                    if (age == null || Number.isNaN(age)) return false;

                    switch (ageFilter) {
                        case 'under18':
                            return age < 18;
                        case '18_30':
                            return age >= 18 && age <= 30;
                        case 'under30':
                            return age < 30;
                        case '30plus':
                            return age >= 30;
                        case '40plus':
                            return age >= 40;
                        default:
                            return true;
                    }
                }

                function matchesDemographicFilters(item) {
                    return matchesGender(item, getGenderFilter()) && matchesAge(item, getAgeFilter());
                }

                function matchesSearch(item) {
                    const input = document.getElementById('clientSearchInput');
                    const query = (input?.value || '').trim().toLowerCase();
                    if (!query) return true;
                    const text = item.getAttribute('data-filter-text') || '';
                    return text.indexOf(query) >= 0;
                }

                function applyClientListFilters() {
                    const items = Array.from(document.querySelectorAll('#clientOptionsList [data-filter-item]'));
                    let visibleCount = 0;

                    items.forEach(function (item) {
                        const visible = matchesSearch(item) && matchesDemographicFilters(item);
                        item.style.display = visible ? '' : 'none';
                        item.classList.toggle('notify-option--hidden', !visible);
                        if (visible) visibleCount++;
                    });

                    const emptyEl = document.getElementById('clientOptionsEmpty');
                    if (emptyEl) {
                        emptyEl.classList.toggle('d-none', visibleCount > 0);
                    }

                    return visibleCount;
                }

                function syncSelectionWithFilters() {
                    document.querySelectorAll('#clientOptionsList [data-filter-item]').forEach(function (item) {
                        const checkbox = item.querySelector('input[name="SelectedClientIds"]');
                        if (!checkbox) return;
                        const visible = item.style.display !== 'none';
                        checkbox.checked = visible;
                        item.classList.toggle('notify-option--selected', visible && checkbox.checked);
                    });
                }

                function buildSummaryLabel() {
                    const modeInput = document.querySelector('input[name="RecipientMode"]:checked');
                    const modeLabel = modeInput
                        ? modeInput.closest('.notify-audience-chip')?.querySelector('span')?.textContent?.trim()
                        : '';

                    const genderInput = document.querySelector('input[name="GenderFilter"]:checked');
                    const genderLabel = genderInput && genderInput.value
                        ? genderInput.closest('.notify-audience-chip')?.querySelector('span')?.textContent?.trim()
                        : '';

                    const ageInput = document.querySelector('input[name="AgeFilter"]:checked');
                    const ageLabel = ageInput && ageInput.value
                        ? ageInput.closest('.notify-audience-chip')?.querySelector('span')?.textContent?.trim()
                        : '';

                    const parts = [modeLabel || '—'];
                    if (genderLabel) parts.push(genderLabel);
                    if (ageLabel) parts.push(ageLabel);
                    return parts.join(' · ');
                }

                function updateRecipientSummary(options) {
                    const syncSelection = !options || options.syncSelection !== false;
                    const mode = getSelectedMode();
                    const picker = document.getElementById('clientPickerSection');
                    const subtitle = document.getElementById('clientPickerSubtitle');
                    const countEl = document.getElementById('selectedRecipientsCount');
                    const modeLabelEl = document.getElementById('selectedRecipientModeLabel');

                    if (picker) {
                        picker.classList.toggle('notify-client-picker--manual', mode === manualMode);
                        picker.classList.toggle('notify-client-picker--preview', mode !== manualMode);
                    }

                    if (subtitle) {
                        subtitle.textContent = mode === manualMode
                            ? 'Пациенты по фильтрам отмечены автоматически — снимите галочку, чтобы исключить'
                            : 'Предпросмотр аудитории по выбранным фильтрам';
                    }

                    document.querySelectorAll('input[name="SelectedClientIds"]').forEach(function (el) {
                        el.disabled = mode !== manualMode;
                    });

                    applyClientListFilters();
                    if (syncSelection) {
                        syncSelectionWithFilters();
                    } else {
                        document.querySelectorAll('#clientOptionsList [data-filter-item]').forEach(function (item) {
                            const checkbox = item.querySelector('input[name="SelectedClientIds"]');
                            if (!checkbox) return;
                            item.classList.toggle('notify-option--selected', checkbox.checked && item.style.display !== 'none');
                        });
                    }

                    if (modeLabelEl) {
                        modeLabelEl.textContent = buildSummaryLabel();
                    }

                    if (!countEl) return;

                    const items = Array.from(document.querySelectorAll('#clientOptionsList [data-filter-item]'))
                        .filter(function (item) { return item.style.display !== 'none'; });

                    countEl.textContent = String(
                        items.filter(function (item) {
                            const checkbox = item.querySelector('input[name="SelectedClientIds"]');
                            return checkbox && checkbox.checked;
                        }).length
                    );
                }

                function wireFilter(inputId) {
                    const input = document.getElementById(inputId);
                    if (!input) return;
                    input.addEventListener('input', function () {
                        updateRecipientSummary({ syncSelection: true });
                    });
                }

                function bindRecipientControls() {
                    document.querySelectorAll('input[name="RecipientMode"], input[name="GenderFilter"], input[name="AgeFilter"]').forEach(function (el) {
                        el.addEventListener('change', function () {
                            updateRecipientSummary({ syncSelection: true });
                        });
                    });
                    document.querySelectorAll('input[name="SelectedClientIds"]').forEach(function (el) {
                        el.addEventListener('change', function () {
                            updateRecipientSummary({ syncSelection: false });
                        });
                    });
                    updateRecipientSummary({ syncSelection: true });
                }

                wireFilter('clientSearchInput');
                bindRecipientControls();
            })();
        </script>
    }
    else
    {
        <script>
            (function () {
                function wireFilter(inputId, listId) {
                    const input = document.getElementById(inputId);
                    const list = document.getElementById(listId);
                    if (!input || !list) return;
                    input.addEventListener('input', function () {
                        const query = input.value.trim().toLowerCase();
                        list.querySelectorAll('[data-filter-item]').forEach(function (item) {
                            const text = item.getAttribute('data-filter-text') || '';
                            item.style.display = !query || text.indexOf(query) >= 0 ? '' : 'none';
                        });
                    });
                }

                function bindCounter(selector, targetId) {
                    const target = document.getElementById(targetId);
                    if (!target) return;
                    const update = function () {
                        target.textContent = String(document.querySelectorAll(selector + ':checked').length);
                    };
                    document.querySelectorAll(selector).forEach(function (el) { el.addEventListener('change', update); });
                    update();
                }

                wireFilter('groupSearchInput', 'groupOptionsList');
                wireFilter('clientSearchInput', 'clientOptionsList');
                bindCounter('input[name="SelectedGroupIds"]', 'selectedGroupsCount');
                bindCounter('input[name="SelectedClientIds"]', 'selectedClientsCount');
            })();
        </script>
    }
}
