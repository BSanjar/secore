@model WebApplication1.Models.DBModels.OrganizationService
@{
    ViewData["Title"] = "Добавить услугу";
}

@section Styles {
    @if (string.Equals(WebApplication1.Helpers.AuthorizationHelper.GetOrganizationType(Context), "standart", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/web/standart/css/services.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
    }
}

<div class="children-page">
    <nav class="app-breadcrumb" aria-label="Навигация">
        <a asp-action="Index">Услуги</a>
        <span class="breadcrumb-sep">›</span>
        <span>Добавление услуги</span>
    </nav>

    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="page-title">Добавить услугу</h1>
                <p class="page-subtitle mb-0">Новая услуга организации для счетов</p>
            </div>
        </div>
    </div>

    <div class="filters-section">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Organization" />
            <input type="hidden" asp-for="Isdeleted" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label text-muted small">Название услуги <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Например: Питание, Обучение" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small">Тип суммы</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input type="radio" name="FixedSum" value="0" id="FixedSum_0" class="form-check-input" checked="@(Model.FixedSum != 1)">
                        <label class="form-check-label" for="FixedSum_0">Диапазон (мин — макс)</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" name="FixedSum" value="1" id="FixedSum_1" class="form-check-input" checked="@(Model.FixedSum == 1)">
                        <label class="form-check-label" for="FixedSum_1">Фиксированная сумма</label>
                    </div>
                </div>
            </div>

            <div class="mb-3" id="fixedSumBlock" style="display: none;">
                <label asp-for="ServiceSumm" class="form-label text-muted small">Фиксированная сумма (сом)</label>
                <input asp-for="ServiceSumm" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
            </div>

            <div class="row mb-3" id="rangeSumBlock">
                <div class="col-md-6">
                    <label asp-for="MinSumm" class="form-label text-muted small">Мин. сумма (сом)</label>
                    <input asp-for="MinSumm" type="number" step="1" min="0" class="form-control" placeholder="0" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MaxSumm" class="form-label text-muted small">Макс. сумма (сом)</label>
                    <input asp-for="MaxSumm" type="number" step="1" min="0" class="form-control" placeholder="0" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="action-btn action-btn--add">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/>
                    </svg>
                    Создать
                </button>
                <a asp-action="Index" class="action-btn">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var fixedRadios = document.querySelectorAll('input[name="FixedSum"]');
            var fixedBlock = document.getElementById('fixedSumBlock');
            var rangeBlock = document.getElementById('rangeSumBlock');
            function toggle() {
                var isFixed = document.querySelector('input[name="FixedSum"]:checked')?.value === '1';
                if (fixedBlock) fixedBlock.style.display = isFixed ? 'block' : 'none';
                if (rangeBlock) rangeBlock.style.display = isFixed ? 'none' : 'flex';
            }
            fixedRadios.forEach(function (r) { r.addEventListener('change', toggle); });
            toggle();
        });
    </script>
}



