@{
    ViewData["Title"] = "Тариф и комиссии";
    var organization = ViewBag.Organization as WebApplication1.Models.DBModels.Organization;
    var organizationId = ViewBag.OrganizationId as string ?? "";
    var settings = ViewBag.Settings as WebApplication1.Models.DBModels.OrganizationSettings;
    var subscription = ViewBag.Subscription as WebApplication1.Models.DBModels.OrganizationSubscription;
    var commissions = ViewBag.Commissions as IEnumerable<WebApplication1.Models.DBModels.Commission> ?? Array.Empty<WebApplication1.Models.DBModels.Commission>();
}

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="h2 mb-1">Тариф и комиссии</h1>
        <p class="text-muted small mb-0">
            Настройка тарифа и комиссий для организации
            <strong>@(organization?.Name ?? organizationId)</strong>.
        </p>
    </div>
    <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        К общей странице настроек
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

<form asp-action="SaveSettings" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="organizationId" value="@organizationId" />

    <div class="row g-3">
        <div class="col-12 col-xl-8">

            <div class="card mb-3 shadow-sm border-0">
                <div class="card-header bg-white border-0 pb-0">
                    <h5 class="mb-1">Тариф</h5>
                    <p class="text-muted small mb-0">
                        Определяет, оплачивает ли организация систему по подписке или по комиссиям.
                    </p>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Тип тарифа</label>
                        <select name="billingType" id="billingTypeSelect" class="form-select">
                            @if (settings?.BillingType != "subscription")
                            {
                                <option value="commission" selected>По комиссиям (настройки ниже)</option>
                                <option value="subscription">Подписка (фикс за период)</option>
                            }
                            else
                            {
                                <option value="commission">По комиссиям (настройки ниже)</option>
                                <option value="subscription" selected>Подписка (фикс за период)</option>
                            }
                        </select>
                        <small class="form-text text-muted">
                            Подписка — фиксированная сумма за пользование системой. Иначе применяются выбранные виды комиссий.
                        </small>
                    </div>

                    <div id="subscriptionBlock" class="mb-3 @(settings?.BillingType != "subscription" ? "d-none" : "")">
                        <hr />
                        <h6 class="mb-2">Настройка подписки</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label">Стоимость за период (сом)</label>
                                <input type="number"
                                       name="subscriptionPriceSom"
                                       class="form-control"
                                       step="0.01"
                                       min="0"
                                       value="@(subscription != null ? (subscription.PriceTyiyn / 100m).ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                       placeholder="0.00" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Период</label>
                                <select name="subscriptionPeriodType" class="form-select">
                                    @if (subscription?.PeriodType == "year")
                                    {
                                        <option value="month">Месяц</option>
                                        <option value="year" selected>Год</option>
                                    }
                                    else
                                    {
                                        <option value="month" selected>Месяц</option>
                                        <option value="year">Год</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <p class="text-muted small mb-0">
                            История оплат и статус подписки — в разделе
                            <a asp-controller="OrganizationSubscription" asp-action="Index">«Подписка»</a>.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card mb-3 shadow-sm border-0">
                <div class="card-header bg-white border-0 pb-0">
                    <h5 class="mb-1">Комиссии</h5>
                    <p class="text-muted small mb-0">
                        Включённые виды комиссий участвуют в расчёте транзакций и отчётов.
                    </p>
                </div>
                <div class="card-body">
                    <div id="commissionBlock" class="@(settings?.BillingType == "subscription" ? "d-none" : "")">
                        <p class="text-muted small mb-2">
                            Включённые виды комиссий учитываются в транзакциях отдельно (для отчётов).
                        </p>

                        <div class="form-check mb-2">
                            <input name="useLowerCommissionFromOrg"
                                   type="checkbox"
                                   class="form-check-input"
                                   value="true"
                                   checked="@(settings?.UseLowerCommissionFromOrg == true)" />
                            <label class="form-check-label">Нижняя комиссия от организации</label>
                        </div>
                        <small class="form-text text-muted d-block mb-3">
                            Считается от суммы транзакции.
                        </small>

                        <div class="mb-3" id="commissionIdBlock">
                            <label class="form-label">Вид комиссии (нижняя от организации)</label>
                            <select name="commissionId" class="form-select">
                                <option value="">— не выбрана —</option>
                                @foreach (var c in commissions)
                                {
                                    if (c != null)
                                    {
                                        if (settings?.CommissionId == c.Id)
                                        {
                                            <option value="@c.Id" selected>@(c.Name ?? c.Id) — @c.CommissionKind</option>
                                        }
                                        else
                                        {
                                            <option value="@c.Id">@(c.Name ?? c.Id) — @c.CommissionKind</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-1 mb-3">
                <button type="submit" class="btn btn-primary">
                    Сохранить тариф и комиссии
                </button>
            </div>
        </div>
    </div>
</form>

<script>
    (function () {
        var billingSelect = document.getElementById('billingTypeSelect');
        var subscriptionBlock = document.getElementById('subscriptionBlock');
        var commissionBlock = document.getElementById('commissionBlock');
        function toggleByBilling() {
            var isSub = billingSelect && billingSelect.value === 'subscription';
            if (subscriptionBlock) subscriptionBlock.classList.toggle('d-none', !isSub);
            if (commissionBlock) commissionBlock.classList.toggle('d-none', isSub);
        }
        if (billingSelect) {
            billingSelect.addEventListener('change', toggleByBilling);
            toggleByBilling();
        }

        var cb = document.querySelector('input[name="useLowerCommissionFromOrg"]');
        var block = document.getElementById('commissionIdBlock');
        if (cb && block) {
            function toggle() { block.style.display = cb.checked ? 'block' : 'none'; }
            cb.addEventListener('change', toggle);
            toggle();
        }
    })();
</script>
