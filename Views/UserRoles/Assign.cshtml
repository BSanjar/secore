@model WebApplication1.Models.DBModels.User
@{
    ViewData["Title"] = "Назначить роли";
    var roles = ViewBag.Roles as List<WebApplication1.Models.DBModels.Role> ?? new List<WebApplication1.Models.DBModels.Role>();
    var selectedRoleIds = ViewBag.SelectedRoleIds as List<string> ?? new List<string>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard-soft.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-children.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">Настройки</a>
        <span class="breadcrumb-sep">/</span>
        <a asp-action="Index" asp-controller="UserRoles">Назначение ролей</a>
        <span class="breadcrumb-sep">/</span>
        <span>@(Model.Name ?? Model.Email ?? "Пользователь")</span>
    </nav>

    <div class="page-header">
        <h1 class="page-title">Назначить роли</h1>
        <p class="page-subtitle mb-0">Выберите роли для пользователя</p>
    </div>

    <div class="filters-section mb-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Пользователь</dt>
            <dd class="col-sm-9 fw-medium">@Model.Name</dd>
            <dt class="col-sm-3 text-muted">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
        </dl>
    </div>

    <form asp-action="Assign" asp-controller="UserRoles" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Роли</label>
            <div class="settings-scroll-panel settings-scroll-panel--sm">
                @if (roles.Any())
                {
                    @foreach (var role in roles)
                    {
                        var isChecked = selectedRoleIds.Contains(role.Id);
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="selectedRoles" value="@role.Id" id="role_@role.Id" @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="role_@role.Id">
                                <strong>@role.Name</strong>
                            </label>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        Роли не найдены. <a asp-controller="Roles" asp-action="Create">Создайте первую роль</a>.
                    </div>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="detsad-btn-primary">Сохранить</button>
            <a asp-action="Index" class="detsad-btn-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
