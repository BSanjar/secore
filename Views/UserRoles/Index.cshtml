@model IEnumerable<WebApplication1.Models.DBModels.User>
@{
    ViewData["Title"] = "Назначение ролей";
    var currentOrgId = ViewBag.CurrentOrganizationId as string;
}

<div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1 class="h2 mb-1">Назначение ролей пользователям</h1>
        <p class="text-muted small mb-0">Просмотр пользователей и назначение им ролей.</p>
    </div>
    <a asp-controller="Settings" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        К настройкам
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Пользователь</th>
                            <th>Email</th>
                            <th>Роли</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var roles = user.UserRoles?
                            .Where(ur => ur.Isdeleted == null || ur.Isdeleted == 0)
                            .Where(ur => ur.RoleNavigation != null && (string.IsNullOrEmpty(currentOrgId) || ur.RoleNavigation.Organization == currentOrgId))
                            .Select(ur => ur.RoleNavigation!.Name!)
                            .Where(n => !string.IsNullOrEmpty(n))
                            .ToList() ?? new List<string>();

                            <tr>
                                <td>@user.Name</td>
                                <td>@user.Email</td>
                                <td>
                                    @if (roles.Any())
                                    {
                                        @foreach (var r in roles)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">
                                                @r
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Роли не назначены</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Assign" asp-route-id="@user.Id" class="btn btn-sm btn-primary">
                                        Назначить роли
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Пользователи не найдены.
    </div>
}