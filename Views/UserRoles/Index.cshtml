@model IEnumerable<WebApplication1.Models.DBModels.User>
@{
    ViewData["Title"] = "Назначение ролей пользователям";
}

<div class="container mt-4">
    <h2>Назначение ролей пользователям</h2>
    <hr />

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Пользователь</th>
                        <th>Email</th>
                        <th>Роли</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.UserRoles != null && user.UserRoles.Any(ur => ur.Isdeleted == null || ur.Isdeleted == 0))
                                {
                                    @foreach (var userRole in user.UserRoles.Where(ur => ur.Isdeleted == null || ur.Isdeleted == 0))
                                    {
                                        <span class="badge bg-primary me-1">@userRole.RoleNavigation?.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Роли не назначены</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Assign" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Назначить роли</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Пользователи не найдены.
        </div>
    }
</div>

