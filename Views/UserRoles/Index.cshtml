@model IEnumerable<WebApplication1.Models.DBModels.User>
@{
    ViewData["Title"] = "Назначение ролей";
    var currentOrgId = ViewBag.CurrentOrganizationId as string;
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
}

<div class="children-page settings-page settings-subpage settings-list-page">
    <nav class="detsad-breadcrumb" aria-label="Навигация">
        <a asp-controller="Settings" asp-action="Index">Настройки</a>
        <span class="breadcrumb-sep">/</span>
        <span>Назначение ролей</span>
    </nav>

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="page-title mb-0">Назначение ролей</h1>
        <a asp-controller="Settings" asp-action="Index" class="detsad-btn-secondary">← К настройкам</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="dashboard-table-card">
            <div class="table-wrap">
                <table class="table-soft">
                    <thead>
                        <tr>
                            <th>Пользователь</th>
                            <th>Email</th>
                            <th>Роли</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var roles = user.UserRoles?
                                .Where(ur => ur.Isdeleted == null || ur.Isdeleted == 0)
                                .Where(ur => ur.RoleNavigation != null && (string.IsNullOrEmpty(currentOrgId) || ur.RoleNavigation.Organization == currentOrgId))
                                .Select(ur => ur.RoleNavigation!.Name!)
                                .Where(n => !string.IsNullOrEmpty(n))
                                .ToList() ?? new List<string>();

                            <tr>
                                <td class="cell-name">@user.Name</td>
                                <td class="cell-muted">@user.Email</td>
                                <td>
                                    @if (roles.Any())
                                    {
                                        @string.Join(", ", roles)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Роли не назначены</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Assign" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Назначить</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state-settings">
            <p class="mb-0">Пользователи не найдены.</p>
        </div>
    }
</div>
