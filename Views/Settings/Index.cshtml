@using Microsoft.AspNetCore.Mvc.Localization
@using WebApplication1.Helpers
@using WebApplication1.Services.Cabinets
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@inject ICurrentTenantService CurrentTenantService
@{
    ViewData["Title"] = Localizer["Settings"].Value;
    var profileKey = CurrentTenantService.GetCurrent().Profile.Key ?? "";
    var isDetsad = string.Equals(profileKey, "detsad", StringComparison.OrdinalIgnoreCase);
    var canNotifications = CurrentTenantService.GetCurrent().Profile.HasFeature(CabinetFeatures.Notifications);
}

@section Styles {
    <link rel="stylesheet" href="~/web/kindergarten/css/detsad-clients.css" asp-append-version="true" />
}

<div class="children-page settings-page @(isDetsad ? "settings-page--detsad" : "")">
    <div class="page-header">
        <h1 class="page-title">@Localizer["Settings"]</h1>
        @if (!isDetsad)
        {
            <p class="page-subtitle mb-0">Управление ролями, пользователями и параметрами организации.</p>
        }
    </div>

    <div class="settings-grid">
        <div class="settings-card">
            <div class="settings-card__header">
                <h2 class="settings-card__title">
                    <span class="settings-card__icon settings-card__icon--roles" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
                    </span>
                    @Localizer["RolesAndPermissions"]
                </h2>
            </div>
            <ul class="settings-list">
                <li class="settings-list__item">
                    <a asp-controller="Roles" asp-action="Index" class="settings-list__link">
                        <span class="settings-list__link-text">@Localizer["Roles"]</span>
                        <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
                <li class="settings-list__item">
                    <a asp-controller="Permissions" asp-action="Index" class="settings-list__link">
                        <span class="settings-list__link-text">@Localizer["Permissions"]</span>
                        <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
                <li class="settings-list__item">
                    <a asp-controller="UserRoles" asp-action="Index" class="settings-list__link">
                        <span class="settings-list__link-text">@Localizer["AssignRoles"]</span>
                        <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="settings-card">
            <div class="settings-card__header">
                <h2 class="settings-card__title">
                    <span class="settings-card__icon settings-card__icon--users" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                    </span>
                    @Localizer["UsersAndFields"]
                </h2>
            </div>
            <ul class="settings-list">
                <li class="settings-list__item">
                    <a asp-controller="Users" asp-action="Index" class="settings-list__link">
                        <span class="settings-list__link-text">@Localizer["Users"]</span>
                        <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
                <li class="settings-list__item">
                    <a asp-controller="OrganizationFields" asp-action="Index" class="settings-list__link">
                        <span class="settings-list__link-text">@Localizer["AdditionalFields"]</span>
                        <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="settings-card">
            <div class="settings-card__header">
                <h2 class="settings-card__title">
                    <span class="settings-card__icon settings-card__icon--history" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3a9 9 0 00-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7a8.96 8.96 0 01-4.94-1.48l-1.42 1.42A10.96 10.96 0 0013 21a9 9 0 000-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
                    </span>
                    История и уведомления
                </h2>
            </div>
            <ul class="settings-list">
                <li class="settings-list__item">
                    <a asp-controller="History" asp-action="Index" class="settings-list__link">
                        <span class="settings-list__link-text">История</span>
                        <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
                @if (!isDetsad || canNotifications)
                {
                    <li class="settings-list__item">
                        <a asp-controller="Notifications" asp-action="Index" class="settings-list__link">
                            <span class="settings-list__link-text">Уведомления</span>
                            <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                        </a>
                    </li>
                }
            </ul>
        </div>

        @if (!isDetsad)
        {
            <div class="settings-card">
                <div class="settings-card__header">
                    <h2 class="settings-card__title">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.04.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                        Настройки организации
                    </h2>
                </div>
                <ul class="settings-list">
                    <li class="settings-list__item">
                        <a asp-controller="OrganizationSettings" asp-action="Index" class="settings-list__link">
                            <span class="settings-list__link-text">Параметры организации</span>
                            <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                        </a>
                    </li>
                    @{
                        var canTariff = PermissionHelper.HasPermission(Context, "settings.tariff");
                    }
                    @if (canTariff)
                    {
                        <li class="settings-list__item">
                            <a asp-controller="TariffAndCommissions" asp-action="Index" class="settings-list__link">
                                <span class="settings-list__link-text">Тариф и комиссии</span>
                                <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                            </a>
                        </li>
                        <li class="settings-list__item">
                            <a asp-controller="Commission" asp-action="Index" class="settings-list__link">
                                <span class="settings-list__link-text">Справочник комиссий</span>
                                <span class="settings-list__link-arrow" aria-hidden="true">→</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
