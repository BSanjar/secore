@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<WebApplication1.SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Settings"].Value;
}

<div class="container mt-4">
    <h2 class="mb-4">@Localizer["Settings"]</h2>

    <div class="row">
        <!-- Роли и права -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                        </svg>
                        @Localizer["RolesAndPermissions"]
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="Roles" asp-action="Index" class="text-decoration-none">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                                </svg>
                                @Localizer["Roles"]
                            </a>
                            <span class="badge bg-primary rounded-pill">→</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="Permissions" asp-action="Index" class="text-decoration-none">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                                </svg>
                                @Localizer["Permissions"]
                            </a>
                            <span class="badge bg-primary rounded-pill">→</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="UserRoles" asp-action="Index" class="text-decoration-none">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                                </svg>
                                @Localizer["AssignRoles"]
                            </a>
                            <span class="badge bg-primary rounded-pill">→</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Пользователи и поля -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor"/>
                        </svg>
                        @Localizer["UsersAndFields"]
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="Users" asp-action="Index" class="text-decoration-none">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor"/>
                                </svg>
                                @Localizer["Users"]
                            </a>
                            <span class="badge bg-success rounded-pill">→</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="OrganizationFields" asp-action="Index" class="text-decoration-none">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                                    <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" fill="currentColor"/>
                                </svg>
                                @Localizer["AdditionalFields"]
                            </a>
                            <span class="badge bg-success rounded-pill">→</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

