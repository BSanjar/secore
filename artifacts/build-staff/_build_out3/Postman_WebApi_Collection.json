{
  "info": {
    "name": "SECORE JsonWebApi Payment Tests",
    "description": "Postman collection for JsonWebApiController payment scenarios: periodic, one-time, with positive balance, without balance, with debt, and overpayment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{login}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5099"
    },
    {
      "key": "login",
      "value": "YOUR_AGENT_LOGIN"
    },
    {
      "key": "password",
      "value": "YOUR_AGENT_PASSWORD"
    },
    {
      "key": "serviceId",
      "value": "12345"
    },
    {
      "key": "txnDate",
      "value": "20260417120000"
    },
    {
      "key": "amount1000",
      "value": "1000"
    },
    {
      "key": "amount1200",
      "value": "1200"
    },
    {
      "key": "accountPeriodicNoBalance",
      "value": "123450000000001"
    },
    {
      "key": "accountPeriodicWithBalance",
      "value": "123450000000002"
    },
    {
      "key": "accountDebt",
      "value": "123450000000003"
    },
    {
      "key": "accountOverpay",
      "value": "123450000000004"
    },
    {
      "key": "accountOneTime",
      "value": "123450000000005"
    },
    {
      "key": "lastTxnId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('generatedTxnId')) {",
          "    pm.variables.set('generatedTxnId', 'txn-' + Date.now());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Check Periodic Without Balance",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{login}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"account\": \"{{accountPeriodicNoBalance}}\"\n}"
        },
        "url": "{{baseUrl}}/WebApi/check"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('result exists', function () { pm.expect(json).to.have.property('result'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Pay Periodic Without Balance",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{login}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"txnId\": \"periodic-no-balance-{{$timestamp}}\",\n  \"txnDate\": \"{{txnDate}}\",\n  \"account\": \"{{accountPeriodicNoBalance}}\",\n  \"paySum\": {{amount1000}}\n}"
        },
        "url": "{{baseUrl}}/WebApi/pay"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('lastTxnId', json.txnId || '');",
              "pm.test('success or explained business error', function () { pm.expect(json).to.have.property('result'); });"
            ]
          }
        }
      ]
    },
