{
  "info": {
    "name": "SECORE WebApi",
    "description": "Проверка check, pay, payInfo. Замените {{baseUrl}}, {{login}}, {{password}}, {{account}} на свои значения.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5099" },
    { "key": "login", "value": "YOUR_AGENT_LOGIN" },
    { "key": "password", "value": "YOUR_AGENT_PASSWORD" },
    { "key": "account", "value": "12345123456789" },
    { "key": "txn_id", "value": "postman-test-001" },
    { "key": "txn_date", "value": "20250217120000" }
  ],
  "item": [
    {
      "name": "check",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/xml" },
          { "key": "Accept", "value": "application/xml" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<check_account>\n  <login>{{login}}</login>\n  <password>{{password}}</password>\n  <operator>postman</operator>\n  <account>{{account}}</account>\n</check_account>"
        },
        "url": "{{baseUrl}}/WebApi/check"
      }
    },
    {
      "name": "pay",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/xml" },
          { "key": "Accept", "value": "application/xml" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<payment>\n  <login>{{login}}</login>\n  <password>{{password}}</password>\n  <operator>postman</operator>\n  <txn_id>{{txn_id}}</txn_id>\n  <txn_date>{{txn_date}}</txn_date>\n  <account>{{account}}</account>\n  <payer_name>Тест Плательщик</payer_name>\n  <sum>100.50</sum>\n</payment>"
        },
        "url": "{{baseUrl}}/WebApi/pay"
      }
    },
    {
      "name": "payInfo",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/xml" },
          { "key": "Accept", "value": "application/xml" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<payment_info>\n  <login>{{login}}</login>\n  <password>{{password}}</password>\n  <operator>postman</operator>\n  <txn_id>ВСТАВЬТЕ_TXN_ID_ОТ_ПЛАТЕЖА</txn_id>\n</payment_info>"
        },
        "url": "{{baseUrl}}/WebApi/payInfo"
      }
    }
  ]
}
